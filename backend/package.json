{
  "name": "help-center-backend",
  "version": "1.0.0",
  "description": "Enterprise Help Center Backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:prod": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "workflow:backfill": "tsx prisma/backfill-workflow-versions.ts",
    "workflow:backfill:shadow": "tsx prisma/backfill-workflow-versions.ts --shadow",
    "workflow:bootstrap:shadow": "tsx prisma/bootstrap-workflow-versions.ts",
    "workflow:bootstrap:itsimple": "tsx prisma/bootstrap-it-simple.ts",
    "workflow:reconstruct:shadow": "tsx prisma/reconstruct-workflow-edges.ts",
    "workflow:reconstruct": "tsx prisma/reconstruct-workflow-edges.ts --write",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:seed:purchase-requisition-approval": "tsx prisma/seed-purchase-requisition-approval.ts",
    "prisma:rectify:purchase-requisition-group-dceo": "tsx prisma/rectify-purchase-requisition-group-dceo.ts",
    "prisma:seed:crm": "tsx prisma/seed-crm.ts",
    "prisma:seed:credit": "tsx prisma/seed-credit.ts",
    "prisma:seed:credit:flags": "tsx prisma/seed-credit.ts --flags",
    "prisma:seed:credit:workflow": "tsx prisma/seed-credit.ts --workflow",
    "prisma:seed:credit:notifications": "tsx prisma/seed-credit.ts --notifications",
    "prisma:seed:credit:approvals": "tsx prisma/seed-credit.ts --approvals",
    "prisma:seed:credit:branches": "tsx prisma/seed-credit.ts --branches",
    "prisma:seed:credit:demo": "tsx prisma/seed-credit.ts --demo",
    "prisma:seed:credit:clear": "tsx prisma/seed-credit.ts --clear",
    "audit:verify": "tsx prisma/rehash-audit-chain.ts --verify",
    "audit:rehash": "tsx prisma/rehash-audit-chain.ts",
    "prisma:reset": "prisma migrate reset",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:credit:p0": "jest src/credit/__tests__/creditP0Regression.test.ts src/credit/__tests__/auditImmutability.test.ts src/credit/__tests__/auditChainOrdering.test.ts src/credit/__tests__/committeeEntryGate.test.ts --runInBand",
    "test:p2": "jest src/credit/__tests__/creditP2.integration.test.ts src/credit/__tests__/creditGovernedScoring.test.ts src/credit/__tests__/creditMemoVersion.test.ts src/credit/__tests__/financialCalculationRegression.test.ts src/credit/__tests__/creditRecommendation.test.ts src/credit/__tests__/ratingBandGovernance.test.ts src/credit/__tests__/borrowerRiskSeparation.test.ts src/credit/__tests__/application360PersistenceMatrix.test.ts --runInBand",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "prisma:seed:clear-tickets": "tsx prisma/seed-clear-tickets.ts",
    "clear-tickets": "tsx src/scripts/clear-tickets.ts",
    "clear-tickets:dry-run": "DRY_RUN=true tsx src/scripts/clear-tickets.ts",
    "import:staff": "tsx scripts/bulk_import_staff.ts",
    "import:staff:deactivate": "tsx scripts/bulk_import_staff.ts --deactivate-missing",
    "smoke:attachment-scanner": "ATTACHMENT_SCAN_QUEUE_NAME=attachment.malware-scan.smoke tsx scripts/smoke-attachment-scanner.ts",
    "audit:reseal": "tsx prisma/reseal-audit-chain.ts",
    "audit:reseal:dry": "tsx prisma/reseal-audit-chain.ts --dry-run",
    "test:release": "npm run prisma:seed:credit -- --demo && npm run audit:verify && npm run test:credit:p0 && npm test"
  },
  "keywords": [
    "help-desk",
    "service-management",
    "ticketing",
    "enterprise"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1034.0",
    "@aws-sdk/s3-request-presigner": "^3.1034.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.76.10",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.10.1",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "multer-s3": "^3.0.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^6.9.16",
    "openai": "^6.38.0",
    "otpauth": "^9.5.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pdf-parse": "^2.4.5",
    "prom-client": "^15.1.3",
    "puppeteer": "^24.31.0",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^4.3.1",
    "resend": "^6.12.2",
    "sanitize-html": "^2.17.4",
    "validator": "^13.15.35",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@prisma/client": "^5.22.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.13",
    "@types/multer-s3": "^3.0.3",
    "@types/node": "^22.14.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.23",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/qrcode": "^1.5.6",
    "@types/sanitize-html": "^2.16.1",
    "@types/supertest": "^7.2.0",
    "@types/validator": "^13.15.10",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^9.18.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "prisma": "^5.22.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.8.2",
    "xlsx": "^0.18.5"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
