// IT ASSET MANAGEMENT
// ============================================================================

model Asset {
  id             String        @id @default(uuid()) @db.Uuid
  assetTag       String        @unique @map("asset_tag") @db.VarChar(100)
  serialNumber   String?       @unique @map("serial_number") @db.VarChar(100)
  name           String        @db.VarChar(255)
  category       AssetCategory
  brand          String?       @db.VarChar(100)
  model          String?       @db.VarChar(100)
  purchaseDate   DateTime?     @map("purchase_date") @db.Date
  purchasePrice  Decimal?      @map("purchase_price") @db.Decimal(10, 2)
  vendor         String?       @db.VarChar(200)
  warrantyExpiry DateTime?     @map("warranty_expiry") @db.Date
  status         AssetStatus   @default(IN_STOCK)
  notes          String?       @db.Text
  os             String?       @db.VarChar(100)
  encrypted      String?       @db.VarChar(50)
  skuFamily      String?       @map("sku_family") @db.VarChar(100)
  joinType       String?       @map("join_type") @db.VarChar(100)
  ethernetMac    String?       @map("ethernet_mac") @db.VarChar(50)
  wifiMac        String?       @map("wifi_mac") @db.VarChar(50)
  arch           String?       @db.VarChar(50)
  previousUser   String?       @map("previous_user") @db.VarChar(200)
  entity         String?       @db.VarChar(200)

  sourceRequestId String?  @map("source_request_id") @db.Uuid
  createdById     String   @map("created_by_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  sourceRequest      Request?            @relation("AssetSourceRequest", fields: [sourceRequestId], references: [id])
  createdBy          User                @relation("AssetCreatedBy", fields: [createdById], references: [id])
  assignments        AssetAssignment[]
  itHardwareRequests ITHardwareRequest[]

  @@index([status])
  @@index([category])
  @@index([createdById])
  @@map("assets")
}

model AssetAssignment {
  id              String    @id @default(uuid()) @db.Uuid
  assetId         String    @map("asset_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  assignedById    String    @map("assigned_by_id") @db.Uuid
  assignedAt      DateTime  @default(now()) @map("assigned_at") @db.Timestamp(6)
  returnedAt      DateTime? @map("returned_at") @db.Timestamp(6)
  reason          String?   @db.VarChar(200)
  linkedRequestId String?   @map("linked_request_id") @db.Uuid
  notes           String?   @db.Text

  asset         Asset    @relation(fields: [assetId], references: [id])
  user          User     @relation("AssetAssignmentUser", fields: [userId], references: [id])
  assignedBy    User     @relation("AssetAssignmentAssignedBy", fields: [assignedById], references: [id])
  linkedRequest Request? @relation("AssetAssignmentRequest", fields: [linkedRequestId], references: [id])

  @@index([assetId])
  @@index([userId])
  @@map("asset_assignments")
}

model SystemSetting {
  key       String   @id @db.VarChar(100)
  value     String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  @@map("system_settings")
}

// ============================================================================
// CRM MODULE
// ============================================================================

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  CONVERTED
  LOST
}

enum LeadSource {
  WEBSITE
  REFERRAL
  COLD_CALL
  TRADE_SHOW
  LINKEDIN
  ADVERTISEMENT
  PARTNER
  OTHER
}

enum OpportunityStage {
  PROSPECTING
  QUALIFICATION
  PROPOSAL
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

enum CrmActivityType {
  CALL
  EMAIL
  MEETING
  NOTE
  TASK
  FOLLOW_UP
  WHATSAPP
  SITE_VISIT
}

// CRM Accounts — external companies/organizations
model CrmAccount {
  id                 String    @id @default(uuid()) @db.Uuid
  name               String    @db.VarChar(255)
  industry           String?   @db.VarChar(100)
  companySize        String?   @map("company_size") @db.VarChar(50)
  website            String?   @db.VarChar(500)
  phone              String?   @db.VarChar(50)
  email              String?   @db.VarChar(255)
  address            String?   @db.Text
  city               String?   @db.VarChar(100)
  state              String?   @db.VarChar(100)
  country            String?   @db.VarChar(100)
  postalCode         String?   @map("postal_code") @db.VarChar(20)
  description        String?   @db.Text
  annualRevenue      Decimal?  @map("annual_revenue") @db.Decimal(15, 2)
  // Malaysian-specific fields
  registrationNumber String?   @map("registration_number") @db.VarChar(50)
  taxNumber          String?   @map("tax_number") @db.VarChar(50)
  bankAccount        String?   @map("bank_account") @db.VarChar(100)
  purchaseCashTrust  Boolean   @default(false) @map("purchase_cash_trust")
  accountType        String    @default("CORPORATE") @map("account_type") @db.VarChar(20)
  ownerId            String    @map("owner_id") @db.Uuid
  parentAccountId    String?   @map("parent_account_id") @db.Uuid
  deletedAt          DateTime? @map("deleted_at") @db.Timestamp(6)
  isActive           Boolean   @default(true) @map("is_active")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  owner          User                @relation("CrmAccountOwner", fields: [ownerId], references: [id])
  contacts       CrmContact[]
  leads          CrmLead[]
  opportunities  CrmOpportunity[]
  activities     CrmActivity[]       @relation("ActivityAccount")
  notes          CrmNote[]           @relation("NoteAccount")
  linkedRequests CrmAccountRequest[]
  trustProducts  CrmTrustProduct[]
  borrowerProfile BorrowerProfile?
  parent         CrmAccount?         @relation("AccountHierarchy", fields: [parentAccountId], references: [id])
  children       CrmAccount[]       @relation("AccountHierarchy")

  @@index([ownerId])
  @@index([name])
  @@index([industry])
  @@index([parentAccountId])
  syncedEmails    CrmSyncedEmail[]   @relation("CrmSyncedEmailAccount")
  customFields     Json?              @map("custom_fields")
  contactAccountRoles CrmContactAccountRole[]
  @@map("crm_accounts")
}

// CRM Contacts — people at external accounts
model CrmContact {
  id                String    @id @default(uuid()) @db.Uuid
  accountId         String    @map("account_id") @db.Uuid
  firstName         String    @map("first_name") @db.VarChar(100)
  lastName          String    @map("last_name") @db.VarChar(100)
  email             String?   @db.VarChar(255)
  phone             String?   @db.VarChar(50)
  mobile            String?   @db.VarChar(50)
  jobTitle          String?   @map("job_title") @db.VarChar(150)
  department        String?   @db.VarChar(100)
  isPrimary         Boolean   @default(false) @map("is_primary")
  description       String?   @db.Text
  followUpDate      DateTime? @map("follow_up_date") @db.Timestamp(6)
  followUpNote      String?   @map("follow_up_note") @db.Text
  // Phase 2 additions
  nricPassport      String?   @map("nric_passport") @db.VarChar(50)
  dateOfBirth       DateTime? @map("date_of_birth") @db.Date
  preferredLanguage String?   @map("preferred_language") @db.VarChar(5)
  pdpaConsent       Boolean   @default(false) @map("pdpa_consent")
  pdpaConsentDate   DateTime? @map("pdpa_consent_date") @db.Timestamp(6)
  marketingOptIn    Boolean   @default(false) @map("marketing_opt_in")
  deletedAt         DateTime? @map("deleted_at") @db.Timestamp(6)
  // Phase 3: Risk profile for trust industry
  riskProfile       String?   @map("risk_profile") @db.VarChar(20)

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  account       CrmAccount        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  leads         CrmLead[]
  opportunities CrmOpportunity[]
  activities    CrmActivity[]     @relation("ActivityContact")
  notes         CrmNote[]         @relation("NoteContact")
  kycRecord     CrmKycRecord?
  beneficiaries CrmBeneficiary[]
  trustProducts CrmTrustProduct[]
  borrowerProfile BorrowerProfile?
  directors       Director[]
  shareholders    Shareholder[]
  syncedEmails    CrmSyncedEmail[]   @relation("CrmSyncedEmailContact")
  customFields     Json?              @map("custom_fields")
  contactRoles     CrmContactAccountRole[]

  @@index([accountId])
  @@index([email])
  @@map("crm_contacts")
}

// Multi-account contact roles (Phase 8)
model CrmContactAccountRole {
  id        String   @id @default(uuid()) @db.Uuid
  contactId String   @map("contact_id") @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  role      String   @db.VarChar(50) // e.g. DECISION_MAKER, INFLUENCER, CHAMPION, END_USER
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  contact   CrmContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  account   CrmAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([contactId, accountId, role])
  @@index([contactId])
  @@index([accountId])
  @@map("crm_contact_account_roles")
}

// CRM Leads — pre-qualified prospects
model CrmLead {
  id        String     @id @default(uuid()) @db.Uuid
  title     String     @db.VarChar(255)
  status    LeadStatus @default(NEW)
  source    LeadSource @default(OTHER)
  accountId String?    @map("account_id") @db.Uuid
  contactId String?    @map("contact_id") @db.Uuid
  ownerId   String     @map("owner_id") @db.Uuid
  territoryId String?  @map("territory_id") @db.Uuid

  // Lead-specific contact info (for leads without an existing contact)
  contactName  String? @map("contact_name") @db.VarChar(200)
  contactEmail String? @map("contact_email") @db.VarChar(255)
  contactPhone String? @map("contact_phone") @db.VarChar(50)
  companyName  String? @map("company_name") @db.VarChar(255)

  estimatedValue Decimal? @map("estimated_value") @db.Decimal(15, 2)
  description    String?  @db.Text
  lostReason     String?  @map("lost_reason") @db.Text

  // Conversion tracking
  convertedAt      DateTime? @map("converted_at") @db.Timestamp(6)
  convertedToOppId String?   @map("converted_to_opp_id") @db.Uuid

  // Phase 2 additions — follow-up tracking
  followUpDate DateTime? @map("follow_up_date") @db.Timestamp(6)
  followUpNote String?   @map("follow_up_note") @db.Text
  deletedAt    DateTime? @map("deleted_at") @db.Timestamp(6)

  // AI scoring
  aiScore       Int?      @map("ai_score")
  aiScoreReason String?   @map("ai_score_reason") @db.Text
  aiScoredAt    DateTime? @map("ai_scored_at") @db.Timestamp(6)

  // Rule-based scoring
  ruleScore     Int?      @map("rule_score")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  owner      User          @relation("CrmLeadOwner", fields: [ownerId], references: [id])
  account    CrmAccount?   @relation(fields: [accountId], references: [id], onDelete: SetNull)
  contact    CrmContact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  activities CrmActivity[] @relation("ActivityLead")
  notes      CrmNote[]     @relation("NoteLead")
  territory  CrmTerritory? @relation("LeadTerritory", fields: [territoryId], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@index([status])
  @@index([accountId])
  @@index([contactId])
  @@index([territoryId])
  syncedEmails    CrmSyncedEmail[]   @relation("CrmSyncedEmailLead")
  customFields     Json?              @map("custom_fields")
  @@map("crm_leads")
}

// CRM Lead Scoring Rules
model CrmLeadScoringRule {
  id        String @id @default(uuid()) @db.Uuid
  field     String @db.VarChar(100)
  operator  String @db.VarChar(20) // equals, contains, gt, lt, starts_with, not_empty
  value     String @db.VarChar(255)
  points    Int
  isActive  Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  @@map("crm_lead_scoring_rules")
}

// CRM Auto-Assignment Rules
model CrmAssignmentRule {
  id            String    @id @default(uuid()) @db.Uuid
  name          String    @db.VarChar(100)
  territoryId   String?   @map("territory_id") @db.Uuid
  sourceMatch   String?   @map("source_match") @db.VarChar(100) // e.g. "source=WEBSITE"
  roundRobin     Boolean   @default(false) @map("round_robin")
  isActive      Boolean   @default(true) @map("is_active")
  priority      Int       @default(0)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  territory     CrmTerritory? @relation(fields: [territoryId], references: [id], onDelete: SetNull)

  @@index([territoryId])
  @@index([isActive, priority])
  @@map("crm_assignment_rules")
}

// CRM Tags & polymorphic tag assignments
model CrmTag {
  id        String @id @default(uuid()) @db.Uuid
  name      String @unique @db.VarChar(50)
  color     String @default("#6B7280") @db.VarChar(7) // hex color
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  assignments CrmTagAssignment[]

  @@map("crm_tags")
}

model CrmTagAssignment {
  id         String @id @default(uuid()) @db.Uuid
  tagId      String @map("tag_id") @db.Uuid
  entityType String @db.VarChar(20) // LEAD, CONTACT, ACCOUNT, OPPORTUNITY
  entityId   String @map("entity_id") @db.Uuid
  assignedBy String @map("assigned_by") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamp(6)

  tag CrmTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([tagId, entityType, entityId])
  @@index([entityType, entityId])
  @@map("crm_tag_assignments")
}

// CRM Field-level Change Audit
model CrmFieldChange {
  id        String   @id @default(uuid()) @db.Uuid
  entityType String  @db.VarChar(20) // LEAD, CONTACT, ACCOUNT, OPPORTUNITY
  entityId   String  @map("entity_id") @db.Uuid
  field      String  @db.VarChar(100)
  oldValue   String? @map("old_value") @db.Text
  newValue   String? @map("new_value") @db.Text
  changedBy  String  @map("changed_by") @db.Uuid
  changedAt  DateTime @default(now()) @map("changed_at") @db.Timestamp(6)

  @@index([entityType, entityId])
  @@index([field])
  @@map("crm_field_changes")
}

// CRM Pipelines — configurable deal pipelines
model CrmPipeline {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(100)
  description String?  @db.Text
  isDefault   Boolean  @default(false) @map("is_default")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  stages        CrmPipelineStage[]
  opportunities CrmOpportunity[]

  @@map("crm_pipelines")
}

// CRM Pipeline Stages — ordered stages within a pipeline
model CrmPipelineStage {
  id           String   @id @default(uuid()) @db.Uuid
  pipelineId   String   @map("pipeline_id") @db.Uuid
  name         String   @db.VarChar(100)
  displayOrder Int      @map("display_order")
  probability  Int      @default(0) // Win probability percentage (0-100)
  color        String   @default("#0052cc") @db.VarChar(20)
  isWonStage   Boolean  @default(false) @map("is_won_stage")
  isLostStage  Boolean  @default(false) @map("is_lost_stage")
  requiredFields    String[] @default([]) @map("required_fields")
  enforceForwardOnly Boolean @default(false) @map("enforce_forward_only")
  requiresApproval  Boolean  @default(false) @map("requires_approval")
  approvalThreshold Decimal? @map("approval_threshold") @db.Decimal(15, 2)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  pipeline      CrmPipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  opportunities CrmOpportunity[]

  @@unique([pipelineId, displayOrder])
  @@index([pipelineId])
  @@map("crm_pipeline_stages")
}

// CRM Opportunities — revenue-tracked deals
model CrmOpportunity {
  id         String  @id @default(uuid()) @db.Uuid
  name       String  @db.VarChar(255)
  accountId  String  @map("account_id") @db.Uuid
  contactId  String? @map("contact_id") @db.Uuid
  pipelineId String  @map("pipeline_id") @db.Uuid
  stageId    String  @map("stage_id") @db.Uuid
  ownerId    String  @map("owner_id") @db.Uuid

  value             Decimal   @default(0) @db.Decimal(15, 2)
  currency          String    @default("MYR") @db.VarChar(3)
  fxRateToBase      Decimal?  @map("fx_rate_to_base") @db.Decimal(10, 6) // snapshot rate to base currency
  probability       Int       @default(0) // 0-100
  expectedCloseDate DateTime? @map("expected_close_date") @db.Date

  description String?   @db.Text
  lostReason  String?   @map("lost_reason") @db.Text
  wonAt       DateTime? @map("won_at") @db.Timestamp(6)
  lostAt      DateTime? @map("lost_at") @db.Timestamp(6)
  forecastCategory String  @default("PIPELINE") @map("forecast_category") @db.VarChar(20)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamp(6)

  // AI scoring
  aiWinProbability Float?    @map("ai_win_probability")
  aiWinReason      String?   @map("ai_win_reason") @db.Text
  aiScoredAt       DateTime? @map("ai_scored_at") @db.Timestamp(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  account      CrmAccount                   @relation(fields: [accountId], references: [id])
  contact      CrmContact?                  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  pipeline     CrmPipeline                  @relation(fields: [pipelineId], references: [id])
  stage        CrmPipelineStage             @relation(fields: [stageId], references: [id])
  owner        User                         @relation("CrmOpportunityOwner", fields: [ownerId], references: [id])
  activities   CrmActivity[]                @relation("ActivityOpportunity")
  notes        CrmNote[]                    @relation("NoteOpportunity")
  trustProduct CrmTrustProduct?
  stageHistory CrmOpportunityStageHistory[]

  @@index([accountId])
  @@index([pipelineId])
  @@index([stageId])
  @@index([ownerId])
  @@index([expectedCloseDate])
  customFields     Json?              @map("custom_fields")
  @@map("crm_opportunities")
}

// CRM Opportunity Stage History — records each stage progression
model CrmOpportunityStageHistory {
  id            String         @id @default(cuid())
  opportunityId String         @map("opportunity_id") @db.Uuid
  opportunity   CrmOpportunity @relation(fields: [opportunityId], references: [id])
  fromStageName String?        @map("from_stage_name") @db.VarChar(100)
  toStageName   String         @map("to_stage_name") @db.VarChar(100)
  movedByUserId String         @map("moved_by_user_id") @db.Uuid
  movedAt       DateTime       @default(now()) @map("moved_at") @db.Timestamp(6)

  @@index([opportunityId])
  @@map("crm_opportunity_stage_history")
}

// CRM Activities — polymorphic activity log
model CrmActivity {
  id           String          @id @default(uuid()) @db.Uuid
  activityType CrmActivityType @map("activity_type")
  subject      String          @db.VarChar(255)
  description  String?         @db.Text
  userId       String          @map("user_id") @db.Uuid

  // Polymorphic relations — only one should be set
  accountId     String? @map("account_id") @db.Uuid
  contactId     String? @map("contact_id") @db.Uuid
  leadId        String? @map("lead_id") @db.Uuid
  opportunityId String? @map("opportunity_id") @db.Uuid

  // Scheduling
  scheduledAt     DateTime? @map("scheduled_at") @db.Timestamp(6)
  completedAt     DateTime? @map("completed_at") @db.Timestamp(6)
  durationMinutes Int?      @map("duration_minutes")

  // Activity Reminders (Sprint 2)
  reminderSent    Boolean   @default(false) @map("reminder_sent")

  metadata  Json?    @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  user        User            @relation("CrmActivityUser", fields: [userId], references: [id])
  account     CrmAccount?     @relation("ActivityAccount", fields: [accountId], references: [id], onDelete: Cascade)
  contact     CrmContact?     @relation("ActivityContact", fields: [contactId], references: [id], onDelete: Cascade)
  lead        CrmLead?        @relation("ActivityLead", fields: [leadId], references: [id], onDelete: Cascade)
  opportunity CrmOpportunity? @relation("ActivityOpportunity", fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([accountId])
  @@index([contactId])
  @@index([leadId])
  @@index([opportunityId])
  @@index([activityType])
  @@index([scheduledAt])
  @@index([createdAt(sort: Desc)])
  customFields     Json?              @map("custom_fields")
  @@map("crm_activities")
}

// CRM Notes — rich-text notes on any CRM entity
model CrmNote {
  id       String @id @default(uuid()) @db.Uuid
  content  String @db.Text
  authorId String @map("author_id") @db.Uuid

  // Polymorphic — only one should be set
  accountId     String? @map("account_id") @db.Uuid
  contactId     String? @map("contact_id") @db.Uuid
  leadId        String? @map("lead_id") @db.Uuid
  opportunityId String? @map("opportunity_id") @db.Uuid

  isPinned  Boolean  @default(false) @map("is_pinned")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  author      User            @relation("CrmNoteAuthor", fields: [authorId], references: [id])
  account     CrmAccount?     @relation("NoteAccount", fields: [accountId], references: [id], onDelete: Cascade)
  contact     CrmContact?     @relation("NoteContact", fields: [contactId], references: [id], onDelete: Cascade)
  lead        CrmLead?        @relation("NoteLead", fields: [leadId], references: [id], onDelete: Cascade)
  opportunity CrmOpportunity? @relation("NoteOpportunity", fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@index([accountId])
  @@index([contactId])
  @@index([leadId])
  @@index([opportunityId])
  @@index([createdAt(sort: Desc)])
  @@map("crm_notes")
}

// CRM Account ↔ Request junction — links service desk tickets to CRM accounts
model CrmAccountRequest {
  id        String   @id @default(uuid()) @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  requestId String   @map("request_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  account CrmAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  request Request    @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([accountId, requestId])
  @@index([accountId])
  @@index([requestId])
  @@map("crm_account_requests")
}

// CRM Beneficiary — linked to a contact for trust/estate planning
model CrmBeneficiary {
  id            String     @id @default(uuid()) @db.Uuid
  contactId     String     @map("contact_id") @db.Uuid
  contact       CrmContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  firstName     String     @map("first_name") @db.VarChar(100)
  lastName      String     @map("last_name") @db.VarChar(100)
  relationship  String     @db.VarChar(20)
  allocationPct Decimal    @map("allocation_pct") @db.Decimal(5, 2)
  email         String?    @db.VarChar(255)
  phone         String?    @db.VarChar(50)
  nricPassport  String?    @map("nric_passport") @db.VarChar(50)
  dateOfBirth   DateTime?  @map("date_of_birth") @db.Date
  isMinor       Boolean    @default(false) @map("is_minor")
  guardianName  String?    @map("guardian_name") @db.VarChar(200)
  notes         String?    @db.Text
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([contactId])
  @@map("crm_beneficiaries")
}

// CRM Trust Product — trust/estate products linked to accounts/contacts
model CrmTrustProduct {
  id            String          @id @default(uuid()) @db.Uuid
  accountId     String          @map("account_id") @db.Uuid
  account       CrmAccount      @relation(fields: [accountId], references: [id])
  contactId     String?         @map("contact_id") @db.Uuid
  contact       CrmContact?     @relation(fields: [contactId], references: [id])
  opportunityId String?         @unique @map("opportunity_id") @db.Uuid
  opportunity   CrmOpportunity? @relation(fields: [opportunityId], references: [id])

  trustType     String  @map("trust_type") @db.VarChar(30)
  deedRefNumber String? @unique @map("deed_ref_number") @db.VarChar(50)
  status        String  @default("ACTIVE") @db.VarChar(20)

  assetValue       Decimal? @map("asset_value") @db.Decimal(15, 2)
  currency         String   @default("MYR") @db.VarChar(3)
  assetDescription String?  @map("asset_description") @db.Text

  trusteeName    String?   @map("trustee_name") @db.VarChar(200)
  trusteeContact String?   @map("trustee_contact") @db.VarChar(100)
  settlementDate DateTime? @map("settlement_date") @db.Date
  maturityDate   DateTime? @map("maturity_date") @db.Date
  nextReviewDate DateTime? @map("next_review_date") @db.Date

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)
  ownerId   String   @map("owner_id") @db.Uuid
  owner     User     @relation("CrmTrustProductOwner", fields: [ownerId], references: [id])

  @@index([accountId])
  @@index([contactId])
  @@index([nextReviewDate])
  @@index([status])
  @@map("crm_trust_products")
}

// CRM KYC Record — Know Your Customer verification for a contact
model CrmKycRecord {
  id        String     @id @default(uuid()) @db.Uuid
  contactId String     @unique @map("contact_id") @db.Uuid
  contact   CrmContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  status    String  @default("PENDING") @db.VarChar(20)
  riskLevel String? @db.VarChar(10)
  isPep     Boolean @default(false) @map("is_pep")

  nricVerified          Boolean @default(false) @map("nric_verified")
  addressVerified       Boolean @default(false) @map("address_verified")
  incomeVerified        Boolean @default(false) @map("income_verified")
  sourceOfFundsVerified Boolean @default(false) @map("source_of_funds_verified")
  riskProfileDone       Boolean @default(false) @map("risk_profile_done")

  approvedAt      DateTime? @map("approved_at") @db.Timestamp(6)
  approvedBy      String?   @map("approved_by") @db.Uuid
  approvedByUser  User?     @relation("CrmKycApprovedBy", fields: [approvedBy], references: [id])
  expiresAt       DateTime? @map("expires_at") @db.Timestamp(6)
  rejectionReason String?   @map("rejection_reason") @db.Text
  amlRiskTier        String?   @map("aml_risk_tier") @db.VarChar(10)
  screeningStatus    String?   @map("screening_status") @db.VarChar(20)
  screeningHits      Json?     @map("screening_hits")
  lastScreeningAt    DateTime? @map("last_screening_at") @db.Timestamp(6)
  nextScreeningDueAt DateTime? @map("next_screening_due_at") @db.Timestamp(6)

  notes     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([status])
  @@index([expiresAt])
  @@map("crm_kyc_records")
}

// CRM Import Job — tracks bulk data imports (CSV/XLSX)
model CrmImportJob {
  id              String   @id @default(uuid()) @db.Uuid
  fileName        String   @map("file_name") @db.VarChar(255)
  fileType        String   @map("file_type") @db.VarChar(10)  // CSV | XLSX
  entity          String   @db.VarChar(20)  // LEAD | CONTACT | ACCOUNT | OPPORTUNITY
  status          String   @default("PENDING") @db.VarChar(20)  // PENDING | VALIDATING | PREVIEW | IMPORTING | COMPLETED | FAILED
  totalRows       Int      @default(0) @map("total_rows")
  importedRows    Int      @default(0) @map("imported_rows")
  failedRows      Int      @default(0) @map("failed_rows")
  errorReport     Json?    @map("error_report")
  columnMapping   Json?    @map("column_mapping")
  rawData         Json?    @map("raw_data")  // Stores parsed rows for preview
  createdBy       String   @map("created_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamp(6)
  completedAt     DateTime? @map("completed_at") @db.Timestamp(6)

  user            User     @relation("CrmImportJobUser", fields: [createdBy], references: [id])

  @@index([createdBy])
  @@index([entity])
  @@index([status])
  @@map("crm_import_jobs")
}

// CRM Export Job — tracks data exports (CSV/XLSX)
model CrmExportJob {
  id              String   @id @default(uuid()) @db.Uuid
  entity          String   @db.VarChar(20)  // LEAD | CONTACT | ACCOUNT | OPPORTUNITY
  filters         Json?    // Active filters at export time
  format          String   @default("CSV") @db.VarChar(10)  // CSV | XLSX
  rowCount        Int      @default(0) @map("row_count")
  fileUrl         String?  @map("file_url") @db.Text
  status          String   @default("PENDING") @db.VarChar(20)  // PENDING | GENERATING | COMPLETED | FAILED
  error           String?  @db.Text
  createdBy       String   @map("created_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  user            User     @relation("CrmExportJobUser", fields: [createdBy], references: [id])

  @@index([createdBy])
  @@index([entity])
  @@index([status])
  @@map("crm_export_jobs")
}

// ============================================================================
// CRM TERRITORY & QUOTA
// ============================================================================

model CrmTerritory {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(100)
  description String?  @db.Text
  regions     Json     // { states: ["Selangor", "KL"], countries: ["MY"] }
  isActive    Boolean  @default(true) @map("is_active")
  createdBy   String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  members     CrmTerritoryMember[]
  quotas      CrmQuota[]
  leads       CrmLead[]              @relation("LeadTerritory")
  assignmentRules CrmAssignmentRule[]
  user        User                    @relation("CrmTerritoryCreator", fields: [createdBy], references: [id])

  @@index([createdBy])
  @@index([isActive])
  @@map("crm_territories")
}

model CrmTerritoryMember {
  id           String       @id @default(uuid()) @db.Uuid
  territoryId  String       @map("territory_id") @db.Uuid
  userId       String       @map("user_id") @db.Uuid
  role         String       @default("MEMBER") @db.VarChar(20) // MANAGER | MEMBER
  assignedAt   DateTime     @default(now()) @map("assigned_at") @db.Timestamp(6)

  territory    CrmTerritory @relation(fields: [territoryId], references: [id], onDelete: Cascade)
  user         User         @relation("CrmTerritoryMemberUser", fields: [userId], references: [id])

  @@unique([territoryId, userId])
  @@index([territoryId])
  @@index([userId])
  @@map("crm_territory_members")
}

model CrmQuota {
  id             String        @id @default(uuid()) @db.Uuid
  territoryId    String?       @map("territory_id") @db.Uuid // null = individual quota
  userId         String?       @map("user_id") @db.Uuid // null = territory-level quota
  period         String        @db.VarChar(20) // "2026-Q1", "2026-06", "2026"
  periodType     String        @default("MONTHLY") @db.VarChar(20) // MONTHLY | QUARTERLY | ANNUALLY
  targetAmount   Decimal       @default(0) @db.Decimal(15, 2)
  currency       String        @default("MYR") @db.VarChar(3)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamp(6)

  territory      CrmTerritory? @relation(fields: [territoryId], references: [id])
  user           User?         @relation("CrmQuotaUser", fields: [userId], references: [id])

  @@index([territoryId])
  @@index([userId])
  @@index([period])
  @@map("crm_quotas")
}

// ============================================================================
// CRM DASHBOARD LAYOUT
// ============================================================================

model CrmDashboardLayout {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  layout    Json     @default("[]")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User     @relation("UserCrmDashboardLayout", fields: [userId], references: [id], onDelete: Cascade)

  @@map("crm_dashboard_layouts")
}

// ============================================================================
// CRM WORKFLOW AUTOMATION
// ============================================================================

model CrmWorkflow {
  id              String            @id @default(uuid()) @db.Uuid
  name            String            @db.VarChar(200)
  description     String?           @db.Text
  isActive        Boolean           @default(true) @map("is_active")
  trigger         Json              @default("{}")
  actions         Json              @default("[]")
  executionOrder  Int               @default(0) @map("execution_order")
  createdBy       String            @map("created_by") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  executions      CrmWorkflowExecution[]
  user            User              @relation("CrmWorkflowCreator", fields: [createdBy], references: [id])

  @@index([isActive])
  @@index([createdBy])
  @@map("crm_workflows")
}

model CrmWorkflowExecution {
  id              String            @id @default(uuid()) @db.Uuid
  workflowId      String            @map("workflow_id") @db.Uuid
  triggerEntity   String            @db.VarChar(50) // LEAD | OPPORTUNITY | CONTACT | ACCOUNT | ACTIVITY
  triggerEntityId String            @map("trigger_entity_id") @db.Uuid
  triggerEvent    String            @map("trigger_event") @db.VarChar(100) // lead.status.changed, etc.
  status          String            @default("PENDING") @db.VarChar(20) // PENDING | RUNNING | COMPLETED | FAILED
  actionResults   Json?             @map("action_results")
  error           String?           @db.Text
  startedAt       DateTime          @default(now()) @map("started_at")
  completedAt     DateTime?        @map("completed_at")

  workflow        CrmWorkflow       @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@index([status])
  @@index([triggerEntity, triggerEntityId])
  @@map("crm_workflow_executions")
}

// ============================================================================
// CRM EMAIL / CALENDAR INTEGRATION
// ============================================================================

model CrmEmailIntegration {
  id                String            @id @default(uuid()) @db.Uuid
  userId            String            @unique @map("user_id") @db.Uuid
  provider          String            @db.VarChar(20) // GOOGLE | OUTLOOK
  accessToken       String            @map("access_token") @db.VarChar(500)
  refreshToken      String            @map("refresh_token") @db.VarChar(500)
  tokenExpiresAt    DateTime          @map("token_expires_at")
  emailAddress      String            @map("email_address") @db.VarChar(255)
  syncEnabled       Boolean           @default(true) @map("sync_enabled")
  lastSyncedAt      DateTime?         @map("last_synced_at")
  syncFrequency     String            @default("15min") @map("sync_frequency") @db.VarChar(10)
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  user              User              @relation("CrmEmailIntegrationUser", fields: [userId], references: [id])
  syncedEmails      CrmSyncedEmail[]
  syncedEvents      CrmSyncedEvent[]

  @@map("crm_email_integrations")
}

model CrmSyncedEmail {
  id                String            @id @default(uuid()) @db.Uuid
  integrationId     String            @map("integration_id") @db.Uuid
  providerMessageId String            @unique @map("provider_message_id") @db.VarChar(500)
  threadId          String?           @map("thread_id") @db.VarChar(200)
  from              Json              @default("{}")
  to                Json              @default("[]")
  cc                Json?
  subject           String            @db.VarChar(500)
  bodyPreview       String?           @map("body_preview") @db.Text
  bodyHtml          String?           @map("body_html") @db.Text
  sentAt            DateTime          @map("sent_at")
  isFromUs          Boolean           @default(false) @map("is_from_us")
  activityId        String?           @map("activity_id") @db.Uuid
  matchedContactId  String?           @map("matched_contact_id") @db.Uuid
  matchedLeadId     String?           @map("matched_lead_id") @db.Uuid
  matchedAccountId  String?           @map("matched_account_id") @db.Uuid

  integration       CrmEmailIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  contact           CrmContact?       @relation("CrmSyncedEmailContact", fields: [matchedContactId], references: [id])
  lead              CrmLead?          @relation("CrmSyncedEmailLead", fields: [matchedLeadId], references: [id])
  account          CrmAccount?       @relation("CrmSyncedEmailAccount", fields: [matchedAccountId], references: [id])

  @@index([integrationId])
  @@index([sentAt])
  @@index([matchedContactId])
  @@index([matchedLeadId])
  @@index([isFromUs])
  @@map("crm_synced_emails")
