// ============================================================================
// Related Party Group — connected-party / common-ownership tracking
// ============================================================================
model RelatedPartyGroup {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @db.VarChar(255)
  description String? @db.Text
  relationshipType String? @map("relationship_type") @db.VarChar(100)
  
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)
  
  members RelatedPartyMember[]
  
  @@map("related_party_groups")
}

model RelatedPartyMember {
  id                String  @id @default(uuid()) @db.Uuid
  groupId           String  @map("group_id") @db.Uuid
  borrowerProfileId String  @map("borrower_profile_id") @db.Uuid
  
  role               String? @db.VarChar(100)
  
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
