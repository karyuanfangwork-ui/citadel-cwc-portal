// ============================================================================
// ANNOUNCEMENTS / NEWSLETTER
// ============================================================================

enum AnnouncementCategory {
  HR
  MARKETING
  IT
  GENERAL
  FINANCE
  POLICY
}

enum AnnouncementPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Announcement {
  id             String               @id @default(uuid()) @db.Uuid
  tenantId       String?              @map("tenant_id") @db.Uuid
  title          String               @db.VarChar(500)
  content        String               @db.Text
  excerpt        String?              @db.Text
  category       AnnouncementCategory @default(GENERAL)
  priority       AnnouncementPriority @default(MEDIUM)
  targetAudience String               @default("ALL") @db.VarChar(50)
  isPinned       Boolean              @default(false) @map("is_pinned")
  isPublished    Boolean              @default(false) @map("is_published")
  publishedAt    DateTime?            @map("published_at") @db.Timestamp(6)
  expiresAt      DateTime?            @map("expires_at") @db.Timestamp(6)
  authorId       String               @map("author_id") @db.Uuid
  attachmentUrl  String?              @map("attachment_url") @db.VarChar(1000)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamp(6)
  deletedAt      DateTime?            @map("deleted_at") @db.Timestamp(6)

  // Relations
  author User               @relation("AnnouncementAuthor", fields: [authorId], references: [id])
  reads  AnnouncementRead[]

  @@index([isPublished, publishedAt(sort: Desc)])
  @@index([category])
  @@index([isPinned])
  @@index([expiresAt])
  @@index([tenantId])
  @@map("announcements")
}

model AnnouncementRead {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String?  @map("tenant_id") @db.Uuid
  announcementId String   @map("announcement_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  readAt         DateTime @default(now()) @map("read_at") @db.Timestamp(6)

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation("AnnouncementReader", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([tenantId])
  @@index([announcementId])
  @@index([userId])
  @@map("announcement_reads")
}

model RequestParticipant {
  id              String   @id @default(uuid()) @db.Uuid
  requestId       String   @map("request_id") @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  addedById       String?  @map("added_by_id") @db.Uuid
  participantRole String   @default("MANUAL") @map("participant_role") @db.VarChar(50)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user    User    @relation("RequestParticipants", fields: [userId], references: [id])
  addedBy User?   @relation("ParticipantAddedBy", fields: [addedById], references: [id])

  @@unique([requestId, userId, participantRole])
  @@index([requestId, userId])
  @@index([userId])
  @@index([addedById])
  @@map("request_participants")
}

// ============================================================================
// FEATURE FLAGS — Credit Module & Beyond
