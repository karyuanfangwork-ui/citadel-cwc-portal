  entityType  String   @db.VarChar(20) // OPPORTUNITY | LEAD
  anomalyType String   @db.VarChar(30) // DEAL_STUCK | PROBABILITY_DROP | VELOCITY_ANOMALY | STALE_LEAD
  threshold   Float    @default(14) // days for stuck, % for probability drop, stddev for velocity
