// ============================================================================
// Collateral
// ============================================================================
model Collateral {
  id             String       @id @default(uuid()) @db.Uuid
  facilityId     String       @map("facility_id") @db.Uuid
  
  collateralType String       @map("collateral_type") @db.VarChar(50)
  description    String?      @db.Text
  titleReference String?       @map("title_reference") @db.VarChar(255)
  registeredTo   String?       @map("registered_to") @db.VarChar(255)
  
  marketValue    Decimal?      @map("market_value") @db.Decimal(15, 2)
  forcedSaleValue Decimal?     @map("forced_sale_value") @db.Decimal(15, 2)
  valuationDate  DateTime?    @map("valuation_date") @db.Date
  valuer         String?      @db.VarChar(255)
  
  insuranceCoverRequired Boolean @default(false) @map("insurance_cover_required")

  // CA Memo Phase 4 — Section 8 dual valuation + classification
  securityCategory      SecurityCategory? @map("security_category")
  securitySubType       String?           @map("security_sub_type") @db.VarChar(100)
  isExisting            Boolean           @default(true) @map("is_existing")
  isNewToBeObtained     Boolean           @default(false) @map("is_new_to_be_obtained")
  pmmdMarketValue       Decimal?          @map("pmmd_market_value") @db.Decimal(15, 2)
  pmmdForcedSaleValue   Decimal?          @map("pmmd_forced_sale_value") @db.Decimal(15, 2)
  panelValuerName       String?           @map("panel_valuer_name") @db.VarChar(255)
  securityCoverageRatio Decimal?          @map("security_coverage_ratio") @db.Decimal(8, 4)

  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamp(6)

  facility       ApplicationFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  valuations     CollateralValuation[]
  liens          CollateralLien[]
  insuranceCovers InsuranceCover[]

  @@index([facilityId])
  @@map("collaterals")
}

model CollateralValuation {
  id            String   @id @default(uuid()) @db.Uuid
  collateralId  String   @map("collateral_id") @db.Uuid
  
  marketValue       Decimal   @map("market_value") @db.Decimal(15, 2)
  forcedSaleValue   Decimal   @map("forced_sale_value") @db.Decimal(15, 2)
  valuationDate     DateTime  @map("valuation_date") @db.Date
  valuer           String    @db.VarChar(255)
  reportReference  String?   @map("report_reference") @db.VarChar(255)
  
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  
  collateral Collateral @relation(fields: [collateralId], references: [id], onDelete: Cascade)
  
  @@index([collateralId])
  @@map("collateral_valuations")
}

model CollateralLien {
