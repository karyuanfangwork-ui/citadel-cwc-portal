model FeatureFlag {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String?  @map("tenant_id") @db.Uuid
  key         String   @db.VarChar(100) // P2-09: removed @unique, see migration SQL for partial unique indexes
