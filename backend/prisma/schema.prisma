// ============================================================================
// HIRING WORKFLOW
// ============================================================================

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model RequestApproval {
  id        String @id @default(uuid()) @db.Uuid
  requestId String @map("request_id") @db.Uuid

  approverType String  @map("approver_type") @db.VarChar(50) // 'CEO', 'HIRING_MANAGER', 'ENTITY'
  approverId   String? @map("approver_id") @db.Uuid
  entityId     String? @map("entity_id") @db.Uuid

  // P5-06: Link to the approval policy step that created this approval
  policyId  String? @map("policy_id") @db.Uuid
  stepOrder Int?    @map("step_order")

  // P5-08: Delegation — if this approval was delegated, who delegated to whom
  delegatedBy String?   @map("delegated_by") @db.Uuid // Original approver who delegated
  delegatedTo String?   @map("delegated_to") @db.Uuid // User who received the delegation
  delegatedAt DateTime? @map("delegated_at") @db.Timestamp(6)

  // P5-08: Reminder tracking
  reminderCount  Int       @default(0) @map("reminder_count")
  lastReminderAt DateTime? @map("last_reminder_at") @db.Timestamp(6)

  // P5-08: Timeout tracking — when this approval step is due
  dueAt DateTime? @map("due_at") @db.Timestamp(6) // Calculated from policy step timeoutHours

  status   ApprovalStatus @default(PENDING)
  comments String?        @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  // Relations
  request     Request              @relation(fields: [requestId], references: [id], onDelete: Cascade)
  approver    User?                @relation(fields: [approverId], references: [id])
  entity      Entity?              @relation("ApprovalEntity", fields: [entityId], references: [id])
  policy      ApprovalPolicy?      @relation(fields: [policyId], references: [id])
  delegator   User?                @relation("ApprovalDelegator", fields: [delegatedBy], references: [id])
  delegate    User?                @relation("ApprovalDelegate", fields: [delegatedTo], references: [id])
  delegations ApprovalDelegation[]
  reminders   ApprovalReminder[]

  @@index([requestId])
  @@index([approverId])
  @@index([entityId])
  @@index([policyId])
  @@index([delegatedBy])
  @@index([delegatedTo])
  @@index([status, dueAt]) // For timeout queries
  @@map("request_approvals")
}

// P5-08: Approval delegation log — records each delegation action
model ApprovalDelegation {
  id         String   @id @default(uuid()) @db.Uuid
  approvalId String   @map("approval_id") @db.Uuid // The RequestApproval being delegated
  fromUserId String   @map("from_user_id") @db.Uuid // Original approver
  toUserId   String   @map("to_user_id") @db.Uuid // Delegate receiving the approval
  reason     String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  // Relations
  approval RequestApproval @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  fromUser User            @relation("DelegationFrom", fields: [fromUserId], references: [id])
  toUser   User            @relation("DelegationTo", fields: [toUserId], references: [id])

  @@index([approvalId])
  @@index([fromUserId])
  @@index([toUserId])
  @@map("approval_delegations")
}

// P5-08: Approval reminder log — tracks reminders sent for pending approvals
model ApprovalReminder {
  id              String   @id @default(uuid()) @db.Uuid
  approvalId      String   @map("approval_id") @db.Uuid // The RequestApproval being reminded
  recipientUserId String   @map("recipient_user_id") @db.Uuid // Who received the reminder
  type            String   @db.VarChar(20) // 'FIRST', 'SECOND', 'ESCALATION'
  sentAt          DateTime @default(now()) @map("sent_at") @db.Timestamp(6)

  // Relations
  approval  RequestApproval @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  recipient User            @relation(fields: [recipientUserId], references: [id])

  @@index([approvalId])
  @@index([recipientUserId])
  @@map("approval_reminders")
}

model Candidate {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String?  @map("tenant_id") @db.Uuid
  requestId String   @map("request_id") @db.Uuid
  fullName  String   @map("full_name") @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  request            Request             @relation(fields: [requestId], references: [id], onDelete: Cascade)
  documents          CandidateResume[]
  interviewSchedules InterviewSchedule[]
  interviewFeedbacks InterviewFeedback[]

  @@unique([requestId, fullName], name: "unique_candidate_per_request")
  @@index([requestId])
  @@index([tenantId])
  @@map("candidates")
}

model CandidateResume {
  id            String   @id @default(uuid()) @db.Uuid
  requestId     String   @map("request_id") @db.Uuid
  candidateId   String   @map("candidate_id") @db.Uuid
  fileName      String   @map("file_name") @db.VarChar(255)
  fileUrl       String   @map("file_url") @db.Text
  fileSize      BigInt   @map("file_size")
  mimeType      String?  @map("mime_type") @db.VarChar(100)
  uploadedById  String   @map("uploaded_by_id") @db.Uuid
  candidateName String?  @map("candidate_name") @db.VarChar(200) // kept for denormalized display
  documentType  String   @default("RESUME") @map("document_type") @db.VarChar(50)
  notes         String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  // Relations
  request    Request   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  uploadedBy User      @relation(fields: [uploadedById], references: [id])
  candidate  Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([candidateId, documentType], name: "unique_doc_type_per_candidate")
  @@index([requestId])
  @@map("candidate_resumes")
}

