  // Authoritative display name — required at creation for all borrower types
  name String? @db.VarChar(255)

  // Optional CRM soft links — no validation dependency, kept for future sync only
  accountId String? @unique @map("account_id") @db.Uuid
  contactId String? @unique @map("contact_id") @db.Uuid

  // Credit-specific fields
  creditRiskRating       RiskRating?  @map("credit_risk_rating")
