  exposureLimit          Decimal?     @map("exposure_limit") @db.Decimal(15, 2)
  totalExposure          Decimal?     @default(0) @map("total_exposure") @db.Decimal(15, 2)
  isSanctionedEntity     Boolean      @default(false) @map("is_sanctioned_entity")
  sourceOfWealth         String?      @map("source_of_wealth") @db.VarChar(255)
  purposeOfAccount       String?      @map("purpose_of_account") @db.VarChar(255)
  occupation             String?      @db.VarChar(100)
  employer               String?      @db.VarChar(255)
  annualIncome           Decimal?     @map("annual_income") @db.Decimal(15, 2)
  netWorth               Decimal?     @map("net_worth") @db.Decimal(15, 2)

  // P2-2: Annual turnover for SME lane threshold (RM). Used by lane.service.ts.
  annualTurnover Decimal? @map("annual_turnover") @db.Decimal(15, 2)

  // P2-3: SME-specific fields
