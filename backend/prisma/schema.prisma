// ============================================================================

enum ActivityType {
  COMMENT
  STATUS_CHANGE
  ASSIGNMENT
  ATTACHMENT
  SYSTEM
  APPROVAL
  REJECTION
}

enum AttachmentScanStatus {
  PENDING_SCAN
  CLEAN
  INFECTED
  SCAN_FAILED
}

enum AttachmentClassification {
  INTERNAL
  CONFIDENTIAL
  RESTRICTED
}

enum AttachmentRetentionStatus {
  ACTIVE
  LEGAL_HOLD
  PENDING_DELETION
  DELETED
}

model RequestActivity {
  id        String @id @default(uuid()) @db.Uuid
  requestId String @map("request_id") @db.Uuid

  // Author
  authorId        String? @map("author_id") @db.Uuid
  authorName      String  @map("author_name") @db.VarChar(200)
  authorRole      String? @map("author_role") @db.VarChar(100)
  authorAvatarUrl String? @map("author_avatar_url") @db.Text

  // Activity Details
  activityType      ActivityType @map("activity_type")
  message           String       @db.Text
  isSystemGenerated Boolean      @default(false) @map("is_system_generated")
  isInternal        Boolean      @default(false) @map("is_internal")

  // Metadata
  metadata Json? @db.JsonB

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  // Relations
  request     Request             @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author      User?               @relation(fields: [authorId], references: [id])
  attachments RequestAttachment[]

  @@index([requestId, createdAt(sort: Desc)])
  @@map("request_activities")
}

model RequestAttachment {
  id           String  @id @default(uuid()) @db.Uuid
  tenantId     String  @map("tenant_id") @db.Uuid
  departmentId String  @map("department_id") @db.Uuid
  requestId    String  @map("request_id") @db.Uuid
  activityId   String? @map("activity_id") @db.Uuid

  uploadedById String? @map("uploaded_by_id") @db.Uuid

  fileName    String  @map("file_name") @db.VarChar(255)
  fileSize    BigInt  @map("file_size")
  fileType    String? @map("file_type") @db.VarChar(100)
  mimeType    String? @map("mime_type") @db.VarChar(100)
  storagePath String  @map("storage_path") @db.Text
  storageUrl  String  @map("storage_url") @db.Text
  contentHash String? @map("content_hash") @db.VarChar(64)

  classification AttachmentClassification @default(INTERNAL)

  isScanned              Boolean              @default(false) @map("is_scanned")
  scanResult             String?              @map("scan_result") @db.VarChar(50)
  scanStatus             AttachmentScanStatus @default(PENDING_SCAN) @map("scan_status")
  scanJobId              String?              @unique @map("scan_job_id") @db.Uuid
  scanCallbackNonceHash  String?              @map("scan_callback_nonce_hash") @db.VarChar(64)
  scanCallbackExpiresAt  DateTime?            @map("scan_callback_expires_at") @db.Timestamp(6)
  scanCallbackConsumedAt DateTime?            @map("scan_callback_consumed_at") @db.Timestamp(6)
  scanCompletedAt        DateTime?            @map("scan_completed_at") @db.Timestamp(6)
  quarantinePath         String?              @map("quarantine_path") @db.Text
  quarantinedAt          DateTime?            @map("quarantined_at") @db.Timestamp(6)
  sourceDeletedAt        DateTime?            @map("source_deleted_at") @db.Timestamp(6)

  retentionStatus AttachmentRetentionStatus @default(ACTIVE) @map("retention_status")
  retentionUntil  DateTime?                 @map("retention_until") @db.Timestamp(6)
  legalHoldAt     DateTime?                 @map("legal_hold_at") @db.Timestamp(6)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamp(6)

  // Relations
  department       Department        @relation(fields: [tenantId, departmentId], references: [tenantId, id], onDelete: Restrict)
  request          Request           @relation(fields: [requestId, tenantId, departmentId], references: [id, tenantId, departmentId], onDelete: Cascade)
  activity         RequestActivity?  @relation(fields: [activityId], references: [id], onDelete: SetNull)
  uploadedBy       User?             @relation(fields: [uploadedById], references: [id])
  expenseLineItems ExpenseLineItem[]

  @@index([requestId])
  @@index([tenantId, departmentId])
  @@index([scanStatus])
  @@map("request_attachments")
}

