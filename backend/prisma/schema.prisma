  documentId        String?  @map("document_id") @db.Uuid
  fileName          String   @map("file_name") @db.VarChar(255)
  fileUrl           String   @map("file_url") @db.Text
  uploadedById      String?  @map("uploaded_by_id") @db.Uuid
  uploadedAt        DateTime @default(now()) @map("uploaded_at") @db.Timestamp(6)

  str               SuspiciousTransaction @relation(fields: [strId], references: [id], onDelete: Cascade)
  uploadedBy        User?                @relation("StrUploadedBy", fields: [uploadedById], references: [id])

  @@index([strId])
  @@map("str_attachments")
}

