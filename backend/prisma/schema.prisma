  amlRiskTier       AmlRiskTier?  @map("aml_risk_tier")
  exposureLimit     Decimal?      @map("exposure_limit") @db.Decimal(15, 2)
  totalExposure     Decimal?      @default(0) @map("total_exposure") @db.Decimal(15, 2)
  isSanctionedEntity Boolean      @default(false) @map("is_sanctioned_entity")
  sourceOfWealth    String?       @map("source_of_wealth") @db.VarChar(255)
  purposeOfAccount  String?       @map("purpose_of_account") @db.VarChar(255)
  occupation        String?       @db.VarChar(100)
  employer          String?       @db.VarChar(255)
  annualIncome      Decimal?      @map("annual_income") @db.Decimal(15, 2)
  netWorth          Decimal?      @map("net_worth") @db.Decimal(15, 2)
  
  // P2-2: Annual turnover for SME lane threshold (RM). Used by lane.service.ts.
  annualTurnover    Decimal?      @map("annual_turnover") @db.Decimal(15, 2)

  // P2-3: SME-specific fields
  yearsTrading                Int?                     @map("years_trading")
  smeFinancialStatementType   SmeFinancialStatementType? @map("sme_financial_statement_type")
  sicCode                     String?                  @map("sic_code") @db.VarChar(10)

  // §2.9 — Encrypted PII fields (AES-256-GCM)
  // These store the encrypted versions of annualIncome, netWorth, and sourceOfWealth.
  // The plaintext fields above are retained for backward compatibility during migration.
  annualIncomeEncrypted  String?  @map("annual_income_encrypted") @db.VarChar(255)
  netWorthEncrypted      String?  @map("net_worth_encrypted") @db.VarChar(255)
  sourceOfWealthEncrypted String? @map("source_of_wealth_encrypted") @db.VarChar(255)
  
  isActive          Boolean      @default(true) @map("is_active")
  deletedAt         DateTime?    @map("deleted_at") @db.Timestamp(6)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamp(6)

  // §3.1 — Multi-branch support
  branchId          String?      @map("branch_id") @db.Uuid
  branch            Branch?      @relation(fields: [branchId], references: [id])

  // Relations
  account           CrmAccount?  @relation(fields: [accountId], references: [id])
  contact           CrmContact?  @relation(fields: [contactId], references: [id])
  directors         Director[]
  shareholders      Shareholder[]
  beneficialOwners  UltimateBeneficialOwner[]
  applications      CreditApplication[]
  documents         CreditDocument[]
  relatedPartyMembers RelatedPartyMember[]
  applicationParties ApplicationParty[]
  guarantees        Guarantee[]
  financialStatements FinancialStatement[]
  keyCounterparties KeyCounterparty[]
  amlRescreenEvents AmlRescreenEvent[]
  fatcaCrsDeclarations FatcaCrsDeclaration[]

  @@index([accountId])
  @@index([contactId])
  @@index([borrowerType])
  @@index([creditRiskRating])
  @@index([amlRiskTier])
  @@index([branchId])
  @@map("borrower_profiles")
}

// ============================================================================
// FATCA/CRS Declaration — §3.4 (Phase 3)
// ============================================================================
enum FatcaEntityClassification {
  INDIVIDUAL
  ACTIVE_NFE
  PASSIVE_NFE
  FINANCIAL_INSTITUTION
}

model FatcaCrsDeclaration {
  id                    String                    @id @default(uuid()) @db.Uuid
  borrowerProfileId     String                    @map("borrower_profile_id") @db.Uuid
  declarationDate       DateTime                  @map("declaration_date") @db.Date
  isUsPerson            Boolean                   @map("is_us_person")
  usTinEncrypted        String?                   @map("us_tin_encrypted") @db.VarChar(255)
  entityClassification  FatcaEntityClassification @map("entity_classification")
  crsResidencies        Json                      @map("crs_residencies")
  selfCertifiedById     String                    @map("self_certified_by_id") @db.Uuid
  verifiedById          String?                   @map("verified_by_id") @db.Uuid
  verifiedAt            DateTime?                 @map("verified_at") @db.Timestamp(6)
  expiryDate            DateTime?                 @map("expiry_date") @db.Date
  createdAt             DateTime                  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt             DateTime                  @updatedAt @map("updated_at") @db.Timestamp(6)

  borrowerProfile   BorrowerProfile @relation(fields: [borrowerProfileId], references: [id], onDelete: Cascade)
