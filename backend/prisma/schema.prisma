model CrmTerritoryMember {
  id          String   @id @default(uuid()) @db.Uuid
  territoryId String   @map("territory_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  role        String   @default("MEMBER") @db.VarChar(20) // MANAGER | MEMBER
  assignedAt  DateTime @default(now()) @map("assigned_at") @db.Timestamp(6)

  territory CrmTerritory @relation(fields: [territoryId], references: [id], onDelete: Cascade)
