model SuspiciousTransaction {
  id                String       @id @default(uuid()) @db.Uuid
  applicationId     String?      @map("application_id") @db.Uuid
  subjectName       String       @map("subject_name") @db.VarChar(255)
  subjectIdType     String?      @map("subject_id_type") @db.VarChar(20)    // "NRIC", "PASSPORT", "BRN"
  subjectIdNumber   String?      @map("subject_id_number") @db.VarChar(50)  // PII — encrypt at rest
  grounds           String       @db.Text                                        // Why suspicious
  filingReference    String?      @map("filing_reference") @db.VarChar(100)  // FIU/BNM reference
  filingDate        DateTime?    @map("filing_date") @db.Timestamp(6)
  status            StrStatus    @default(DRAFT)
  severity          String?      @db.VarChar(10)                                // LOW, MEDIUM, HIGH
  assignedToId      String?      @map("assigned_to_id") @db.Uuid
  reviewedById      String?      @map("reviewed_by_id") @db.Uuid
  reviewedAt        DateTime?    @map("reviewed_at") @db.Timestamp(6)
  notes             String?      @db.Text
  amlRescreenEventId String?     @map("aml_rescreen_event_id") @db.Uuid
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamp(6)

  application       CreditApplication?  @relation(fields: [applicationId], references: [id])
  assignedTo        User?               @relation("StrAssignedTo", fields: [assignedToId], references: [id])
  reviewedBy        User?               @relation("StrReviewedBy", fields: [reviewedById], references: [id])
  amlRescreenEvent  AmlRescreenEvent?   @relation(fields: [amlRescreenEventId], references: [id])
  attachments       StrAttachment[]

  @@index([status, severity])
  @@index([applicationId])
  @@map("suspicious_transactions")
}

