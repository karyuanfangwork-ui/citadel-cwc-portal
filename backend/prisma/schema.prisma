model NotificationTemplate {
  id        String  @id @default(uuid()) @db.Uuid
  tenantId  String? @map("tenant_id") @db.Uuid
  name      String  @unique @db.VarChar(100)
  eventType String  @map("event_type") @db.VarChar(100)

  emailSubject String? @map("email_subject") @db.Text
  emailBody    String? @map("email_body") @db.Text
  smsBody      String? @map("sms_body") @db.Text
  pushTitle    String? @map("push_title") @db.VarChar(200)
  pushBody     String? @map("push_body") @db.Text

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([tenantId])
  @@map("notification_templates")
}

enum NotificationChannel {
  EMAIL
  SMS
  PUSH
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  RETRYING
  CANCELLED
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  RETRYING
  FAILED
  CANCELLED
}

enum NotificationClassification {
  PUBLIC
  INTERNAL
  HR_CONFIDENTIAL
  FINANCE_CONFIDENTIAL
  RESTRICTED
}

model NotificationDomainEvent {
  id             String                     @id @default(uuid()) @db.Uuid
  eventKey       String                     @map("event_key") @db.VarChar(200)
  tenantId       String                     @map("tenant_id") @db.Uuid
  departmentId   String?                    @map("department_id") @db.Uuid
  eventType      String                     @map("event_type") @db.VarChar(100)
  classification NotificationClassification @default(INTERNAL)
  resourceType   String                     @map("resource_type") @db.VarChar(100)
  resourceId     String?                    @map("resource_id") @db.Uuid
  payloadVersion Int                        @default(1) @map("payload_version")
  payload        Json                       @db.JsonB
  occurredAt     DateTime                   @default(now()) @map("occurred_at") @db.Timestamp(6)
  createdAt      DateTime                   @default(now()) @map("created_at") @db.Timestamp(6)

  deliveries NotificationDelivery[]

  @@unique([tenantId, eventKey])
  @@index([tenantId, occurredAt(sort: Desc)])
  @@index([tenantId, eventType, occurredAt(sort: Desc)])
  @@index([departmentId, occurredAt(sort: Desc)])
  @@map("notification_domain_events")
}

model NotificationDelivery {
  id                String                     @id @default(uuid()) @db.Uuid
