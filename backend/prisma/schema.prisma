  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  @@map("request_status_definitions")
  @@index([isActive])
  @@index([category])
}

// Workflow transition rules — source of truth for valid status changes.
// The VALID_TRANSITIONS map in workflowTransitions.ts is the SEED reference;
// this table is the runtime source of truth.
model WorkflowTransition {
  id              String   @id @default(uuid()) @db.Uuid
  fromStatus      String   @map("from_status") @db.VarChar(100)
  toStatus        String   @map("to_status") @db.VarChar(100)
  transitionLabel String?  @map("transition_label") @db.VarChar(50)
  // Label values: APPROVE | REJECT | SUBMIT | ADVANCE | RETURN | ESCALATE | CLOSE
  requiresComment Boolean  @default(false) @map("requires_comment")
  // Hint: optional role or userId to auto-assign after this transition
  autoAssignRole  String?  @map("auto_assign_role") @db.VarChar(50)
  autoAssignUserId String? @map("auto_assign_user_id") @db.Uuid
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  // Each (fromStatus, toStatus) pair is unique
  @@unique([fromStatus, toStatus])
  @@map("workflow_transitions")
  @@index([fromStatus])
  @@index([toStatus])
  @@index([isActive])
}

// ============================================================================
// ENTITY-BASED APPROVAL ROUTING
// ============================================================================

enum EntityRoutingMode {
  REQUESTER_ENTITY
  CUSTOM_FIELD
}

model Entity {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(200)
  code        String   @unique @db.VarChar(50)
  description String?  @db.Text
  approverId  String   @map("approver_id") @db.Uuid
  isActive    Boolean  @default(true) @map("is_active")
  displayOrder Int     @default(0) @map("display_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  // Relations
  approver          User                       @relation("EntityApprover", fields: [approverId], references: [id])
  users             User[]                     @relation("UserEntity")
  requestApprovals  RequestApproval[]          @relation("ApprovalEntity")

  @@map("entities")
  @@index([approverId])
}

model RequestTypeEntityRouting {
  id             String            @id @default(uuid()) @db.Uuid
  requestTypeId  String            @map("request_type_id") @db.Uuid
  routingMode    EntityRoutingMode @map("routing_mode")
  customFieldKey String?           @map("custom_field_key") @db.VarChar(100)
  label          String?           @db.VarChar(200)
  isActive       Boolean           @default(true) @map("is_active")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamp(6)

  // Relations
  requestType RequestType @relation(fields: [requestTypeId], references: [id], onDelete: Cascade)

  @@map("request_type_entity_routings")
  @@index([requestTypeId])
}

// ============================================================================
// IT ASSET MANAGEMENT
// ============================================================================

model Asset {
  id             String        @id @default(uuid()) @db.Uuid
  assetTag       String        @unique @map("asset_tag") @db.VarChar(100)
  serialNumber   String?       @unique @map("serial_number") @db.VarChar(100)
  name           String        @db.VarChar(255)
  category       AssetCategory
  brand          String?       @db.VarChar(100)
  model          String?       @db.VarChar(100)
  purchaseDate   DateTime?     @map("purchase_date") @db.Date
  purchasePrice  Decimal?      @map("purchase_price") @db.Decimal(10, 2)
  vendor         String?       @db.VarChar(200)
  warrantyExpiry DateTime?     @map("warranty_expiry") @db.Date
  status         AssetStatus   @default(IN_STOCK)
  notes          String?       @db.Text

  sourceRequestId String? @map("source_request_id") @db.Uuid
  createdById     String  @map("created_by_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  sourceRequest      Request?          @relation("AssetSourceRequest", fields: [sourceRequestId], references: [id])
  createdBy          User              @relation("AssetCreatedBy", fields: [createdById], references: [id])
  assignments        AssetAssignment[]
  itHardwareRequests ITHardwareRequest[]

  @@map("assets")
  @@index([status])
  @@index([category])
  @@index([createdById])
}

model AssetAssignment {
  id              String    @id @default(uuid()) @db.Uuid
  assetId         String    @map("asset_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  assignedById    String    @map("assigned_by_id") @db.Uuid
  assignedAt      DateTime  @default(now()) @map("assigned_at") @db.Timestamp(6)
  returnedAt      DateTime? @map("returned_at") @db.Timestamp(6)
  reason          String?   @db.VarChar(200)
  linkedRequestId String?   @map("linked_request_id") @db.Uuid
  notes           String?   @db.Text

  asset          Asset    @relation(fields: [assetId], references: [id])
  user           User     @relation("AssetAssignmentUser", fields: [userId], references: [id])
  assignedBy     User     @relation("AssetAssignmentAssignedBy", fields: [assignedById], references: [id])
  linkedRequest  Request? @relation("AssetAssignmentRequest", fields: [linkedRequestId], references: [id])

  @@map("asset_assignments")
  @@index([assetId])
  @@index([userId])
}
