  matrix        CreditApprovalMatrix @relation(fields: [matrixId], references: [id], onDelete: Cascade)
  approvedBy    User                 @relation("MatrixVersionApprovedBy", fields: [approvedById], references: [id])
  
  @@index([matrixId])
  @@unique([matrixId, version])
  @@map("credit_approval_matrix_versions")
}

// ============================================================================
// Financial Statement — a borrower's financial statement (BS, PL, or CF)
// ============================================================================
model FinancialStatement {
  id               String               @id @default(uuid()) @db.Uuid
  borrowerProfileId String               @map("borrower_profile_id") @db.Uuid
  period           FinancialPeriod
  fiscalYearEnd    DateTime             @map("fiscal_year_end") @db.Date
  statementType    FinancialStatementType @map("statement_type")
  currency        CurrencyCode          @default(MYR)
  enteredById     String               @map("entered_by_id") @db.Uuid
  reviewedById    String?              @map("reviewed_by_id") @db.Uuid
  status          FinancialStatus       @default(DRAFT)
  
  // CA Memo Phase 3 — Section 12 audit + commentary
  auditorName                  String?  @map("auditor_name") @db.VarChar(255)
  isQualified                  Boolean? @map("is_qualified")
  qualificationNotes           String?  @map("qualification_notes") @db.Text
  isDraftAccounts              Boolean  @default(false) @map("is_draft_accounts")
  commentarySalesProfitability String?  @map("commentary_sales_profitability") @db.Text
  commentaryAssetMgmt          String?  @map("commentary_asset_mgmt") @db.Text
  commentaryDebtMgmt           String?  @map("commentary_debt_mgmt") @db.Text
  commentaryCashflow           String?  @map("commentary_cashflow") @db.Text
  commentaryConclusion         String?  @map("commentary_conclusion") @db.Text

  deletedAt       DateTime?            @map("deleted_at") @db.Timestamp(6)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamp(6)

  // Relations
  borrowerProfile BorrowerProfile      @relation(fields: [borrowerProfileId], references: [id], onDelete: Cascade)
  enteredBy       User                 @relation("FinancialEnteredBy", fields: [enteredById], references: [id])
  reviewedBy     User?                @relation("FinancialReviewedBy", fields: [reviewedById], references: [id])
  lineItems      FinancialLineItem[]
  ratios         FinancialRatio[]
  
  @@index([borrowerProfileId])
  @@index([statementType])
  @@index([status])
  @@map("financial_statements")
}

// ============================================================================
// Financial Line Item — individual line items within a financial statement
// ============================================================================
model FinancialLineItem {
  id             String   @id @default(uuid()) @db.Uuid
  statementId    String   @map("statement_id") @db.Uuid
  lineKey        String   @map("line_key") @db.VarChar(100)
  lineLabel      String   @map("line_label") @db.VarChar(200)
  amount         Decimal  @db.Decimal(15, 2)
  parentLineKey  String?  @map("parent_line_key") @db.VarChar(100)
  displayOrder   Int      @map("display_order")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamp(6)
  
  // Relations
  statement      FinancialStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  
  @@index([statementId])
  @@index([lineKey])
  @@unique([statementId, lineKey])
  @@map("financial_line_items")
}

// ============================================================================
// Financial Ratio — computed ratios derived from financial statements
// ============================================================================
model FinancialRatio {
  id          String        @id @default(uuid()) @db.Uuid
  statementId String        @map("statement_id") @db.Uuid
  ratioKey    String        @map("ratio_key") @db.VarChar(100)
  ratioLabel  String        @map("ratio_label") @db.VarChar(200)
  value       Decimal       @db.Decimal(10, 4)
  category    RatioCategory
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamp(6)
  
  // Relations
  statement   FinancialStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  
  @@index([statementId])
  @@index([ratioKey])
  @@index([category])
  @@map("financial_ratios")
}

// ============================================================================
// SPRINT 3 — SCORECARD & SCORING
// ============================================================================

// ============================================================================
// Credit Scorecard — defines a scoring model with weighted factor groups
// ============================================================================
model CreditScorecard {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(200)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  // Relations
  versions    CreditScorecardVersion[]

  @@map("credit_scorecards")
}

// ============================================================================
// Credit Scorecard Version — snapshot of factor weights for audit trail
// ============================================================================
model CreditScorecardVersion {
  id            String   @id @default(uuid()) @db.Uuid
  scorecardId   String   @map("scorecard_id") @db.Uuid
  version       Int
  factorWeights Json
  isActive      Boolean  @default(false) @map("is_active")
  effectiveFrom DateTime @map("effective_from") @db.Timestamp(6)
  approvedById  String?  @map("approved_by_id") @db.Uuid
  approvedAt    DateTime? @map("approved_at") @db.Timestamp(6)

  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  // Relations
  scorecard     CreditScorecard @relation(fields: [scorecardId], references: [id], onDelete: Cascade)
  approvedBy    User?           @relation("ScorecardVersionApprovedBy", fields: [approvedById], references: [id])
  scoreRuns     CreditScoreRun[]

  @@unique([scorecardId, version])
  @@index([scorecardId])
  @@map("credit_scorecard_versions")
}

// ============================================================================
// Credit Score Run — result of scoring an application with a scorecard version
// ============================================================================
model CreditScoreRun {
  id                   String     @id @default(uuid()) @db.Uuid
  applicationId         String     @map("application_id") @db.Uuid
  scorecardVersionId    String     @map("scorecard_version_id") @db.Uuid
  factorScores         Json
  totalScore           Decimal    @map("total_score") @db.Decimal(10, 2)
  riskRating           RiskRating @map("risk_rating")
  isOverride           Boolean    @default(false) @map("is_override")
  overrideReason       String?    @map("override_reason") @db.Text
  overrideApprovedById String?    @map("override_approved_by_id") @db.Uuid
  overrideApprovedAt   DateTime?  @map("override_approved_at") @db.Timestamp(6)
  runAt                DateTime   @default(now()) @map("run_at") @db.Timestamp(6)

  createdAt            DateTime   @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt            DateTime   @updatedAt @map("updated_at") @db.Timestamp(6)

  // Relations
  application          CreditApplication     @relation(fields: [applicationId], references: [id])
  scorecardVersion     CreditScorecardVersion @relation(fields: [scorecardVersionId], references: [id])
  overrideApprovedBy   User?                 @relation("ScoreRunOverrideApprovedBy", fields: [overrideApprovedById], references: [id])

  @@index([applicationId])
  @@index([scorecardVersionId])
  @@map("credit_score_runs")
}

// ============================================================================
// Committee — Sprint 4
// ============================================================================

enum CommitteeMeetingStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum CommitteeMeetingType {
  REGULAR
  ADHOC
}

enum CommitteeMemberRole {
  CHAIR
  MEMBER
  SECRETARY
}

enum CommitteeAttendance {
  PRESENT
  ABSENT
  EXCUSED
}

enum CommitteeVoteChoice {
  APPROVE
  REJECT
  ABSTAIN
}

enum AgendaItemDecisionType {
  APPROVE
  REJECT
  DEFER
}

model CommitteeMeeting {
  id          String                @id @default(uuid()) @db.Uuid
  title       String                @db.VarChar(200)
  scheduledAt DateTime              @map("scheduled_at") @db.Timestamp(6)
  location    String?               @db.VarChar(200)
  status      CommitteeMeetingStatus @default(SCHEDULED)
  quorumMin   Int                   @default(3) @map("quorum_min")
  meetingType CommitteeMeetingType  @default(REGULAR) @map("meeting_type")
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime              @updatedAt @map("updated_at") @db.Timestamp(6)

  members     CommitteeMember[]
  agendaItems CommitteeAgendaItem[]

  @@map("committee_meetings")
}

model CommitteeMember {
  id          String              @id @default(uuid()) @db.Uuid
  meetingId   String              @map("meeting_id") @db.Uuid
  userId      String              @map("user_id") @db.Uuid
  role        CommitteeMemberRole
  attendance  CommitteeAttendance @default(ABSENT)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamp(6)

  meeting     CommitteeMeeting    @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user        User                @relation("CommitteeMemberUser", fields: [userId], references: [id])
  votes       CommitteeVote[]

  @@unique([meetingId, userId])
  @@index([meetingId])
  @@map("committee_members")
}

model CommitteeAgendaItem {
  id             String               @id @default(uuid()) @db.Uuid
  meetingId      String               @map("meeting_id") @db.Uuid
  applicationId  String               @map("application_id") @db.Uuid
  displayOrder   Int                  @map("display_order")
  decisionType   AgendaItemDecisionType @default(APPROVE) @map("decision_type")
  presentedById  String?              @map("presented_by_id") @db.Uuid
  decisionResult AgendaItemDecisionType? @map("decision_result")
  decidedAt      DateTime?            @map("decided_at") @db.Timestamp(6)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamp(6)

  meeting        CommitteeMeeting     @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  application    CreditApplication    @relation(fields: [applicationId], references: [id])
  presentedBy    User?                @relation("AgendaItemPresentedBy", fields: [presentedById], references: [id])
  votes          CommitteeVote[]

  @@index([meetingId])
  @@index([applicationId])
  @@map("committee_agenda_items")
}

model CommitteeVote {
  id           String              @id @default(uuid()) @db.Uuid
  agendaItemId String              @map("agenda_item_id") @db.Uuid
  memberId     String              @map("member_id") @db.Uuid
  vote         CommitteeVoteChoice
  comments     String?             @db.Text
  votedAt      DateTime            @default(now()) @map("voted_at") @db.Timestamp(6)

  agendaItem   CommitteeAgendaItem @relation(fields: [agendaItemId], references: [id], onDelete: Cascade)
  member       CommitteeMember     @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([agendaItemId, memberId])
  @@index([agendaItemId])
  @@map("committee_votes")
}

