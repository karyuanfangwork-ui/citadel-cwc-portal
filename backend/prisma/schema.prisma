  periodType   String   @default("MONTHLY") @db.VarChar(20) // MONTHLY | QUARTERLY | ANNUALLY
  targetAmount Decimal  @default(0) @db.Decimal(15, 2)
  currency     String   @default("MYR") @db.VarChar(3)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(6)
