// Offboarding Requests
model OffboardingRequest {
  id        String @id @default(uuid()) @db.Uuid
  requestId String @unique @map("request_id") @db.Uuid

  // Departing Employee
  employeeFirstName String  @map("employee_first_name") @db.VarChar(100)
  employeeLastName  String  @map("employee_last_name") @db.VarChar(100)
  employeeEmail     String  @map("employee_email") @db.VarChar(255)
  employeeId        String? @map("employee_id") @db.Uuid

  // Position Details
  department         String?  @db.VarChar(100)
  managerId          String   @map("manager_id") @db.Uuid
  lastWorkingDay     DateTime @map("last_working_day") @db.Date
  reasonForDeparture String?  @map("reason_for_departure") @db.Text

  // Offboarding Status
  overallStatus String @map("overall_status") @db.VarChar(50)
  currentPhase  String @map("current_phase") @db.VarChar(50)

  // IT Revocation Flags
  accountsDisabled   Boolean @default(false) @map("accounts_disabled")
  emailRevoked       Boolean @default(false) @map("email_revoked")
  hardwareReturned   Boolean @default(false) @map("hardware_returned")
  accessBadgeRevoked Boolean @default(false) @map("access_badge_revoked")

  // HR Documentation Flags
  resignationLetterAttached  Boolean   @default(false) @map("resignation_letter_attached")
  resignationLetterUrl       String?   @map("resignation_letter_url") @db.VarChar(500)
  resignationLetterFileName  String?   @map("resignation_letter_file_name") @db.VarChar(255)
  exitInterviewScheduledDate DateTime? @map("exit_interview_scheduled_date") @db.Date
  exitInterviewDone          Boolean   @default(false) @map("exit_interview_done")
  finalPayrollDone           Boolean   @default(false) @map("final_payroll_done")
  benefitsTerminated         Boolean   @default(false) @map("benefits_terminated")
  knowledgeTransferDone      Boolean   @default(false) @map("knowledge_transfer_done")

  completedBy String?   @map("completed_by") @db.Uuid
  completedAt DateTime? @map("completed_at") @db.Timestamp(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  // Relations
  request         Request           @relation(fields: [requestId], references: [id], onDelete: Cascade)
  manager         User              @relation("OffboardingManager", fields: [managerId], references: [id])
  employee        User?             @relation("OffboardingEmployee", fields: [employeeId], references: [id])
  completedByUser User?             @relation("OffboardingCompletedBy", fields: [completedBy], references: [id])
  tasks           OffboardingTask[]

  @@index([requestId])
  @@index([employeeId])
  @@index([lastWorkingDay])
  @@map("offboarding_requests")
}

// Offboarding Tasks
model OffboardingTask {
  id            String @id @default(uuid()) @db.Uuid
