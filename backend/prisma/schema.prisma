  smeFinancialStatementType SmeFinancialStatementType? @map("sme_financial_statement_type")
  sicCode                   String?                    @map("sic_code") @db.VarChar(10)

  // Identity fields — self-contained, no CRM dependency
  registrationNumber           String? @map("registration_number") @db.VarChar(100)
  industry                     String? @db.VarChar(100)
  nricPassport                 String? @map("nric_passport") @db.VarChar(50)
  /// LOS-017 — Canonical forms used for duplicate matching. Maintained by
  /// borrowerProfile.service.ts on every create/update; never set by clients.
  registrationNumberNormalized String? @map("registration_number_normalized") @db.VarChar(64)
  nricPassportNormalized       String? @map("nric_passport_normalized") @db.VarChar(64)
  address                      String? @db.VarChar(500)
  phone                        String? @db.VarChar(50)
  email                        String? @db.VarChar(255)

  // Demographic fields
  gender      String? @db.VarChar(20)
  nationality String? @db.VarChar(100)

  // ── Borrower creation wizard — type-specific fields (Phase 1+2)
  // Date of birth — individual (self-contained, no CRM dependency)
  dateOfBirth              DateTime? @map("date_of_birth") @db.Date
  // Date of incorporation — SME/Corporate
  dateOfIncorporation      DateTime? @map("date_of_incorporation") @db.Date
  // Business nature / description — SME/Corporate
  businessNature           String?   @map("business_nature") @db.VarChar(500)
  // Business type — SME/Corporate (e.g. Sdn Bhd, Partnership, PLC)
  businessType             String?   @map("business_type") @db.VarChar(50)
  // Authorized representative — SME/Corporate
  authorizedRepresentative String?   @map("authorized_representative") @db.VarChar(255)
  // Individual demographic fields
  preferredName            String?   @map("preferred_name") @db.VarChar(100)
  maritalStatus            String?   @map("marital_status") @db.VarChar(30)
  educationLevel           String?   @map("education_level") @db.VarChar(50)
  // Tax identification number — both individual and corporate
  taxNumber                String?   @map("tax_number") @db.VarChar(50)
  // Contact preferences
  officePhone              String?   @map("office_phone") @db.VarChar(50)
  preferredContactMethod   String?   @map("preferred_contact_method") @db.VarChar(20)
  // Mailing address (separate from residential/registered address)
  mailingAddress           String?   @map("mailing_address") @db.VarChar(500)

  // §2.9 — Encrypted PII fields (AES-256-GCM)
  // These store the encrypted versions of annualIncome, netWorth, and sourceOfWealth.
  // The plaintext fields above are retained for backward compatibility during migration.
  annualIncomeEncrypted   String? @map("annual_income_encrypted") @db.VarChar(255)
  netWorthEncrypted       String? @map("net_worth_encrypted") @db.VarChar(255)
  sourceOfWealthEncrypted String? @map("source_of_wealth_encrypted") @db.VarChar(255)

  isActive  Boolean   @default(true) @map("is_active")
  deletedAt DateTime? @map("deleted_at") @db.Timestamp(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  // §3.1 — Multi-branch support
  branchId                   String?                      @map("branch_id") @db.Uuid
  branch                     Branch?                      @relation(fields: [branchId], references: [id])
  relationshipOwner          User?                        @relation("BorrowerRelationshipOwner", fields: [relationshipOwnerId], references: [id], onDelete: SetNull)
  duplicateExceptionsMatched BorrowerDuplicateException[]

  // Relations
  account              CrmAccount?               @relation(fields: [accountId], references: [id])
  contact              CrmContact?               @relation(fields: [contactId], references: [id])
  directors            Director[]
  shareholders         Shareholder[]
  beneficialOwners     UltimateBeneficialOwner[]
  applications         CreditApplication[]
  documents            CreditDocument[]
  relatedPartyMembers  RelatedPartyMember[]
  applicationParties   ApplicationParty[]
  guarantees           Guarantee[]
  financialStatements  FinancialStatement[]
  keyCounterparties    KeyCounterparty[]
  amlRescreenEvents    AmlRescreenEvent[]
  fatcaCrsDeclarations FatcaCrsDeclaration[]
  // §Borrower 360 — manual KYC verification marker
  kycVerifiedAt        DateTime?                 @map("kyc_verified_at") @db.Timestamp(6)
  creditProfile        BorrowerCreditProfile?
  income               BorrowerIncome?
  bureauReports        BorrowerBureauReport[]
  activities           BorrowerActivity[]
  riskRuns             BorrowerRiskRun[]

  @@index([accountId])
  @@index([contactId])
  @@index([borrowerType])
  @@index([creditRiskRating])
  @@index([amlRiskTier])
  @@index([branchId])
  @@index([segment])
  @@index([lifecycleStatus])
  @@index([relationshipOwnerId])
  @@index([segment, lifecycleStatus])
  @@index([registrationNumberNormalized])
  @@index([nricPassportNormalized])
  @@map("borrower_profiles")
}

