  decidedBy       User              @relation("CreditDecisionBy", fields: [decisionById], references: [id])
  
  @@index([applicationId])
  @@map("credit_decisions")
}

// ============================================================================
// Condition — precedent and subsequent
// ============================================================================
model Condition {
  id              String         @id @default(uuid()) @db.Uuid
  applicationId   String         @map("application_id") @db.Uuid
  
  conditionType   ConditionType  @map("condition_type")
