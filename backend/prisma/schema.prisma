}

// Application Party — borrower, guarantor, co-borrower, sponsor
// ============================================================================
model ApplicationParty {
  id                String @id @default(uuid()) @db.Uuid
  applicationId     String @map("application_id") @db.Uuid
  borrowerProfileId String @map("borrower_profile_id") @db.Uuid

  role         String   @db.VarChar(50) // borrower, guarantor, co_borrower, sponsor
