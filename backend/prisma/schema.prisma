// ============================================================================
// Credit Score Run — result of scoring an application with a scorecard version
// ============================================================================
model CreditScoreRun {
  id                   String      @id @default(uuid()) @db.Uuid
  applicationId        String      @map("application_id") @db.Uuid
  scorecardVersionId   String      @map("scorecard_version_id") @db.Uuid
  factorScores         Json
  totalScore           Decimal     @map("total_score") @db.Decimal(10, 2)
  riskRating           RiskRating  @map("risk_rating")
  isOverride           Boolean     @default(false) @map("is_override")
  overrideReason       String?     @map("override_reason") @db.Text
  overrideApprovedById String?     @map("override_approved_by_id") @db.Uuid
  overrideApprovedAt   DateTime?   @map("override_approved_at") @db.Timestamp(6)
  baseRiskRating       RiskRating? @map("base_risk_rating")
  bureauCapsApplied    Json?       @map("bureau_caps_applied")
  runAt                DateTime    @default(now()) @map("run_at") @db.Timestamp(6)

  // Audit / provenance fields (Phase 1 remediation)
  calculatedById    String? @map("calculated_by_id") @db.Uuid
  calculationSource String? @map("calculation_source") @db.VarChar(20) // AUTO | MANUAL | RESCORE | OVERRIDE
  inputSnapshot     Json?   @map("input_snapshot") // factorScores, dsr, bureau caps, etc.
  policyVersion     String? @map("policy_version") @db.VarChar(50)
  missingInputs     Json?   @map("missing_inputs") // list of factors with missing data + policy applied
  scoreRunWarnings  Json?   @map("score_run_warnings") // P2.1 — governance warnings (placeholder data, missing sources, etc.)
  ratingBandVersion Int?    @map("rating_band_version") // which RatingBandConfig version produced the rating

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  // Relations
  application        CreditApplication             @relation(fields: [applicationId], references: [id])
  scorecardVersion   CreditScorecardVersion        @relation(fields: [scorecardVersionId], references: [id])
  overrideApprovedBy User?                         @relation("ScoreRunOverrideApprovedBy", fields: [overrideApprovedById], references: [id])
  calculatedBy       User?                         @relation("CreditScoreRunCalculatedBy", fields: [calculatedById], references: [id])
  appliedOverride    ScoreOverrideApproval?        @relation("ScoreRunAppliedOverride")
  assessmentResults  ApplicationAssessmentResult[] @relation("AssessmentResultScoreRun")

  @@index([applicationId])
  @@index([scorecardVersionId])
  @@map("credit_score_runs")
}

// ============================================================================
