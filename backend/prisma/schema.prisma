  @@map("related_party_members")
}

// ============================================================================
// Credit Application
// ============================================================================
// ============================================================================
// Branch — multi-branch support (§3.1)
// ============================================================================
model Branch {
  id        String  @id @default(uuid()) @db.Uuid
  code      String  @unique @db.VarChar(20)
  name      String  @db.VarChar(255)
  region    String? @db.VarChar(100)
  isActive  Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  applications     CreditApplication[]
  borrowerProfiles BorrowerProfile[]
  approvalMatrices CreditApprovalMatrix[]
  slaOverrides     CreditSlaPolicyBranchOverride[]
  users            User[]

  @@map("branches")
}

model CreditSlaPolicyBranchOverride {
  id         String   @id @default(uuid()) @db.Uuid
  policyId   String   @map("policy_id") @db.Uuid
  branchId   String   @map("branch_id") @db.Uuid
  slaHours   Int      @map("sla_hours")
  isActive   Boolean  @default(true) @map("is_active")

  policy  CreditSlaPolicy @relation(fields: [policyId], references: [id])
  branch  Branch          @relation(fields: [branchId], references: [id])

  @@unique([policyId, branchId])
  @@map("credit_sla_policy_branch_overrides")
}

model CreditApplication {
  id              String           @id @default(uuid()) @db.Uuid
  applicationNo    String           @unique @map("application_no") @db.VarChar(50) // e.g. CA-2026-00001
  state           ApplicationState @default(DRAFT)
  
  // Borrower
  borrowerProfileId String          @map("borrower_profile_id") @db.Uuid

  // §3.1 — Multi-branch support
  branchId        String?          @map("branch_id") @db.Uuid
  branch          Branch?          @relation(fields: [branchId], references: [id])

  // Product
  productType     CreditProductType @map("product_type")
  purpose         String?           @db.Text
  requestedAmount Decimal           @map("requested_amount") @db.Decimal(15, 2)
  requestedTenor  Int?              @map("requested_tenor") // months
  currency        CurrencyCode      @default(MYR)
  
  // P2-2: Processing lane — determined by borrowerType × requestedAmount × annualTurnover
  lane            ProcessingLane    @default(CORPORATE) @map("lane")
  
  // Assignment
  assignedRmId    String?           @map("assigned_rm_id") @db.Uuid
  assignedAnalystId String?        @map("assigned_analyst_id") @db.Uuid
  
  // Timestamps
  submittedAt     DateTime?        @map("submitted_at") @db.Timestamp(6)
  decisionedAt    DateTime?        @map("decisioned_at") @db.Timestamp(6)
  closedAt        DateTime?        @map("closed_at") @db.Timestamp(6)
  
  // Rejection/withdrawal
  rejectionReason String?          @map("rejection_reason") @db.Text
  rejectionReasonCode RejectionReasonCode? @map("rejection_reason_code")
  withdrawalReason String?         @map("withdrawal_reason") @db.Text
  parentApplicationId String?      @map("parent_application_id") @db.Uuid
  parentApplication   CreditApplication? @relation("ApplicationCloneSource", fields: [parentApplicationId], references: [id])
  clonedApplications  CreditApplication[] @relation("ApplicationCloneSource")
  
  // CA Memo Phase 1 — Section 1 (Header)
  customerGroupName        String?               @map("customer_group_name") @db.VarChar(255)
  cifNo                    String?               @map("cif_no") @db.VarChar(50)
  applicationType          ApplicationType?      @map("application_type")
  originatingDepartment    String?               @map("originating_department") @db.VarChar(150)
  teamLeadName             String?               @map("team_lead_name") @db.VarChar(150)
  referredBy               String?               @map("referred_by") @db.VarChar(255)
  accountClassification    AccountClassification? @map("account_classification")
  connectedPartyFlag       Boolean               @default(false) @map("connected_party_flag")
  connectedPartyStaffName  String?               @map("connected_party_staff_name") @db.VarChar(255)
  completeDocsDate         DateTime?             @map("complete_docs_date") @db.Date
  lastReviewDate           DateTime?             @map("last_review_date") @db.Date
  nextReviewDate           DateTime?             @map("next_review_date") @db.Date
  relationshipSince        DateTime?             @map("relationship_since") @db.Date
  lastSiteVisitDate        DateTime?             @map("last_site_visit_date") @db.Date

  // CA Memo Phase 1 — Section 2 / 4 / 6 narratives
  preambleText             String?               @map("preamble_text") @db.Text
  mattersToHighlight       String?               @map("matters_to_highlight") @db.Text
  transactionDetailsText   String?               @map("transaction_details_text") @db.Text

  // CA Memo Phase 1 — Section 9 hook (populated in Phase 4)
  accountStrategy          AccountStrategy?      @map("account_strategy")
  crossSellingInitiatives  String?               @map("cross_selling_initiatives") @db.Text

  // CA Memo Phase 3 — Section 7 Way Out narratives
  firstWayOut   String? @map("first_way_out") @db.Text
  secondWayOut  String? @map("second_way_out") @db.Text
  otherWayOut   String? @map("other_way_out") @db.Text

  // CA Memo Phase 5 — Section 19 sign-off timestamps
  preparedAt  DateTime? @map("prepared_at") @db.Timestamp(6)
  reviewedAt  DateTime? @map("reviewed_at") @db.Timestamp(6)
  concurredAt DateTime? @map("concurred_at") @db.Timestamp(6)

  // §2.3 — Optimistic concurrency control
  version         Int              @default(1) @map("version")

  // Internal
  deletedAt       DateTime?        @map("deleted_at") @db.Timestamp(6)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamp(6)

  // Relations
  borrowerProfile  BorrowerProfile     @relation(fields: [borrowerProfileId], references: [id])
  assignedRm       User?               @relation("CreditApplicationRm", fields: [assignedRmId], references: [id])
  assignedAnalyst  User?               @relation("CreditApplicationAnalyst", fields: [assignedAnalystId], references: [id])
  facilities           ApplicationFacility[]
  requestItems         RequestItem[]
  exposureSummary      ExposureSummary?
  externalRatings      ExternalRating[]
  eclSnapshots         EclSnapshot[]
  eclForecasts         EclForecast[]
  cashflowProjection   CashflowProjection?
  sensitivityScenarios SensitivityScenario[]
  parties              ApplicationParty[]
  documents        CreditDocument[]
  documentRequirements DocumentRequirement[]
  auditEvents      CreditAuditEvent[]
  slaBreaches      CreditSlaBreach[]
  conditions       Condition[]
  decisions        CreditDecision[]
  scoreRuns        CreditScoreRun[]
  committeeAgendaItems CommitteeAgendaItem[]
  health          FacilityHealth?
  covenants       CovenantDefinition[]
  payments        PaymentEvent[]
  warningSignals          EarlyWarningSignal[]
  accountProfitability    AccountProfitability?
  walletShares            WalletShare[]
  accountUtilisationSnapshots AccountUtilisationSnapshot[]
  bureauChecks            CreditBureauCheck[]
  industryAssessment      IndustryAssessment?
  riskAssessments         RiskAssessment[]
  rmdIssues               RmdIssue[]
  esgAssessment           EsgAssessment?
  sicrAssessments         SicrAssessment[]
  signoffs                ApplicationSignoff[]
  scoreOverrides          ScoreOverrideApproval[]
  qualitativeAssessment   QualitativeAssessment?
  retailIncome            RetailIncome?
  bureauChecklist         BureauChecklist?
  disbursementOrder       DisbursementOrder?
  // §2.3 — LOO (Letter of Offer) fields
  looGeneratedAt   DateTime? @map("loo_generated_at") @db.Timestamp(6)
  looExpiryDate    DateTime? @map("loo_expiry_date") @db.Date
  looGeneratedById String?   @map("loo_generated_by_id") @db.Uuid
  looVersion       Int       @default(1) @map("loo_version")
  looGeneratedBy   User?     @relation("CreditApplicationLooGeneratedBy", fields: [looGeneratedById], references: [id])
  amlRescreenEvents AmlRescreenEvent[]
  collateralApplicationLinks CollateralApplicationLink[]
  deviations              DeviationApproval[]
  suspiciousTransactions  SuspiciousTransaction[]   // P1-7

  @@index([borrowerProfileId])
  @@index([state])
  @@index([assignedRmId])
  @@index([productType])
  @@index([submittedAt])
  @@index([branchId])
  @@map("credit_applications")
}

// ============================================================================
// Application Facility — the credit facility being requested
// ============================================================================
model ApplicationFacility {
  id              String       @id @default(uuid()) @db.Uuid
  applicationId    String       @map("application_id") @db.Uuid
  facilityType    FacilityType @map("facility_type")
  amount          Decimal      @db.Decimal(15, 2)
  tenorMonths     Int?         @map("tenor_months")
  ratePct         Decimal?     @map("rate_pct") @db.Decimal(5, 4)
  purpose         String?      @db.Text
  
  approvedAmount  Decimal?     @map("approved_amount") @db.Decimal(15, 2)
  approvedTenor    Int?         @map("approved_tenor")
  approvedRate    Decimal?     @map("approved_rate") @db.Decimal(5, 4)

  // CA Memo Phase 2 — Section 3 limit tracking
  pricingLabel       String?  @map("pricing_label") @db.VarChar(100)
  existingLimit      Decimal? @map("existing_limit") @db.Decimal(15, 2)
  proposedChange     Decimal? @map("proposed_change") @db.Decimal(15, 2)
  newLimit           Decimal? @map("new_limit") @db.Decimal(15, 2)
  outstandingBalance Decimal? @map("outstanding_balance") @db.Decimal(15, 2)
  undisbursedLimit   Decimal? @map("undisbursed_limit") @db.Decimal(15, 2)
  approvingLevel     String?  @map("approving_level") @db.VarChar(100)
  requestItemId      String?  @map("request_item_id") @db.Uuid

  // P2-3: SME-specific lane configuration (simplified benchmarks, overrides)
  smeLaneConfig      Json?    @map("sme_lane_config")

  deletedAt       DateTime?    @map("deleted_at") @db.Timestamp(6)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamp(6)

  application CreditApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  requestItem RequestItem?       @relation(fields: [requestItemId], references: [id])
  pricingWorksheet PricingWorksheet?
  collaterals Collateral[]
  guarantees  Guarantee[]

  @@index([applicationId])
  @@map("application_facilities")
}

// ============================================================================
// §2.1 — Pricing Worksheet (Loan Pricing Engine)
// ============================================================================

enum BaseRateType {
  BLR
  OPR
  FIXED
  SORA
  KLIBOR
}

model PricingWorksheet {
  id                   String       @id @default(uuid()) @db.Uuid
  facilityId           String       @unique @map("facility_id") @db.Uuid
  baseRateType         BaseRateType @default(FIXED) @map("base_rate_type")
  baseRatePct          Decimal      @map("base_rate_pct") @db.Decimal(6, 4)
  creditSpreadPct      Decimal      @map("credit_spread_pct") @db.Decimal(6, 4)
  riskPremiumPct       Decimal      @map("risk_premium_pct") @db.Decimal(6, 4)
  administrationFeePct Decimal?     @map("administration_fee_pct") @db.Decimal(6, 4)
  processingFeeFlat    Decimal?     @map("processing_fee_flat") @db.Decimal(15, 2)
  effectiveRatePct     Decimal      @map("effective_rate_pct") @db.Decimal(6, 4)
  effectiveYieldPct    Decimal?     @map("effective_yield_pct") @db.Decimal(6, 4)
  pricingJustification String?      @map("pricing_justification") @db.Text
  preparedById         String       @map("prepared_by_id") @db.Uuid
  preparedAt           DateTime     @default(now()) @map("prepared_at") @db.Timestamp(6)
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt            DateTime     @updatedAt @map("updated_at") @db.Timestamp(6)

  facility    ApplicationFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  preparedBy  User                @relation("PricingWorksheetPreparedBy", fields: [preparedById], references: [id])

  @@index([facilityId])
  @@map("pricing_worksheets")
}

// ============================================================================
// CA Memo Phase 2 — Request Items (Requests 1–4 in Section 3)
// ============================================================================
model RequestItem {
  id             String      @id @default(uuid()) @db.Uuid
  applicationId  String      @map("application_id") @db.Uuid
  requestType    CaRequestType @map("request_type")
  sortOrder      Int         @default(1) @map("sort_order")
  approvingLevel String?     @map("approving_level") @db.VarChar(100)
  rationale      String?     @db.Text

  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamp(6)

  application    CreditApplication    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  facilities     ApplicationFacility[]

  @@index([applicationId])
  @@map("request_items")
}

// ============================================================================
// CA Memo Phase 2 — Exposure Summary (Section 3b)
// ============================================================================
model ExposureSummary {
  id            String  @id @default(uuid()) @db.Uuid
  applicationId String  @unique @map("application_id") @db.Uuid

  thisAppSecured           Decimal? @map("this_app_secured") @db.Decimal(15, 2)
  thisAppUnsecured         Decimal? @map("this_app_unsecured") @db.Decimal(15, 2)
  otherAppSecured          Decimal? @map("other_app_secured") @db.Decimal(15, 2)
  otherAppUnsecured        Decimal? @map("other_app_unsecured") @db.Decimal(15, 2)
  customerTotalSecured     Decimal? @map("customer_total_secured") @db.Decimal(15, 2)
  customerTotalUnsecured   Decimal? @map("customer_total_unsecured") @db.Decimal(15, 2)
  relatedCounterpartySecured   Decimal? @map("related_counterparty_secured") @db.Decimal(15, 2)
  relatedCounterpartyUnsecured Decimal? @map("related_counterparty_unsecured") @db.Decimal(15, 2)
  groupTotalSecured        Decimal? @map("group_total_secured") @db.Decimal(15, 2)
  groupTotalUnsecured      Decimal? @map("group_total_unsecured") @db.Decimal(15, 2)

  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  application   CreditApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("exposure_summaries")
}

// ============================================================================
// ============================================================================
// CA Memo Phase 3 — External Ratings (Section 5)
// ============================================================================
model ExternalRating {
  id            String       @id @default(uuid()) @db.Uuid
  applicationId String       @map("application_id") @db.Uuid
  subjectType   String       @map("subject_type") @db.VarChar(50)
  subjectName   String?      @map("subject_name") @db.VarChar(255)
  agency        RatingAgency
  rating        String       @db.VarChar(20)
  ratingDate    DateTime?    @map("rating_date") @db.Date
  outlook       String?      @db.VarChar(50)
  fiscalYear    Int?         @map("fiscal_year")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamp(6)
  application   CreditApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  @@index([applicationId])
  @@map("external_ratings")
}

// ============================================================================
// CA Memo Phase 3 — ECL Snapshot (Section 5)
// ============================================================================
model EclSnapshot {
  id                    String     @id @default(uuid()) @db.Uuid
  applicationId         String     @map("application_id") @db.Uuid
  subjectType           String     @map("subject_type") @db.VarChar(50)
