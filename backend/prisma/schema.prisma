// ============================================================================
// Credit Approval Matrix Version — snapshot of matrix rules for audit trail
// ============================================================================
model CreditApprovalMatrixVersion {
  id            String   @id @default(uuid()) @db.Uuid
  matrixId      String   @map("matrix_id") @db.Uuid
  
  version       Int
  snapshot      Json
  
  approvedById  String   @map("approved_by_id") @db.Uuid
  approvedAt    DateTime @map("approved_at") @db.Timestamp(6)
