  application     CreditApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  borrowerProfile BorrowerProfile   @relation(fields: [borrowerProfileId], references: [id])
  
  @@index([applicationId])
  @@index([borrowerProfileId])
  @@map("application_parties")
}

// ============================================================================
// Credit Document
// ============================================================================
model CreditDocument {
  id               String        @id @default(uuid()) @db.Uuid
  applicationId    String?        @map("application_id") @db.Uuid // null if standalone borrower doc
  borrowerProfileId String        @map("borrower_profile_id") @db.Uuid
  
  classification   DocumentClass
  fileName         String         @map("file_name") @db.VarChar(500)
  filePath         String         @map("file_path") @db.VarChar(1000)
  fileSize         Int?           @map("file_size")
  mimeType         String?        @map("mime_type") @db.VarChar(100)
  sha256Hash       String?        @map("sha256_hash") @db.VarChar(64)
  isAvClean        Boolean?       @map("is_av_clean") // null = not scanned yet
  
  uploadedById     String         @map("uploaded_by_id") @db.Uuid

  description      String?        @db.Text

  // Verification
  verificationStatus String?      @map("verification_status") @db.VarChar(30) // PENDING | VERIFIED | REJECTED
  verifiedById     String?        @map("verified_by_id") @db.Uuid
  verifiedAt       DateTime?      @map("verified_at") @db.Timestamp(6)
  rejectionReason  String?        @map("rejection_reason") @db.Text

  deletedAt        DateTime?      @map("deleted_at") @db.Timestamp(6)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamp(6)
  
  application      CreditApplication? @relation(fields: [applicationId], references: [id])
  borrowerProfile  BorrowerProfile     @relation(fields: [borrowerProfileId], references: [id])
  uploadedBy       User                @relation("CreditDocumentUpload", fields: [uploadedById], references: [id])
  verifiedBy       User?               @relation("CreditDocumentVerifier", fields: [verifiedById], references: [id])
  versions         CreditDocumentVersion[]
  bureauChecks     CreditBureauCheck[]
  
  @@index([applicationId])
  @@index([borrowerProfileId])
  @@index([classification])
  @@index([sha256Hash])
  @@index([deletedAt])
  @@map("credit_documents")
}

// ============================================================================
// Credit Document Version — tracks replacements
// ============================================================================
model CreditDocumentVersion {
  id             String   @id @default(uuid()) @db.Uuid
  documentId     String   @map("document_id") @db.Uuid
  
  version        Int      @default(1)
  filePath       String   @map("file_path") @db.VarChar(1000)
  fileName       String   @map("file_name") @db.VarChar(500)
  fileSize       Int?     @map("file_size")
  sha256Hash     String?  @map("sha256_hash") @db.VarChar(64)
  changeSummary  String?  @map("change_summary") @db.Text
  
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  
  document       CreditDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  
  @@index([documentId])
  @@map("credit_document_versions")
}

// ============================================================================
// Document Requirement — checklist per application type
// ============================================================================
model DocumentRequirement {
  id             String   @id @default(uuid()) @db.Uuid
  applicationId  String   @map("application_id") @db.Uuid
  
  documentClass  DocumentClass @map("document_class")
  label         String   @db.VarChar(255)
  isMandatory    Boolean  @default(true) @map("is_mandatory")
  isCollected    Boolean  @default(false) @map("is_collected")
  collectedDocId String?  @map("collected_doc_id") @db.Uuid
  
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(6)
