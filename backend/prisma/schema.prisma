// §1.6 — Score Override Approval — dual-approval for score overrides ≥ 2 notches
// ============================================================================
model ScoreOverrideApproval {
  id            String @id @default(uuid()) @db.Uuid
  applicationId String @map("application_id") @db.Uuid

  originalRating String @map("original_rating") @db.VarChar(20) // e.g. "BBB+"
  overrideRating String @map("override_rating") @db.VarChar(20) // e.g. "A-"
  notchDelta     Int    @map("notch_delta") // absolute delta (always ≥ 2)

  justification   String   @db.Text // RM's reason for override
  firstApproverId String   @map("first_approver_id") @db.Uuid // first credit:admin approver
  firstApprovedAt DateTime @map("first_approved_at") @db.Timestamp(6)

  secondApproverId String?   @map("second_approver_id") @db.Uuid // second credit:admin approver (null until approved)
  secondApprovedAt DateTime? @map("second_approved_at") @db.Timestamp(6)

  status ScoreOverrideStatus @default(PENDING_SECOND_APPROVAL)

  // Link to the score run this override was applied to (Phase 1 remediation)
  scoreRunId String? @unique @map("score_run_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  application     CreditApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  firstApprover   User              @relation("ScoreOverride_FirstApprover", fields: [firstApproverId], references: [id])
  secondApprover  User?             @relation("ScoreOverride_SecondApprover", fields: [secondApproverId], references: [id])
  appliedScoreRun CreditScoreRun?   @relation("ScoreRunAppliedOverride", fields: [scoreRunId], references: [id])

  @@index([applicationId])
  @@index([status])
  @@index([firstApproverId])
  @@index([secondApproverId])
  @@map("score_override_approvals")
}

enum ScoreOverrideStatus {
  PENDING_SECOND_APPROVAL
  APPROVED
  REJECTED
}

// ============================================================================
// CA Memo Phase 5 enums
