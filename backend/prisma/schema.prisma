  maxValue      Decimal         @map("max_value") @db.Decimal(15, 2)
  thresholdPct  Decimal         @map("threshold_pct") @db.Decimal(5, 2) @default(80) // % of maxValue that triggers soft warning
  isActive      Boolean         @default(true) @map("is_active")
  currency      String          @default("MYR") @db.VarChar(3)
  sector        String?         @db.VarChar(100)   // For SECTOR type — matches BorrowerProfile.industry
