// ============================================================================
// Credit Decision — approval/rejection record
// ============================================================================
model CreditDecision {
  id            String @id @default(uuid()) @db.Uuid
  applicationId String @map("application_id") @db.Uuid

  decisionType ApprovalDecisionType @map("decision_type")
  decisionById String               @map("decided_by_id") @db.Uuid
  decisionAt   DateTime             @default(now()) @map("decision_at") @db.Timestamp(6)

  authorityLevel String? @map("authority_level") @db.VarChar(50)
  conditions     String? @db.Text
  comments       String? @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  application      CreditApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  decidedBy        User              @relation("CreditDecisionBy", fields: [decisionById], references: [id])
  conditionRecords Condition[]       @relation("CreditDecisionConditions")

  @@index([applicationId])
  @@map("credit_decisions")
}

// ============================================================================
// Credit Recommendation — P2.3
// Analyst recommendation as a governed lifecycle object.
// DRAFT → SUBMITTED → ACKNOWLEDGED/SUPERSEDED.
// Submitted recommendations are immutable; a newer submitted recommendation
// supersedes the prior current recommendation.
// ============================================================================
model CreditRecommendation {
  id            String @id @default(uuid()) @db.Uuid
  applicationId String @map("application_id") @db.Uuid
  authorId      String @map("author_id") @db.Uuid

  // Lifecycle: DRAFT | SUBMITTED | ACKNOWLEDGED | SUPERSEDED
  status String @default("DRAFT") @db.VarChar(20)

  // Recommendation content
  recommendationType     String   @map("recommendation_type") @db.VarChar(20) // APPROVE | CONDITIONAL | REJECT
  recommendedAmount      Decimal? @map("recommended_amount") @db.Decimal(15, 2)
  recommendedTenorMonths Int?     @map("recommended_tenor_months")
  pricingTerms           Json?    @map("pricing_terms")
  conditions             String?  @db.Text
  rationale              String?  @db.Text

  // Governance
  submittedAt    DateTime? @map("submitted_at") @db.Timestamp(6)
  supersededAt   DateTime? @map("superseded_at") @db.Timestamp(6)
  supersededById String?   @map("superseded_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  // Relations
  application               CreditApplication      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  author                    User                   @relation("CreditRecommendationAuthor", fields: [authorId], references: [id])
  supersededBy              CreditRecommendation?  @relation("RecommendationSuccession", fields: [supersededById], references: [id])
  supersededRecommendations CreditRecommendation[] @relation("RecommendationSuccession")

  @@index([applicationId])
  @@index([applicationId, status])
  @@index([authorId])
  @@map("credit_recommendations")
}

// ============================================================================
// Condition — precedent and subsequent
// ============================================================================
model Condition {
  id            String @id @default(uuid()) @db.Uuid
  applicationId String @map("application_id") @db.Uuid

  title         String            @db.VarChar(255)
  description   String?           @db.Text
  category      ConditionCategory @default(PRE_DISBURSEMENT) @map("category")
  conditionType ConditionType     @default(PRECEDENT) @map("condition_type")
  status        ConditionStatus   @default(PENDING) @map("status")
  dueDate       DateTime?         @map("due_date") @db.Date

  // Completion fields
  isFulfilled     Boolean   @default(false) @map("is_fulfilled")
  fulfilledAt     DateTime? @map("fulfilled_at") @db.Timestamp(6)
  fulfilledById   String?   @map("fulfilled_by_id") @db.Uuid
  fulfilmentNotes String?   @map("fulfilment_notes") @db.Text

  // Waiver fields
  waiverReason String?   @map("waiver_reason") @db.Text
  waivedAt     DateTime? @map("waived_at") @db.Timestamp(6)
  waivedById   String?   @map("waived_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  // §2.5 — Link to approval decision that generated this condition
  decisionId String? @map("decision_id") @db.Uuid

  application         CreditApplication    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fulfilledBy         User?                @relation("ConditionFulfilledBy", fields: [fulfilledById], references: [id])
  waivedBy            User?                @relation("ConditionWaivedBy", fields: [waivedById], references: [id])
  decision            CreditDecision?      @relation("CreditDecisionConditions", fields: [decisionId], references: [id])
  earlyWarningSignals EarlyWarningSignal[] @relation("EwsCondition")

  @@index([applicationId])
  @@index([conditionType])
  @@index([status])
  @@map("conditions")
}

// ============================================================================
// Disbursement Order — controls the disbursement lifecycle
// ============================================================================
model DisbursementOrder {
  id                 String             @id @default(uuid()) @db.Uuid
  applicationId      String             @unique @map("application_id") @db.Uuid
  orderNo            String             @unique @map("order_no") @db.VarChar(30)
  requestedById      String             @map("requested_by_id") @db.Uuid
  requestedAt        DateTime           @default(now()) @map("requested_at") @db.Timestamp(6)
  approvedById       String?            @map("approved_by_id") @db.Uuid
  approvedAt         DateTime?          @map("approved_at") @db.Timestamp(6)
  disbursedById      String?            @map("disbursed_by_id") @db.Uuid
  disbursedAt        DateTime?          @map("disbursed_at") @db.Timestamp(6)
  status             DisbursementStatus @default(PENDING)
  totalAmount        Decimal            @map("total_amount") @db.Decimal(15, 2)
  currency           String             @default("MYR") @db.VarChar(3)
  disbursementMethod String?            @map("disbursement_method") @db.VarChar(100)
  beneficiaryBank    String?            @map("beneficiary_bank") @db.VarChar(255)
  beneficiaryAccount String?            @map("beneficiary_account") @db.VarChar(50)
  referenceNote      String?            @map("reference_note") @db.Text
  cancelledById      String?            @map("cancelled_by_id") @db.Uuid
  cancelledAt        DateTime?          @map("cancelled_at") @db.Timestamp(6)
  cancellationReason String?            @map("cancellation_reason") @db.Text
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamp(6)

  application CreditApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  requestedBy User              @relation("DisbursementRequestedBy", fields: [requestedById], references: [id])
  approvedBy  User?             @relation("DisbursementApprovedBy", fields: [approvedById], references: [id])
  disbursedBy User?             @relation("DisbursementDisbursedBy", fields: [disbursedById], references: [id])
  cancelledBy User?             @relation("DisbursementCancelledBy", fields: [cancelledById], references: [id])

  @@index([status])
  @@map("disbursement_orders")
}

// ============================================================================
// Credit Approval Matrix — defines authority levels by exposure & risk rating
// ============================================================================
model CreditApprovalMatrix {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @db.VarChar(255)
  description String? @db.Text

  minExposure Decimal    @map("min_exposure") @db.Decimal(15, 2)
  maxExposure Decimal    @map("max_exposure") @db.Decimal(15, 2)
  minRating   RiskRating @map("min_rating")
  maxRating   RiskRating @map("max_rating")

  authorityLevel        String @map("authority_level") @db.VarChar(50)
  requiredApproverCount Int    @default(1) @map("required_approver_count")

  // §3.1 — null = applies to all branches; set = branch-specific authority override
  branchId String? @map("branch_id") @db.Uuid
  branch   Branch? @relation(fields: [branchId], references: [id])

  isActive      Boolean   @default(true) @map("is_active")
  effectiveFrom DateTime  @map("effective_from") @db.Timestamp(6)
  effectiveTo   DateTime? @map("effective_to") @db.Timestamp(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  versions CreditApprovalMatrixVersion[]

  @@index([authorityLevel])
  @@index([isActive])
  @@index([effectiveFrom])
  @@index([branchId])
  @@map("credit_approval_matrices")
}

// ============================================================================
// Credit Approval Matrix Version — snapshot of matrix rules for audit trail
// ============================================================================
model CreditApprovalMatrixVersion {
  id       String @id @default(uuid()) @db.Uuid
  matrixId String @map("matrix_id") @db.Uuid

  version  Int
  snapshot Json

  approvedById String   @map("approved_by_id") @db.Uuid
  approvedAt   DateTime @map("approved_at") @db.Timestamp(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  matrix     CreditApprovalMatrix @relation(fields: [matrixId], references: [id], onDelete: Cascade)
  approvedBy User                 @relation("MatrixVersionApprovedBy", fields: [approvedById], references: [id])

  @@unique([matrixId, version])
  @@index([matrixId])
  @@map("credit_approval_matrix_versions")
}

// ============================================================================
// Financial Statement — a borrower's financial statement (BS, PL, or CF)
// ============================================================================
model FinancialStatement {
  id                String                 @id @default(uuid()) @db.Uuid
  borrowerProfileId String                 @map("borrower_profile_id") @db.Uuid
  period            FinancialPeriod
  fiscalYearEnd     DateTime               @map("fiscal_year_end") @db.Date
  statementType     FinancialStatementType @map("statement_type")
  currency          CurrencyCode           @default(MYR)
  enteredById       String                 @map("entered_by_id") @db.Uuid
  reviewedById      String?                @map("reviewed_by_id") @db.Uuid
  status            FinancialStatus        @default(DRAFT)

  // CA Memo Phase 3 — Section 12 audit + commentary
  auditorName                  String?  @map("auditor_name") @db.VarChar(255)
  isQualified                  Boolean? @map("is_qualified")
  qualificationNotes           String?  @map("qualification_notes") @db.Text
  isDraftAccounts              Boolean  @default(false) @map("is_draft_accounts")
  commentarySalesProfitability String?  @map("commentary_sales_profitability") @db.Text
  commentaryAssetMgmt          String?  @map("commentary_asset_mgmt") @db.Text
  commentaryDebtMgmt           String?  @map("commentary_debt_mgmt") @db.Text
  commentaryCashflow           String?  @map("commentary_cashflow") @db.Text
  commentaryConclusion         String?  @map("commentary_conclusion") @db.Text

  deletedAt DateTime? @map("deleted_at") @db.Timestamp(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  // Relations
  borrowerProfile BorrowerProfile     @relation(fields: [borrowerProfileId], references: [id], onDelete: Cascade)
  enteredBy       User                @relation("FinancialEnteredBy", fields: [enteredById], references: [id])
  reviewedBy      User?               @relation("FinancialReviewedBy", fields: [reviewedById], references: [id])
  lineItems       FinancialLineItem[]
  ratios          FinancialRatio[]

  @@index([borrowerProfileId])
  @@index([statementType])
  @@index([status])
  @@map("financial_statements")
}

// ============================================================================
// Financial Line Item — individual line items within a financial statement
// ============================================================================
model FinancialLineItem {
  id            String   @id @default(uuid()) @db.Uuid
  statementId   String   @map("statement_id") @db.Uuid
  lineKey       String   @map("line_key") @db.VarChar(100)
  lineLabel     String   @map("line_label") @db.VarChar(200)
  amount        Decimal  @db.Decimal(15, 2)
  parentLineKey String?  @map("parent_line_key") @db.VarChar(100)
  displayOrder  Int      @map("display_order")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  // Relations
  statement FinancialStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)

  @@unique([statementId, lineKey])
  @@index([statementId])
  @@index([lineKey])
  @@map("financial_line_items")
}

// ============================================================================
// Financial Ratio — computed ratios derived from financial statements
// ============================================================================
model FinancialRatio {
  id          String        @id @default(uuid()) @db.Uuid
  statementId String        @map("statement_id") @db.Uuid
  ratioKey    String        @map("ratio_key") @db.VarChar(100)
  ratioLabel  String        @map("ratio_label") @db.VarChar(200)
  value       Decimal       @db.Decimal(10, 4)
  category    RatioCategory
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamp(6)

  // Relations
  statement FinancialStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)

  @@unique([statementId, ratioKey])
  @@index([statementId])
  @@index([ratioKey])
  @@index([category])
  @@map("financial_ratios")
}

// ============================================================================
// SPRINT 3 — SCORECARD & SCORING
// ============================================================================

// ============================================================================
// Credit Scorecard — defines a scoring model with weighted factor groups
// ============================================================================
model CreditScorecard {
  id          String             @id @default(uuid()) @db.Uuid
  name        String             @unique @db.VarChar(200)
  description String?            @db.Text
  isActive    Boolean            @default(true) @map("is_active")
  productType CreditProductType? @map("product_type") // Phase 5 — product-specific scorecard selection

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  // Relations
  versions CreditScorecardVersion[]

  @@index([productType])
  @@map("credit_scorecards")
}

// ============================================================================
// Score Factor Definition — governed factor definitions for credit scoring (P2.1)
// Replaces hardcoded factor groups in scorecard.service.ts with database-driven
// definitions that support activation/deactivation, effective dates, and input
// source type tracking. Ensures no factor silently uses placeholder data.
// ============================================================================
model ScoreFactorDefinition {
  id                      String    @id @default(uuid()) @db.Uuid
  factorKey               String    @map("factor_key") @db.VarChar(50) // e.g. 'financial_performance' — not unique alone; uniqueness is on (factorKey, effectiveFrom) for effective-dated successors
  label                   String    @map("label") @db.VarChar(100) // e.g. 'Financial Performance'
  description             String?   @map("description") @db.Text // human-readable explanation
  inputSourceType         String    @map("input_source_type") @db.VarChar(20) // RATIO | QUALITATIVE | EXTERNAL
  applicableBorrowerTypes String    @default("INDIVIDUAL,SOLE_PROPRIETOR,CORPORATE") @map("applicable_borrower_types") @db.VarChar(200)
  isActive                Boolean   @default(true) @map("is_active")
  effectiveFrom           DateTime  @default(now()) @map("effective_from") @db.Timestamp(6)
  effectiveTo             DateTime? @map("effective_to") @db.Timestamp(6)
  sortOrder               Int       @default(0) @map("sort_order") // display order
  predecessorId           String?   @map("predecessor_id") @db.Uuid // P2.1 — links to the factor definition this one supersedes

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  predecessor ScoreFactorDefinition?  @relation("FactorSuccession", fields: [predecessorId], references: [id])
  successors  ScoreFactorDefinition[] @relation("FactorSuccession")

  @@unique([factorKey, effectiveFrom])
  @@index([factorKey])
  @@index([isActive, effectiveFrom, effectiveTo])
  @@map("score_factor_definitions")
}

// ============================================================================
// Rating Band Configuration — configurable score→rating bands (Phase 3)
// Multiple versions can coexist with effectiveFrom/effectiveTo ranges; the
// active set (effectiveTo IS NULL or >= now) drives mapTotalScoreToRiskRating.
// Falls back to the hardcoded thresholds when no active band exists.
// ============================================================================

// ============================================================================
// Credit Memo Version — immutable snapshot of CA memo content (P2.2)
// Every time a memo is generated, a versioned snapshot is saved.
// On committee submission, the latest version is locked and cannot be
// regenerated — the approval pack always references the locked version.
// ============================================================================
model CreditMemoVersion {
  id                 String    @id @default(uuid()) @db.Uuid
  applicationId      String    @map("application_id") @db.Uuid
  versionNumber      Int       @map("version_number")
  htmlContent        String    @map("html_content") @db.Text
  pdfUrl             String?   @map("pdf_url") @db.VarChar(500)
  isLocked           Boolean   @default(false) @map("is_locked")
  lockedAt           DateTime? @map("locked_at") @db.Timestamp(6)
  lockedById         String?   @map("locked_by_id") @db.Uuid
  lockedBy           User?     @relation("MemoLockedBy", fields: [lockedById], references: [id])
  generatedById      String?   @map("generated_by_id") @db.Uuid
  generatedBy        User?     @relation("MemoGeneratedBy", fields: [generatedById], references: [id])
  dataSnapshot       Json?     @map("data_snapshot") // serialized CaMemoData at generation time
  governanceWarnings Json?     @map("governance_warnings") // P2.1 warnings snapshot

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  application CreditApplication @relation(fields: [applicationId], references: [id])

  @@unique([applicationId, versionNumber])
  @@index([applicationId])
  @@index([isLocked])
  @@map("credit_memo_versions")
}

model RatingBandConfig {
  id           String     @id @default(uuid()) @db.Uuid
  scoreMin     Int        @map("score_min")
  scoreMax     Int        @map("score_max")
  rating       RiskRating
  riskCategory String     @map("risk_category") @db.VarChar(50)

  // P2.4 — Governance lifecycle: DRAFT → SUBMITTED → APPROVED → ACTIVE → SUPERSEDED
  status      String  @default("DRAFT") @db.VarChar(20)
  name        String? @db.VarChar(200)
  description String? @db.Text

  effectiveFrom DateTime  @default(now()) @map("effective_from") @db.Timestamp(6)
  effectiveTo   DateTime? @map("effective_to") @db.Timestamp(6)
  version       Int       @default(1)
  approvedById  String?   @map("approved_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  // Relations
  approvedBy User? @relation("RatingBandConfigApprovedBy", fields: [approvedById], references: [id])

  @@index([effectiveFrom, effectiveTo])
  @@index([rating])
  @@index([status])
  @@map("rating_band_configs")
}

// ============================================================================
// Credit Scorecard Version — snapshot of factor weights for audit trail
// ============================================================================
model CreditScorecardVersion {
  id                  String    @id @default(uuid()) @db.Uuid
  scorecardId         String    @map("scorecard_id") @db.Uuid
  version             Int
