  @@index([key])
  @@index([category])
  @@index([enabled])
  @@index([tenantId])
  @@map("feature_flags")
}

// ============================================================================
// CREDIT ASSESSMENT MODULE
// ============================================================================

// Counter for atomic application number generation (avoids race conditions)
model CreditAppCounter {
  id      Int    @id @default(1)
  prefix  String @unique @db.VarChar(10) // e.g. "CA"
  lastSeq Int    @default(0)

  @@map("credit_app_counters")
}

// Credit Application States
enum ApplicationState {
  DRAFT
  SUBMITTED
  KYC_REVIEW
  COMPLIANCE_HOLD
  KYC_APPROVED
  KYC_REJECTED
