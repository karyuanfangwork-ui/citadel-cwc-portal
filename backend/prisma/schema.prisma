// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "fullTextIndex"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// MULTI-TENANCY
// ============================================================================

model Tenant {
  id        String     @id @default(uuid()) @db.Uuid
  name      String     @db.VarChar(200)
  slug      String     @unique @db.VarChar(100)
  plan      TenantPlan @default(FREE)
  isActive  Boolean    @default(true) @map("is_active")
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamp(6)

  users               User[]
  departments         Department[] // P02-07: department-scoped RBAC
  platformAuditEvents PlatformAuditEvent[]

  @@map("tenants")
}

enum TenantPlan {
  FREE
  PRO
  ENTERPRISE
}

// Executive approval tiers for high-value requests
enum ExecutiveRole {
  CEO
  CTO
  CFO
  COO
  CHRO
  CMO
  GROUP_DCEO
}

enum AssetStatus {
  IN_STOCK
  ASSIGNED
  RESERVED
  PENDING_RETURN
  IN_REPAIR
  RETIRED
  LOST
  STOLEN
  DISPOSED
}

enum AssetCategory {
  LAPTOP
  DESKTOP
  MONITOR
  PERIPHERAL
  PHONE
  NETWORK
  PRINTER
  SOFTWARE_LICENSE
  OTHER
}

// ============================================================================
// USERS & AUTHENTICATION
// ============================================================================

model User {
  id                 String         @id @default(uuid()) @db.Uuid
  email              String         @unique @db.VarChar(255)
  tenantId           String?        @map("tenant_id") @db.Uuid
  passwordHash       String         @map("password_hash") @db.VarChar(255)
  firstName          String         @map("first_name") @db.VarChar(100)
  lastName           String         @map("last_name") @db.VarChar(100)
  phone              String?        @db.VarChar(20)
  avatarUrl          String?        @map("avatar_url") @db.Text
  department         String?        @db.VarChar(100)
  jobTitle           String?        @map("job_title") @db.VarChar(100)
  managerId          String?        @map("manager_id") @db.Uuid
  isActive           Boolean        @default(true) @map("is_active")
  agentTeam          String?        @map("agent_team") @db.VarChar(50)
  executiveRole      ExecutiveRole? @map("executive_role")
  entityId           String?        @map("entity_id") @db.Uuid
  // §3.1 — Multi-branch support: auto-scopes RM views to their branch
  branchId           String?        @map("branch_id") @db.Uuid
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamp(6)
  lastLoginAt        DateTime?      @map("last_login_at") @db.Timestamp(6)
  passwordChangedAt  DateTime?      @map("password_changed_at") @db.Timestamp(6)
  mustResetPassword  Boolean        @default(false) @map("must_reset_password") // P0-2: force password change on next login
  outOfOffice        Boolean        @default(false) @map("out_of_office")
  outOfOfficeUntil   DateTime?      @map("out_of_office_until") @db.Timestamp(6)
  outOfOfficeMessage String?        @map("out_of_office_message") @db.Text
  delegationEnabled  Boolean        @default(false) @map("delegation_enabled")
  delegatedToId      String?        @map("delegated_to_id") @db.Uuid

  // §2.1 — MFA/TOTP for privileged credit roles
  mfaEnabled     Boolean   @default(false) @map("mfa_enabled")
  mfaSecret      String?   @map("mfa_secret") @db.VarChar(255) // TOTP secret (encrypted)
  mfaBackupCodes String[]  @map("mfa_backup_codes") // Hashed backup codes
  mfaVerifiedAt  DateTime? @map("mfa_verified_at") @db.Timestamp(6) // Last TOTP verification timestamp
  mustEnrollMfa  Boolean   @default(false) @map("must_enroll_mfa") // P1-8: set when user gets credit:approve/disburse

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  // Delegation
  delegatedTo    User?  @relation("UserDelegate", fields: [delegatedToId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  delegatingFrom User[] @relation("UserDelegate")

  // Relations
  manager                              User?                         @relation("UserManager", fields: [managerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subordinates                         User[]                        @relation("UserManager")
  roles                                UserRole[]
  sessions                             Session[]
  passwordResetTokens                  PasswordResetToken[]
  createdRequests                      Request[]                     @relation("RequestRequester")
  assignedRequests                     Request[]                     @relation("RequestAssignee")
  activities                           RequestActivity[]
  attachments                          RequestAttachment[]
  kbArticles                           KnowledgeBaseArticle[]
  auditLogs                            AuditLog[]
  requestedBorrowerDuplicateExceptions BorrowerDuplicateException[]  @relation("DuplicateExceptionRequester")
  decidedBorrowerDuplicateExceptions   BorrowerDuplicateException[]  @relation("DuplicateExceptionDecider")
  notifications                        Notification[]
  itHardwareApprovals                  ITHardwareRequest[]           @relation("HardwareManagerApproval")
  requestApprovals                     RequestApproval[]
  catalogItemsOwned                    RequestType[]                 @relation("CatalogItemOwner") // P5-01
  delegatedApprovalsFrom               RequestApproval[]             @relation("ApprovalDelegator") // P5-08
  delegatedApprovalsTo                 RequestApproval[]             @relation("ApprovalDelegate") // P5-08
  delegationsFrom                      ApprovalDelegation[]          @relation("DelegationFrom") // P5-08
  delegationsTo                        ApprovalDelegation[]          @relation("DelegationTo") // P5-08
  departmentMemberships                DepartmentMembership[] // P02-07: department-scoped RBAC
  approvalReminders                    ApprovalReminder[] // P5-08
  uploadedResumes                      CandidateResume[]
  scheduledInterviews                  InterviewSchedule[]
  submittedFeedbacks                   InterviewFeedback[]
  completedScreenings                  HRScreening[]
  uploadedLOAs                         LetterOfAcceptance[]          @relation("LOAUploadedBy")
  approvedLOAs                         LetterOfAcceptance[]          @relation("LOAApprovedBy")
  // Offboarding Relations
  offboardingAsEmployee                OffboardingRequest[]          @relation("OffboardingEmployee")
  offboardingAsManager                 OffboardingRequest[]          @relation("OffboardingManager")
  offboardingCompletedBy               OffboardingRequest[]          @relation("OffboardingCompletedBy")
  offboardingTasksAssigned             OffboardingTask[]             @relation("OffboardingTaskAssignedTo")
  offboardingTasksCompleted            OffboardingTask[]             @relation("OffboardingTaskCompletedBy")
  // Onboarding Relations
  onboardingAsHiringManager            OnboardingRequest[]           @relation("OnboardingHiringManager")
  onboardingAsNewHire                  OnboardingRequest[]           @relation("OnboardingNewHire")
  onboardingAsBuddy                    OnboardingRequest[]           @relation("OnboardingBuddy")
  onboardingCompletedBy                OnboardingRequest[]           @relation("OnboardingCompletedBy")
  onboardingTasksAssigned              OnboardingTask[]              @relation("OnboardingTaskAssignedTo")
  onboardingTasksCompleted             OnboardingTask[]              @relation("OnboardingTaskCompletedBy")
  // Entity Relations
  entity                               Entity?                       @relation("UserEntity", fields: [entityId], references: [id])
  approverForEntities                  Entity[]                      @relation("EntityApprover")
  // §3.1 — Multi-branch support
  branch                               Branch?                       @relation(fields: [branchId], references: [id])
  // Asset Relations
  createdAssets                        Asset[]                       @relation("AssetCreatedBy")
  assetAssignments                     AssetAssignment[]             @relation("AssetAssignmentUser")
  assetAssignedBy                      AssetAssignment[]             @relation("AssetAssignmentAssignedBy")
  // CRM Relations
  crmOwnedAccounts                     CrmAccount[]                  @relation("CrmAccountOwner")
  crmOwnedLeads                        CrmLead[]                     @relation("CrmLeadOwner")
  crmLeadDocuments                     CrmLeadDocument[]             @relation("CrmLeadDocumentUploader")
  crmOwnedOpportunities                CrmOpportunity[]              @relation("CrmOpportunityOwner")
  crmActivities                        CrmActivity[]                 @relation("CrmActivityUser")
  crmNotes                             CrmNote[]                     @relation("CrmNoteAuthor")
  crmTrustProducts                     CrmTrustProduct[]             @relation("CrmTrustProductOwner")
  crmKycApprovals                      CrmKycRecord[]                @relation("CrmKycApprovedBy")
  crmImportJobs                        CrmImportJob[]                @relation("CrmImportJobUser")
  crmExportJobs                        CrmExportJob[]                @relation("CrmExportJobUser")
  createdTerritories                   CrmTerritory[]                @relation("CrmTerritoryCreator")
  territoryMemberships                 CrmTerritoryMember[]          @relation("CrmTerritoryMemberUser")
  crmQuotas                            CrmQuota[]                    @relation("CrmQuotaUser")
  crmDashboardLayouts                  CrmDashboardLayout[]          @relation("UserCrmDashboardLayout")
  crmWorkflows                         CrmWorkflow[]                 @relation("CrmWorkflowCreator")
  crmDuplicateResolutions              CrmDuplicateMatch[]           @relation("CrmDuplicateResolver")
  // Announcement Relations
  announcements                        Announcement[]                @relation("AnnouncementAuthor")
  announcementReads                    AnnouncementRead[]            @relation("AnnouncementReader")
  participatingIn                      RequestParticipant[]          @relation("RequestParticipants")
  participantsAdded                    RequestParticipant[]          @relation("ParticipantAddedBy")
  // Credit Relations
  creditApplicationRm                  CreditApplication[]           @relation("CreditApplicationRm")
  creditApplicationAnalyst             CreditApplication[]           @relation("CreditApplicationAnalyst")
  borrowerRelationships                BorrowerProfile[]             @relation("BorrowerRelationshipOwner")
  creditDocumentUploads                CreditDocument[]              @relation("CreditDocumentUpload")
  creditDocumentVerifications          CreditDocument[]              @relation("CreditDocumentVerifier")
  borrowerBureauReportsUploaded        BorrowerBureauReport[]        @relation("BorrowerBureauReportUploadedBy")
  creditDecisions                      CreditDecision[]              @relation("CreditDecisionBy")
  creditRecommendations                CreditRecommendation[]        @relation("CreditRecommendationAuthor")
  bureauChecksRun                      CreditBureauCheck[]           @relation("BureauCheckRunBy")
  applicationSignoffs                  ApplicationSignoff[]          @relation("ApplicationSignoffBy")
  matrixVersionApprovals               CreditApprovalMatrixVersion[] @relation("MatrixVersionApprovedBy")
  financialEnteredBy                   FinancialStatement[]          @relation("FinancialEnteredBy")
  financialReviewedBy                  FinancialStatement[]          @relation("FinancialReviewedBy")
  scorecardVersionApprovedBy           CreditScorecardVersion[]      @relation("ScorecardVersionApprovedBy")
  scoreRunOverrideApprovedBy           CreditScoreRun[]              @relation("ScoreRunOverrideApprovedBy")
  scoreRunsCalculated                  CreditScoreRun[]              @relation("CreditScoreRunCalculatedBy")
  ratingBandConfigsApproved            RatingBandConfig[]            @relation("RatingBandConfigApprovedBy")
  assessmentResultsCreated             ApplicationAssessmentResult[] @relation("AssessmentResultCreatedBy")
  assessmentResultsReviewed            ApplicationAssessmentResult[] @relation("AssessmentResultReviewedBy")
  // Committee Relations
  committeeMemberUser                  CommitteeMember[]             @relation("CommitteeMemberUser")
  committeePresentedBy                 CommitteeAgendaItem[]         @relation("AgendaItemPresentedBy")
  // Monitoring Relations
  facilityHealthUpdates                FacilityHealth[]
  covenantTests                        CovenantTest[]
  resolvedSignals                      EarlyWarningSignal[]
  // PII Read Log Relations
  piiReadLogs                          PiiReadLog[]
  // §1.5 Export audit & §1.6 Score override
  creditExportEvents                   CreditExportEvent[]
  scoreOverrideFirst                   ScoreOverrideApproval[]       @relation("ScoreOverride_FirstApprover")
  scoreOverrideSecond                  ScoreOverrideApproval[]       @relation("ScoreOverride_SecondApprover")
  // Condition Relations
  conditionsFulfilled                  Condition[]                   @relation("ConditionFulfilledBy")
  conditionsWaived                     Condition[]                   @relation("ConditionWaivedBy")
  qualitativeAssessments               QualitativeAssessment[]
  bureauChecklists                     BureauChecklist[]             @relation("BureauChecklistTickedBy")
  bureauChecklistsVerified             BureauChecklist[]             @relation("BureauChecklistVerifiedBy")
  disbursementRequested                DisbursementOrder[]           @relation("DisbursementRequestedBy")
  disbursementApproved                 DisbursementOrder[]           @relation("DisbursementApprovedBy")
  disbursementDisbursed                DisbursementOrder[]           @relation("DisbursementDisbursedBy")
  disbursementCancelled                DisbursementOrder[]           @relation("DisbursementCancelledBy")
  // Pricing Worksheet
  pricingWorksheets                    PricingWorksheet[]            @relation("PricingWorksheetPreparedBy")
  // LOO Generation
  looGeneratedApplications             CreditApplication[]           @relation("CreditApplicationLooGeneratedBy")
  // §2.8 — AML Rescreen
  amlRescreenTriggeredEvents           AmlRescreenEvent[]            @relation("AmlRescreenTriggeredBy")
  amlRescreenReviewedEvents            AmlRescreenEvent[]            @relation("AmlRescreenReviewedBy")
  // §3.4 — FATCA/CRS Declarations
  fatcaCrsSelfCertified                FatcaCrsDeclaration[]         @relation("FatcaSelfCertifiedBy")
  fatcaCrsVerified                     FatcaCrsDeclaration[]         @relation("FatcaVerifiedBy")
  // §6.2 — Credit Policy Limits
  createdPolicyLimits                  CreditPolicyLimit[]           @relation("PolicyLimitCreatedBy")
  // P1-6 — Deviation approvals (created/approved/rejected by)
  createdDeviations                    DeviationApproval[]           @relation("DeviationCreatedBy")
  approvedDeviations                   DeviationApproval[]           @relation("DeviationApprovedBy")
  rejectedDeviations                   DeviationApproval[]           @relation("DeviationRejectedBy")
  // P1-2 — PDPA consent records
  grantedConsents                      ConsentRecord[]               @relation("ConsentGrantedBy")
  withdrawnConsents                    ConsentRecord[]               @relation("ConsentWithdrawnBy")
  // P1-7 — STR Register
  strAssignedTo                        SuspiciousTransaction[]       @relation("StrAssignedTo")
  strReviewed                          SuspiciousTransaction[]       @relation("StrReviewedBy")
  strAttachmentsUploaded               StrAttachment[]               @relation("StrUploadedBy")
  // §F23 — FX Rate entries
  createdFxRates                       CreditFxRate[]                @relation("FxRateCreatedBy")
  // §7.1 — Collateral Cross-Linking
  softDeletedCollaterals               Collateral[]                  @relation("CollateralSoftDeletedBy")
  linkedCollateral                     CollateralApplicationLink[]   @relation("CollateralLinkedBy")
  // AI Governance Relations
  aiInteractions                       AiInteraction[]               @relation("AiInteractionUser")
  aiOverrides                          AiOverride[]                  @relation("AiOverrideUser")
  // P2-4 — Application Comments
  applicationComments                  ApplicationComment[]          @relation("CommentAuthor")
  // P2.2 — Credit Memo Versions
  memoVersionsLocked                   CreditMemoVersion[]           @relation("MemoLockedBy")
  memoVersionsGenerated                CreditMemoVersion[]           @relation("MemoGeneratedBy")
  NotificationDelivery                 NotificationDelivery[]
  publishedWorkflowVersions            WorkflowVersion[]             @relation("WorkflowVersionPublisher")
  fixedAssigneeServiceDesks            ServiceDesk[]                 @relation("ServiceDeskFixedAssignee")

  @@index([tenantId])
  @@index([tenantId, agentTeam]) // P2-08: composite for role-based queries
  @@index([email])
  @@index([managerId])
  @@index([entityId])
  @@index([delegatedToId])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(50)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  // Relations
  users                 UserRole[]
  permissions           RolePermission[]
  departmentMemberships DepartmentMembership[] // P02-07: department-scoped RBAC

  @@map("roles")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamp(6)

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique @db.VarChar(100)
  resource    String  @db.VarChar(50)
  action      String  @db.VarChar(50)
  description String? @db.Text

  // Relations
  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  // Relations
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ── P02 Task 7: Department-scoped RBAC ───────────────────────────────
// Findings #1–#2, #5, #29–#30, #39–#40

model Department {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  code        String   @db.VarChar(50)
  name        String   @db.VarChar(200)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  // Relations
  tenant              Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships         DepartmentMembership[]
  serviceDesks        ServiceDesk[]
  requests            Request[]
  attachments         RequestAttachment[]
  platformAuditEvents PlatformAuditEvent[]

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@index([tenantId, isActive])
  @@map("departments")
}

model DepartmentMembership {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  departmentId String    @map("department_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  roleId       String    @map("role_id") @db.Uuid
  validFrom    DateTime  @default(now()) @map("valid_from") @db.Timestamp(6)
  validUntil   DateTime? @map("valid_until") @db.Timestamp(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  // Relations
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([tenantId, departmentId, userId, roleId])
  @@index([tenantId, userId])
  @@index([tenantId, departmentId])
  @@map("department_memberships")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique @db.VarChar(500)
  ipAddress String?  @map("ip_address") @db.Inet
  userAgent String?  @map("user_agent") @db.Text
  expiresAt DateTime @map("expires_at") @db.Timestamp(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamp(6)
  usedAt    DateTime? @map("used_at") @db.Timestamp(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId])
  @@map("password_reset_tokens")
}

// ============================================================================
// SERVICE DESKS & REQUEST MANAGEMENT
// ============================================================================

model ServiceDesk {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String?  @map("tenant_id") @db.Uuid
  departmentId String?  @map("department_id") @db.Uuid
  name         String   @db.VarChar(100) // P2-09: removed @unique, replaced with @@unique([tenantId, name])
  code         String   @db.VarChar(20) // P2-09: removed @unique, replaced with @@unique([tenantId, code])
  description  String?  @db.Text
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  // Auto-assignment config
  autoAssignTeam     String  @default("NONE") @map("auto_assign_team") @db.VarChar(50)
  assignmentStrategy String  @default("ROUND_ROBIN") @map("assignment_strategy") @db.VarChar(20)
  lastAssignedIndex  Int     @default(0) @map("last_assigned_index")
  autoAssignUserId   String? @map("auto_assign_user_id") @db.Uuid

  // Relations
  autoAssignUser User?                  @relation("ServiceDeskFixedAssignee", fields: [autoAssignUserId], references: [id], onDelete: SetNull)
  department     Department?            @relation(fields: [tenantId, departmentId], references: [tenantId, id], onDelete: Restrict)
  categories     ServiceCategory[]
  requests       Request[]
  kbArticles     KnowledgeBaseArticle[]

  @@unique([tenantId, name]) // P2-09: tenant-local unique
  @@unique([tenantId, code]) // P2-09: tenant-local unique
  @@index([tenantId])
  @@index([departmentId])
  @@map("service_desks")
}

model ServiceCategory {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String?  @map("tenant_id") @db.Uuid
  serviceDeskId String   @map("service_desk_id") @db.Uuid
  name          String   @db.VarChar(100)
  description   String?  @db.Text
  icon          String?  @db.VarChar(50)
  colorClass    String?  @map("color_class") @db.VarChar(50)
  displayOrder  Int      @default(0) @map("display_order")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  // Relations
  serviceDesk  ServiceDesk   @relation(fields: [serviceDeskId], references: [id], onDelete: Cascade)
  requestTypes RequestType[]

  @@unique([serviceDeskId, name])
  @@index([serviceDeskId])
  @@index([tenantId])
  @@map("service_categories")
}

model RequestType {
  id                String                 @id @default(uuid()) @db.Uuid
  tenantId          String?                @map("tenant_id") @db.Uuid
  serviceCategoryId String                 @map("service_category_id") @db.Uuid
  code              String?                @db.VarChar(100) // P2-09: removed @unique, replaced with @@unique([tenantId, code])
  name              String                 @db.VarChar(150)
  description       String?                @db.Text
  icon              String?                @db.VarChar(50)
  requiresApproval  Boolean                @default(false) @map("requires_approval")
  slaHours          Int?                   @map("sla_hours")
  isActive          Boolean                @default(true) @map("is_active")
  formConfig        Json?                  @map("form_config") @db.JsonB
  // P5-04: Version counter, incremented each time formConfig is updated
  formConfigVersion Int?                   @default(1) @map("form_config_version")
  requiredRole      String?                @map("required_role") @db.VarChar(50)
  workflowTypeId    String?                @map("workflow_type_id") @db.Uuid
  // P5-01: Catalog governance fields
  ownerId           String?                @map("owner_id") @db.Uuid
  lifecycleStatus   CatalogLifecycleStatus @default(DRAFT) @map("lifecycle_status")
  // P03 Task 13: Server-owned per-type classification. Replaces desk-code-based
  // confidentiality derivation. INTERNAL = visible to department members;
  // CONFIDENTIAL = restricted to authorised roles; RESTRICTED = need-to-know.
  classification    RequestClassification  @default(INTERNAL) @map("classification")
  reviewDate        DateTime?              @map("review_date") @db.Timestamp(6)
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamp(6)

  // Relations
  serviceCategory  ServiceCategory            @relation(fields: [serviceCategoryId], references: [id], onDelete: Cascade)
  workflow         WorkflowType?              @relation(fields: [workflowTypeId], references: [id], onDelete: SetNull)
  owner            User?                      @relation("CatalogItemOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  requests         Request[]
  entityRoutings   RequestTypeEntityRouting[]
  escalationRules  EscalationRule[]
  entitlements     CatalogEntitlement[] // P5-02
  approvalPolicies ApprovalPolicy[] // P5-06

  @@unique([tenantId, code]) // P2-09: tenant-local unique
  @@index([serviceCategoryId])
  @@index([workflowTypeId])
  @@index([tenantId])
  @@index([ownerId])
  @@index([lifecycleStatus])
  @@map("request_types")
}

model EscalationRule {
  id                      String   @id @default(uuid()) @db.Uuid
  tenantId                String?  @map("tenant_id") @db.Uuid
  requestTypeId           String   @map("request_type_id") @db.Uuid
  triggerHoursAfterBreach Int      @map("trigger_hours_after_breach")
  notifyRoles             String[] @map("notify_roles")
  label                   String?
  isActive                Boolean  @default(true) @map("is_active")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  requestType RequestType @relation(fields: [requestTypeId], references: [id], onDelete: Cascade)

  @@unique([requestTypeId, triggerHoursAfterBreach])
  @@index([requestTypeId])
  @@index([tenantId])
  @@map("escalation_rules")
}

enum SlaClockKind {
  RESPONSE
  RESOLUTION
  OLA
}

enum SlaClockStatus {
  ACTIVE
  PAUSED
  BREACHED
  COMPLETED
  CANCELLED
}

enum SlaTimerJobKind {
  SLA_RESPONSE_DUE
  SLA_RESOLUTION_DUE
  SLA_ESCALATION_DUE
}

enum SlaTimerJobStatus {
  SCHEDULED
  CLAIMED
  COMPLETED
  FAILED
  DEAD_LETTER
  CANCELLED
}

model SlaPolicyVersion {
  id                      String          @id @default(uuid()) @db.Uuid
  tenantId                String          @map("tenant_id") @db.Uuid
  requestTypeId           String?         @map("request_type_id") @db.Uuid
  version                 Int
  timezone                String          @default("Asia/Kuala_Lumpur") @db.VarChar(80)
  calendar                Json            @db.JsonB
  priority                RequestPriority @default(MEDIUM)
  responseTargetMinutes   Int?            @map("response_target_minutes")
  resolutionTargetMinutes Int?            @map("resolution_target_minutes")
  olaTargetMinutes        Int?            @map("ola_target_minutes")
  effectiveFrom           DateTime        @default(now()) @map("effective_from") @db.Timestamp(6)
  effectiveTo             DateTime?       @map("effective_to") @db.Timestamp(6)
  createdAt               DateTime        @default(now()) @map("created_at") @db.Timestamp(6)

  clocks SlaClock[]

  @@unique([tenantId, requestTypeId, version])
  @@index([tenantId, requestTypeId, effectiveFrom])
  @@map("sla_policy_versions")
}

model SlaClock {
  id              String         @id @default(uuid()) @db.Uuid
  tenantId        String         @map("tenant_id") @db.Uuid
  departmentId    String?        @map("department_id") @db.Uuid
  requestId       String         @map("request_id") @db.Uuid
  policyVersionId String?        @map("policy_version_id") @db.Uuid
  kind            SlaClockKind
  status          SlaClockStatus @default(ACTIVE)
  dueAt           DateTime       @map("due_at") @db.Timestamp(6)
  pausedAt        DateTime?      @map("paused_at") @db.Timestamp(6)
  pauseDurationMs BigInt         @default(0) @map("pause_duration_ms")
  escalationLevel Int            @default(0) @map("escalation_level")
  idempotencyKey  String         @map("idempotency_key") @db.VarChar(160)
  completedAt     DateTime?      @map("completed_at") @db.Timestamp(6)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamp(6)

  request       Request              @relation(fields: [requestId], references: [id], onDelete: Cascade)
  policyVersion SlaPolicyVersion?    @relation(fields: [policyVersionId], references: [id], onDelete: SetNull)
  pauses        SlaPauseLedger[]
  timerJobs     SlaTimerJob[]
  escalations   SlaEscalationEvent[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, dueAt])
  @@index([requestId, kind])
  @@map("sla_clocks")
}

model SlaPauseLedger {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  clockId    String    @map("clock_id") @db.Uuid
  pausedAt   DateTime  @map("paused_at") @db.Timestamp(6)
  resumedAt  DateTime? @map("resumed_at") @db.Timestamp(6)
  durationMs BigInt    @default(0) @map("duration_ms")
  reason     String?   @db.VarChar(200)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  clock SlaClock @relation(fields: [clockId], references: [id], onDelete: Cascade)

  @@index([tenantId, clockId, pausedAt])
  @@map("sla_pause_ledger")
}

model SlaTimerJob {
  id             String            @id @default(uuid()) @db.Uuid
  tenantId       String            @map("tenant_id") @db.Uuid
  departmentId   String?           @map("department_id") @db.Uuid
  requestId      String            @map("request_id") @db.Uuid
  clockId        String            @map("clock_id") @db.Uuid
  kind           SlaTimerJobKind
  status         SlaTimerJobStatus @default(SCHEDULED)
  runAt          DateTime          @map("run_at") @db.Timestamp(6)
  idempotencyKey String            @map("idempotency_key") @db.VarChar(180)
  attempts       Int               @default(0)
  maxAttempts    Int               @default(5) @map("max_attempts")
  nextAttemptAt  DateTime?         @map("next_attempt_at") @db.Timestamp(6)
  claimedAt      DateTime?         @map("claimed_at") @db.Timestamp(6)
  claimedBy      String?           @map("claimed_by") @db.VarChar(100)
  lastError      String?           @map("last_error") @db.Text
  payload        Json              @default("{}") @db.JsonB
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamp(6)

  request Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  clock   SlaClock @relation(fields: [clockId], references: [id], onDelete: Cascade)

  @@unique([tenantId, idempotencyKey])
  @@index([status, runAt])
  @@index([tenantId, requestId])
  @@map("sla_timer_jobs")
}

model SlaEscalationEvent {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  departmentId       String?  @map("department_id") @db.Uuid
  requestId          String   @map("request_id") @db.Uuid
  clockId            String?  @map("clock_id") @db.Uuid
  escalationLevel    Int      @map("escalation_level")
  ruleId             String?  @map("rule_id") @db.Uuid
  idempotencyKey     String   @map("idempotency_key") @db.VarChar(180)
  notifyRoles        String[] @map("notify_roles")
  notificationIntent Json     @map("notification_intent") @db.JsonB
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  request Request   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  clock   SlaClock? @relation(fields: [clockId], references: [id], onDelete: SetNull)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, requestId, escalationLevel])
  @@map("sla_escalation_events")
}

// P5-06: Generic approval policy model
// Defines configurable approval workflows per request type.
// Each policy has ordered steps; each step has an approver type and optional conditions.

enum PolicyApproverType {
  ROLE // Approve by system role (e.g., 'ADMIN', 'HR_MANAGER')
  DEPARTMENT // Approve by department head
  ENTITY // Approve by entity head
  USER // Approve by specific user
  TEAM // Approve by team lead
  AUTO // Auto-approve (no human needed)
}

enum PolicyConditionOperator {
  AND
  OR
}

// P04 Task 16: Approval definition lifecycle statuses
enum ApprovalDefinitionStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

// P04 Task 16: Approval instance step runtime statuses
enum ApprovalStepStatus {
  WAITING // Not yet activated (sequential steps after current)
  ACTIVE // Currently awaiting a decision
  APPROVED // Step approved
  REJECTED // Step rejected
  CANCELLED // Step cancelled (e.g. parent step rejected)
  TIMED_OUT // Step timed out per policy
}

// P04 Task 16: Timeout action — what happens when a step times out
enum ApprovalTimeoutAction {
  REMINDER // Send reminder, keep step ACTIVE (default)
  ESCALATE // Escalate to next authority level
  REJECT // Auto-reject the step (requires explicit policy)
}

model ApprovalPolicy {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String?  @map("tenant_id") @db.Uuid
  name          String   @db.VarChar(200)
  description   String?  @db.Text
  requestTypeId String   @map("request_type_id") @db.Uuid
  isActive      Boolean  @default(true) @map("is_active")
  priority      Int      @default(0) @map("priority") // Lower = higher priority; first matching policy wins
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  // Relations
  requestType     RequestType             @relation(fields: [requestTypeId], references: [id], onDelete: Cascade)
  steps           ApprovalPolicyStep[]
  approvalRecords RequestApproval[]
  versions        ApprovalPolicyVersion[]

  @@index([requestTypeId])
  @@index([tenantId])
  @@index([isActive])
  @@map("approval_policies")
}

model ApprovalPolicyStep {
  id            String                @id @default(uuid()) @db.Uuid
  policyId      String                @map("policy_id") @db.Uuid
  stepOrder     Int                   @map("step_order") // Execution order (1 = first approver)
  approverType  PolicyApproverType    @map("approver_type")
  approverId    String?               @map("approver_id") @db.Uuid // Required when approverType = USER
  roleId        String?               @map("role_id") // Required when approverType = ROLE
  departmentId  String?               @map("department_id") @db.Uuid // Required when approverType = DEPARTMENT
  entityId      String?               @map("entity_id") @db.Uuid // Required when approverType = ENTITY
  teamId        String?               @map("team_id") @db.VarChar(100) // Required when approverType = TEAM
  label         String?               @db.VarChar(200) // Human-readable label for this step
  autoApproveIf String?               @map("auto_approve_if") @db.Text // Optional JSON condition for auto-approve
  timeoutHours  Int?                  @map("timeout_hours") // Hours before auto-escalation/skip
  // P04 Task 16: Parallel groups and timeout actions
  parallelGroup String?               @map("parallel_group") @db.VarChar(50) // Steps with same parallelGroup activate together
  timeoutAction ApprovalTimeoutAction @default(REMINDER) @map("timeout_action") // What happens on timeout
  condition     Json?                 @db.JsonB // P04 Task 16: Typed condition AST for auto-approve/routing
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime              @updatedAt @map("updated_at") @db.Timestamp(6)

  // Relations
  policy ApprovalPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([policyId])
  @@index([policyId, stepOrder])
  @@map("approval_policy_steps")
}

// P04 Task 16: Immutable published definition version
// A policy can have many versions; only PUBLISHED versions can start instances.
// Once published, a version's definition JSON is frozen.
model ApprovalPolicyVersion {
  id            String                   @id @default(uuid()) @db.Uuid
  policyId      String                   @map("policy_id") @db.Uuid
  versionNumber Int                      @map("version_number")
  status        ApprovalDefinitionStatus @default(DRAFT) @map("status")
  definition    Json                     @db.JsonB // Frozen snapshot of steps + conditions
  publishedAt   DateTime?                @map("published_at") @db.Timestamp(6)
  publishedBy   String?                  @map("published_by") @db.Uuid
  retiredAt     DateTime?                @map("retired_at") @db.Timestamp(6)
  retiredBy     String?                  @map("retired_by") @db.Uuid
  effectiveFrom DateTime?                @map("effective_from") @db.Timestamp(6)
  effectiveTo   DateTime?                @map("effective_to") @db.Timestamp(6)
  createdAt     DateTime                 @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime                 @updatedAt @map("updated_at") @db.Timestamp(6)

  policy    ApprovalPolicy     @relation(fields: [policyId], references: [id], onDelete: Cascade)
  instances ApprovalInstance[]

  @@unique([policyId, versionNumber])
  @@index([policyId])
  @@index([status])
  @@index([policyId, status])
  @@map("approval_policy_versions")
}

// P04 Task 16: Approval runtime instance — one per request approval flow
model ApprovalInstance {
  id              String             @id @default(uuid()) @db.Uuid
  requestId       String             @map("request_id") @db.Uuid
  tenantId        String?            @map("tenant_id") @db.Uuid
  departmentId    String?            @map("department_id") @db.Uuid
  policyVersionId String             @map("policy_version_id") @db.Uuid
  status          ApprovalStepStatus @default(ACTIVE) @map("status")
  completedAt     DateTime?          @map("completed_at") @db.Timestamp(6)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamp(6)

  request       Request                @relation(fields: [requestId], references: [id], onDelete: Cascade)
  policyVersion ApprovalPolicyVersion  @relation(fields: [policyVersionId], references: [id], onDelete: Restrict)
  steps         ApprovalInstanceStep[]

  @@index([requestId])
  @@index([tenantId])
  @@index([policyVersionId])
  @@index([status])
  @@map("approval_instances")
}

// P04 Task 16: Approval runtime step — one per approval step in a live instance
model ApprovalInstanceStep {
  id                 String                @id @default(uuid()) @db.Uuid
  instanceId         String                @map("instance_id") @db.Uuid
  stepOrder          Int                   @map("step_order")
  parallelGroup      String?               @map("parallel_group") @db.VarChar(50)
  approverType       PolicyApproverType    @map("approver_type")
  assignedApproverId String?               @map("assigned_approver_id") @db.Uuid
  status             ApprovalStepStatus    @default(WAITING) @map("status")
  decision           String?               @db.VarChar(20) // APPROVED, REJECTED, etc.
  decisionComment    String?               @map("decision_comment") @db.Text
  decidedAt          DateTime?             @map("decided_at") @db.Timestamp(6)
  decidedBy          String?               @map("decided_by") @db.Uuid
  // Delegation
  delegatedBy        String?               @map("delegated_by") @db.Uuid
  delegatedTo        String?               @map("delegated_to") @db.Uuid
  delegatedAt        DateTime?             @map("delegated_at") @db.Timestamp(6)
  // Timeout
  dueAt              DateTime?             @map("due_at") @db.Timestamp(6)
  timeoutAction      ApprovalTimeoutAction @default(REMINDER) @map("timeout_action")
  // Condition (stored JSON AST for auto-approve/conditional routing)
  condition          Json?                 @db.JsonB
  // Audit
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt          DateTime              @updatedAt @map("updated_at") @db.Timestamp(6)

  instance ApprovalInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([instanceId])
  @@index([instanceId, stepOrder])
  @@index([assignedApproverId])
  @@index([status, dueAt])
  @@map("approval_instance_steps")
}

model WorkflowType {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(100)
  code         String   @unique @db.VarChar(50)
  description  String?  @db.Text
  isActive     Boolean  @default(true) @map("is_active")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  // Relations
  steps        WorkflowStep[]
  versions     WorkflowVersion[]
  requestTypes RequestType[]

  @@map("workflow_types")
}

model WorkflowStep {
  id             String   @id @default(uuid()) @db.Uuid
  workflowTypeId String   @map("workflow_type_id") @db.Uuid
  label          String   @db.VarChar(100)
  status         String   @db.VarChar(100)
  icon           String   @default("radio_button_checked") @db.VarChar(50)
  displayOrder   Int      @map("display_order")
  isInitial      Boolean  @default(false) @map("is_initial")
  isFinal        Boolean  @default(false) @map("is_final")
  slaPause       Boolean  @default(false) @map("sla_pause")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  // Relations
  workflow WorkflowType @relation(fields: [workflowTypeId], references: [id], onDelete: Cascade)

  @@unique([workflowTypeId, status])
  @@index([workflowTypeId])
  @@map("workflow_steps")
}

enum WorkflowVersionStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

// Only STATUS today. Future BPMN-lite node types (APPROVAL, TIMER,
// PARALLEL_GATE, NOTIFICATION, WEBHOOK, SCRIPT) extend this enum without
// changing the table shape — see the spec's deferred-scope section.
enum WorkflowNodeType {
  STATUS
}

// Authoring source of truth for a WorkflowType's status graph. Publishing a
// version compiles it into WorkflowTransition + WorkflowStep rows, which is
// what the runtime actually enforces.
model WorkflowVersion {
  id             String                @id @default(uuid()) @db.Uuid
  workflowTypeId String                @map("workflow_type_id") @db.Uuid
  version        Int
  status         WorkflowVersionStatus @default(DRAFT)
  notes          String?               @db.Text
  publishedAt    DateTime?             @map("published_at") @db.Timestamp(6)
  publishedById  String?               @map("published_by_id") @db.Uuid
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.Timestamp(6)

  workflowType WorkflowType   @relation(fields: [workflowTypeId], references: [id], onDelete: Cascade)
  publishedBy  User?          @relation("WorkflowVersionPublisher", fields: [publishedById], references: [id])
  nodes        WorkflowNode[]
  edges        WorkflowEdge[]

  @@unique([workflowTypeId, version])
  @@index([workflowTypeId, status])
  @@map("workflow_versions")
}

model WorkflowNode {
  id                String           @id @default(uuid()) @db.Uuid
  workflowVersionId String           @map("workflow_version_id") @db.Uuid
  type              WorkflowNodeType @default(STATUS)
  // → RequestStatusDefinition.code. Required when type = STATUS.
  statusCode        String?          @map("status_code") @db.VarChar(100)
  label             String?          @db.VarChar(200)
  displayOrder      Int?             @map("display_order")
  // NULL means "never laid out" — the designer auto-layouts on open and
  // persists coordinates on first save. Distinct from a node deliberately
  // placed at the origin.
  positionX         Float?           @map("position_x")
  positionY         Float?           @map("position_y")
  isInitial         Boolean          @default(false) @map("is_initial")
  isFinal           Boolean          @default(false) @map("is_final")
  slaPause          Boolean          @default(false) @map("sla_pause")
  icon              String           @default("radio_button_checked") @db.VarChar(50)
  config            Json?            @db.JsonB
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamp(6)

  version       WorkflowVersion @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade)
  outgoingEdges WorkflowEdge[]  @relation("EdgeFromNode")
  incomingEdges WorkflowEdge[]  @relation("EdgeToNode")

  @@unique([workflowVersionId, statusCode])
  @@unique([id, workflowVersionId])
  @@index([workflowVersionId])
  @@map("workflow_nodes")
}

model WorkflowEdge {
  id                    String   @id @default(uuid()) @db.Uuid
  workflowVersionId     String   @map("workflow_version_id") @db.Uuid
  fromNodeId            String   @map("from_node_id") @db.Uuid
  toNodeId              String   @map("to_node_id") @db.Uuid
  transitionLabel       String?  @map("transition_label") @db.VarChar(50)
  requiresComment       Boolean  @default(false) @map("requires_comment")
  autoAssignRole        String?  @map("auto_assign_role") @db.VarChar(50)
  autoAssignUserId      String?  @map("auto_assign_user_id") @db.Uuid
  allowedRoles          String[] @default([]) @map("allowed_roles")
  allowedExecutiveRoles String[] @default([]) @map("allowed_executive_roles")
  config                Json?    @db.JsonB
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  version  WorkflowVersion @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade)
  fromNode WorkflowNode    @relation("EdgeFromNode", fields: [fromNodeId, workflowVersionId], references: [id, workflowVersionId], onDelete: Cascade)
  toNode   WorkflowNode    @relation("EdgeToNode", fields: [toNodeId, workflowVersionId], references: [id, workflowVersionId], onDelete: Cascade)

  @@unique([workflowVersionId, fromNodeId, toNodeId])
  @@unique([id, workflowVersionId])
  @@index([workflowVersionId])
  @@map("workflow_edges")
}

// P04 Task 15: Immutable workflow history for transactional command boundary
model WorkflowHistory {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  departmentId   String?  @map("department_id") @db.Uuid
  requestId      String   @map("request_id") @db.Uuid
  fromStatus     String   @map("from_status") @db.VarChar(100)
  toStatus       String   @map("to_status") @db.VarChar(100)
  actorId        String?  @map("actor_id") @db.Uuid
  actorName      String?  @map("actor_name") @db.VarChar(200)
  source         String   @default("unknown") @map("source") @db.VarChar(100)
  comment        String?  @db.Text
  metadata       Json?    @db.JsonB
  requestVersion Int      @map("request_version")
  idempotencyKey String?  @map("idempotency_key") @db.VarChar(200)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, createdAt])
  @@index([departmentId, createdAt])
  @@index([requestId])
  @@index([requestId, createdAt])
  @@map("workflow_history")
}

// P04 Task 15: Command idempotency — stores the result of a workflow command
// so replaying the same idempotency key returns the original result
model WorkflowCommandResult {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  departmentId   String?  @map("department_id") @db.Uuid
  idempotencyKey String   @map("idempotency_key") @db.VarChar(200)
  commandHash    String   @map("command_hash") @db.Char(64)
  requestId      String   @map("request_id") @db.Uuid
  fromStatus     String   @map("from_status") @db.VarChar(100)
  toStatus       String   @map("to_status") @db.VarChar(100)
  result         Json     @db.JsonB
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, requestId])
  @@index([departmentId, createdAt])
  @@index([requestId])
  @@map("workflow_command_results")
}

// P04 Task 15: Transactional outbox for reliable event publishing
enum OutboxEventStatus {
  PENDING
  CLAIMED
  PUBLISHED
  FAILED
  DEAD_LETTER
}

model OutboxEvent {
  id               String            @id @default(uuid()) @db.Uuid
  tenantId         String            @map("tenant_id") @db.Uuid
  departmentId     String?           @map("department_id") @db.Uuid
  eventType        String            @map("event_type") @db.VarChar(100)
  aggregateId      String            @map("aggregate_id") @db.Uuid
  aggregateVersion Int               @map("aggregate_version")
  payload          Json              @db.JsonB
  published        Boolean           @default(false) @map("published")
  publishedAt      DateTime?         @map("published_at") @db.Timestamp(6)
  status           OutboxEventStatus @default(PENDING) @map("status")
  attempts         Int               @default(0) @map("attempts")
  maxAttempts      Int               @default(5) @map("max_attempts")
  nextAttemptAt    DateTime?         @map("next_attempt_at") @db.Timestamp(6)
  lastError        String?           @map("last_error") @db.Text
  claimedAt        DateTime?         @map("claimed_at") @db.Timestamp(6)
  claimedBy        String?           @map("claimed_by") @db.VarChar(100)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamp(6)

  @@unique([tenantId, eventType, aggregateId, aggregateVersion])
  @@index([published, createdAt])
  @@index([tenantId, published, createdAt])
  @@index([departmentId, createdAt])
  @@index([aggregateId, aggregateVersion])
  @@index([status, nextAttemptAt])
  @@index([status, createdAt])
  @@map("outbox_events")
}

enum RequestStatus {
  SUBMITTED
  IN_REVIEW
  ACTION_REQUIRED
  APPROVED
  REJECTED
  CANCELLED
  RESOLVED
  IN_PROGRESS
  WAITING
  PENDING_CEO_APPROVAL
  CEO_APPROVED
  CEO_REJECTED
  JOB_POSTED
  PENDING_MANAGER_REVIEW
  MANAGER_APPROVED
  INTERVIEW_SCHEDULED
  INTERVIEW_FEEDBACK_PENDING
  CANDIDATE_REJECTED_INTERVIEW
  HR_SCREENING
  LOA_PENDING_APPROVAL
  LOA_APPROVED
  LOA_ISSUED
  LOA_ACCEPTED
  LOA_REJECTED
  COMPLETED
  // Offboarding Statuses
  OFFBOARDING_SUBMITTED
  OFFBOARDING_NOTICE_PERIOD
  OFFBOARDING_KNOWLEDGE_TRANSFER
  OFFBOARDING_FINAL_WEEK
  OFFBOARDING_EXIT_PROCEDURES
  OFFBOARDING_COMPLETED
  // Onboarding Statuses
