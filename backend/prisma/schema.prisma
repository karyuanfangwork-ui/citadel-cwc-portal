// ============================================================================
// CRM CUSTOM FIELDS
// ============================================================================

model CrmCustomFieldDefinition {
  id           String   @id @default(uuid()) @db.Uuid
  entity       String   @db.VarChar(20) // LEAD | CONTACT | ACCOUNT | OPPORTUNITY | ACTIVITY
  fieldKey     String   @map("field_key") @db.VarChar(100) // slug: "trust_deed_number"
  label        String   @db.VarChar(200)
  fieldType    String   @map("field_type") @db.VarChar(20) // TEXT | NUMBER | DATE | DROPDOWN | MULTI_SELECT | CHECKBOX | URL
  group        String?  @db.VarChar(100) // tab/section: "Trust Details"
  options      Json? // for DROPDOWN/MULTI_SELECT: [{ label, value }]
