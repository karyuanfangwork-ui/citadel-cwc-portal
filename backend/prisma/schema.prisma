model BannerConfig {
  id          String   @id @default(uuid())
  role        String
  status      String
  icon        String
  title       String
  description String   @db.Text
  colorScheme String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([role, status])
  @@map("banner_configs")
}

model RequestStatusDefinition {
  id           String   @id @default(uuid()) @db.Uuid
  code         String   @unique @db.VarChar(100)
  label        String   @db.VarChar(200)
  description  String?  @db.Text
  category     String?  @db.VarChar(50)
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([isActive])
  @@index([category])
  @@map("request_status_definitions")
}

// Workflow transition rules — source of truth for valid status changes.
// The VALID_TRANSITIONS map in workflowTransitions.ts is the SEED reference;
// this table is the runtime source of truth.
model WorkflowTransition {
  id               String   @id @default(uuid()) @db.Uuid
  fromStatus       String   @map("from_status") @db.VarChar(100)
  toStatus         String   @map("to_status") @db.VarChar(100)
  transitionLabel  String?  @map("transition_label") @db.VarChar(50)
  // Label values: APPROVE | REJECT | SUBMIT | ADVANCE | RETURN | ESCALATE | CLOSE
  requiresComment  Boolean  @default(false) @map("requires_comment")
  // Hint: optional role or userId to auto-assign after this transition
  autoAssignRole   String?  @map("auto_assign_role") @db.VarChar(50)
  autoAssignUserId String?  @map("auto_assign_user_id") @db.Uuid
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  // Each (fromStatus, toStatus) pair is unique
  @@unique([fromStatus, toStatus])
  @@index([fromStatus])
  @@index([toStatus])
  @@index([isActive])
  @@map("workflow_transitions")
}

