enum CommitteeMeetingStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum CommitteeMeetingType {
  REGULAR
  ADHOC
}

enum CommitteeMemberRole {
  CHAIR
  MEMBER
  SECRETARY
}

enum CommitteeAttendance {
  PRESENT
  ABSENT
  EXCUSED
}

enum CommitteeVoteChoice {
  APPROVE
  REJECT
  ABSTAIN
}

enum AgendaItemDecisionType {
  APPROVE
  REJECT
  DEFER
}

model CommitteeMeeting {
  id          String                 @id @default(uuid()) @db.Uuid
  title       String                 @db.VarChar(200)
