enum RequestPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Request {
  id              String  @id @default(uuid()) @db.Uuid
  tenantId        String? @map("tenant_id") @db.Uuid
  departmentId    String? @map("department_id") @db.Uuid
  referenceNumber String  @unique @map("reference_number") @db.VarChar(50)
  requestTypeId   String? @map("request_type_id") @db.Uuid
  serviceDeskId   String? @map("service_desk_id") @db.Uuid

  // Requester Information
  requesterId    String  @map("requester_id") @db.Uuid
  requesterEmail String  @map("requester_email") @db.VarChar(255)
  requesterPhone String? @map("requester_phone") @db.VarChar(20)

  // Request Details
  summary     String          @db.VarChar(500)
  description String?         @db.Text
  priority    RequestPriority @default(MEDIUM)
  status      RequestStatus   @default(SUBMITTED)

  // Assignment
  assignedToId    String? @map("assigned_to_id") @db.Uuid
  assignedTeam    String? @map("assigned_team") @db.VarChar(100)
  parentRequestId String? @map("parent_request_id") @db.Uuid

  // Metadata
  isConfidential     Boolean  @default(false) @map("is_confidential")
  tags               String[] @db.Text
  customFields       Json?    @map("custom_fields") @db.JsonB
  // P5-04: Snapshot of the form config at submission time
  formConfigSnapshot Json?    @map("form_config_snapshot") @db.JsonB
  formConfigVersion  Int?     @map("form_config_version")

  // SLA Tracking
  slaDueAt           DateTime? @map("sla_due_at") @db.Timestamp(6)
  slaPausedAt        DateTime? @map("sla_paused_at") @db.Timestamp(6)
  slaPauseDurationMs BigInt    @default(0) @map("sla_pause_duration_ms")
  firstResponseAt    DateTime? @map("first_response_at") @db.Timestamp(6)
  resolvedAt         DateTime? @map("resolved_at") @db.Timestamp(6)
  closedAt           DateTime? @map("closed_at") @db.Timestamp(6)
  completedAt        DateTime? @map("completed_at") @db.Timestamp(6)

  // Timestamps
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamp(6)

  // P04 Task 15: Optimistic concurrency version for transactional workflow commands
  version Int @default(1) @map("version")

  // Relations
  department           Department?                  @relation(fields: [tenantId, departmentId], references: [tenantId, id], onDelete: Restrict)
  requestType          RequestType?                 @relation(fields: [requestTypeId], references: [id])
  serviceDesk          ServiceDesk?                 @relation(fields: [serviceDeskId], references: [id])
  requester            User                         @relation("RequestRequester", fields: [requesterId], references: [id])
  assignedTo           User?                        @relation("RequestAssignee", fields: [assignedToId], references: [id])
  activities           RequestActivity[]
  attachments          RequestAttachment[]
  itHardwareRequest    ITHardwareRequest?
  hrLeaveRequest       HRLeaveRequest?
  expenseReimbursement FinanceExpenseReimbursement?
  notifications        Notification[]
  approvals            RequestApproval[]
  approvalInstances    ApprovalInstance[]
  candidateResumes     CandidateResume[]
  candidates           Candidate[]
  interviewSchedules   InterviewSchedule[]
  interviewFeedbacks   InterviewFeedback[]
  hrScreening          HRScreening?
  letterOfAcceptance   LetterOfAcceptance?
  onboardingRequest    OnboardingRequest?
  offboardingRequest   OffboardingRequest?
  parentRequest        Request?                     @relation("RequestChildren", fields: [parentRequestId], references: [id])
  childRequests        Request[]                    @relation("RequestChildren")
  // Asset Relations
  sourceAssets         Asset[]                      @relation("AssetSourceRequest")
  assetAssignments     AssetAssignment[]            @relation("AssetAssignmentRequest")
  // CRM Relations
  crmAccountLinks      CrmAccountRequest[]
  participants         RequestParticipant[]

  // P04 Task 15: Immutable workflow history
  workflowHistory     WorkflowHistory[]
  slaClocks           SlaClock[]
  slaTimerJobs        SlaTimerJob[]
  slaEscalationEvents SlaEscalationEvent[]

  @@unique([id, tenantId, departmentId])
  @@index([referenceNumber])
  @@index([requesterId])
  @@index([status])
  @@index([serviceDeskId])
  @@index([assignedToId])
  @@index([createdAt(sort: Desc)])
  @@index([tenantId])
  @@index([departmentId])
  @@index([tenantId, status]) // P2-08: composite for agent dashboard / list filters
  @@index([tenantId, createdAt(sort: Desc)]) // P2-08: composite for pagination
  @@index([tenantId, assignedToId]) // P2-08: composite for "my tickets" view
  @@index([tenantId, serviceDeskId]) // P2-08: composite for service desk filtering
  @@map("requests")
}

