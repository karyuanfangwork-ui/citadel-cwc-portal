  regions     Json // { states: ["Selangor", "KL"], countries: ["MY"] }
  isActive    Boolean  @default(true) @map("is_active")
  createdBy   String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  members         CrmTerritoryMember[]
  quotas          CrmQuota[]
  leads           CrmLead[]            @relation("LeadTerritory")
  assignmentRules CrmAssignmentRule[]
  user            User                 @relation("CrmTerritoryCreator", fields: [createdBy], references: [id])

  @@index([createdBy])
  @@index([isActive])
