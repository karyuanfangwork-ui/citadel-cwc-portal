  id               String   @id @default(uuid()) @db.Uuid
  applicationId    String   @map("application_id") @db.Uuid
  accountNo        String   @map("account_no") @db.VarChar(50)
  facilityType     String   @map("facility_type") @db.VarChar(100)
  snapshotMonth    DateTime @map("snapshot_month") @db.Date

  withdrawalAmount      Decimal? @map("withdrawal_amount") @db.Decimal(15, 2)
  depositAmount         Decimal? @map("deposit_amount") @db.Decimal(15, 2)
  monthEndBalance       Decimal? @map("month_end_balance") @db.Decimal(15, 2)
  returnedChequesCount  Int?     @map("returned_cheques_count")

  approvedLimit        Decimal? @map("approved_limit") @db.Decimal(15, 2)
  outstandingAmount    Decimal? @map("outstanding_amount") @db.Decimal(15, 2)
  overdueAmount        Decimal? @map("overdue_amount") @db.Decimal(15, 2)
  instalmentsInArrears Int?     @map("instalments_in_arrears")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  application CreditApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, accountNo, snapshotMonth])
  @@index([applicationId])
  @@map("account_utilisation_snapshots")
}

// ============================================================================
// Credit Decision — approval/rejection record
// ============================================================================
model CreditDecision {
  id              String              @id @default(uuid()) @db.Uuid
  applicationId   String              @map("application_id") @db.Uuid
  
  decisionType    ApprovalDecisionType @map("decision_type")
  decisionById    String              @map("decided_by_id") @db.Uuid
  decisionAt      DateTime            @default(now()) @map("decision_at") @db.Timestamp(6)
  
  authorityLevel  String?             @map("authority_level") @db.VarChar(50)
  conditions      String?             @db.Text
  comments        String?             @db.Text
  
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamp(6)
  
  application     CreditApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  decidedBy       User              @relation("CreditDecisionBy", fields: [decisionById], references: [id])
  conditionRecords Condition[]       @relation("CreditDecisionConditions")
  
  @@index([applicationId])
  @@map("credit_decisions")
}

// ============================================================================
// Condition — precedent and subsequent
// ============================================================================
model Condition {
  id              String            @id @default(uuid()) @db.Uuid
  applicationId   String            @map("application_id") @db.Uuid
  
  title           String            @db.VarChar(255)
  description     String?           @db.Text
  category        ConditionCategory @default(PRE_DISBURSEMENT) @map("category")
  conditionType   ConditionType     @default(PRECEDENT) @map("condition_type")
  status          ConditionStatus   @default(PENDING) @map("status")
  dueDate         DateTime?         @map("due_date") @db.Date
  
  // Completion fields
  isFulfilled     Boolean           @default(false) @map("is_fulfilled")
  fulfilledAt     DateTime?         @map("fulfilled_at") @db.Timestamp(6)
  fulfilledById   String?           @map("fulfilled_by_id") @db.Uuid
  fulfilmentNotes String?           @map("fulfilment_notes") @db.Text
  
  // Waiver fields
  waiverReason    String?           @map("waiver_reason") @db.Text
  waivedAt        DateTime?         @map("waived_at") @db.Timestamp(6)
  waivedById      String?           @map("waived_by_id") @db.Uuid
  
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamp(6)
  
  // §2.5 — Link to approval decision that generated this condition
  decisionId     String?           @map("decision_id") @db.Uuid
  
  application     CreditApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fulfilledBy     User?             @relation("ConditionFulfilledBy", fields: [fulfilledById], references: [id])
  waivedBy        User?             @relation("ConditionWaivedBy", fields: [waivedById], references: [id])
  decision        CreditDecision?   @relation("CreditDecisionConditions", fields: [decisionId], references: [id])
  earlyWarningSignals EarlyWarningSignal[]  @relation("EwsCondition")
  
  @@index([applicationId])
  @@index([conditionType])
  @@index([status])
  @@map("conditions")
}

// ============================================================================
// Disbursement Order — controls the disbursement lifecycle
// ============================================================================
model DisbursementOrder {
  id                  String             @id @default(uuid()) @db.Uuid
  applicationId        String             @unique @map("application_id") @db.Uuid
  orderNo             String             @unique @map("order_no") @db.VarChar(30)
  requestedById       String             @map("requested_by_id") @db.Uuid
  requestedAt         DateTime           @default(now()) @map("requested_at") @db.Timestamp(6)
  approvedById        String?            @map("approved_by_id") @db.Uuid
  approvedAt          DateTime?          @map("approved_at") @db.Timestamp(6)
  disbursedById       String?            @map("disbursed_by_id") @db.Uuid
  disbursedAt         DateTime?          @map("disbursed_at") @db.Timestamp(6)
  status              DisbursementStatus @default(PENDING)
  totalAmount          Decimal            @map("total_amount") @db.Decimal(15, 2)
  currency            String             @default("MYR") @db.VarChar(3)
  disbursementMethod  String?            @map("disbursement_method") @db.VarChar(100)
  beneficiaryBank     String?            @map("beneficiary_bank") @db.VarChar(255)
  beneficiaryAccount  String?            @map("beneficiary_account") @db.VarChar(50)
  referenceNote       String?            @map("reference_note") @db.Text
  cancelledById       String?            @map("cancelled_by_id") @db.Uuid
  cancelledAt         DateTime?          @map("cancelled_at") @db.Timestamp(6)
  cancellationReason  String?            @map("cancellation_reason") @db.Text
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamp(6)

  application   CreditApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  requestedBy   User              @relation("DisbursementRequestedBy", fields: [requestedById], references: [id])
  approvedBy    User?             @relation("DisbursementApprovedBy", fields: [approvedById], references: [id])
  disbursedBy   User?             @relation("DisbursementDisbursedBy", fields: [disbursedById], references: [id])
  cancelledBy   User?             @relation("DisbursementCancelledBy", fields: [cancelledById], references: [id])

  @@index([status])
  @@map("disbursement_orders")
}

// ============================================================================
// Credit Approval Matrix — defines authority levels by exposure & risk rating
// ============================================================================
model CreditApprovalMatrix {
  id                  String     @id @default(uuid()) @db.Uuid
  name                String     @db.VarChar(255)
  description         String?    @db.Text
  
  minExposure         Decimal    @map("min_exposure") @db.Decimal(15, 2)
  maxExposure         Decimal    @map("max_exposure") @db.Decimal(15, 2)
  minRating           RiskRating @map("min_rating")
  maxRating           RiskRating @map("max_rating")
  
  authorityLevel      String     @map("authority_level") @db.VarChar(50)
  requiredApproverCount Int      @map("required_approver_count") @default(1)

  // §3.1 — null = applies to all branches; set = branch-specific authority override
  branchId            String?    @map("branch_id") @db.Uuid
  branch              Branch?    @relation(fields: [branchId], references: [id])

  isActive            Boolean    @default(true) @map("is_active")
  effectiveFrom       DateTime   @map("effective_from") @db.Timestamp(6)
  effectiveTo         DateTime?  @map("effective_to") @db.Timestamp(6)
  
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamp(6)
  
  versions            CreditApprovalMatrixVersion[]
  
  @@index([authorityLevel])
  @@index([isActive])
  @@index([effectiveFrom])
  @@index([branchId])
  @@map("credit_approval_matrices")
}

// ============================================================================
// Credit Approval Matrix Version — snapshot of matrix rules for audit trail
// ============================================================================
model CreditApprovalMatrixVersion {
  id            String   @id @default(uuid()) @db.Uuid
  matrixId      String   @map("matrix_id") @db.Uuid
  
  version       Int
  snapshot      Json
  
  approvedById  String   @map("approved_by_id") @db.Uuid
  approvedAt    DateTime @map("approved_at") @db.Timestamp(6)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  
  matrix        CreditApprovalMatrix @relation(fields: [matrixId], references: [id], onDelete: Cascade)
  approvedBy    User                 @relation("MatrixVersionApprovedBy", fields: [approvedById], references: [id])
  
  @@index([matrixId])
  @@unique([matrixId, version])
  @@map("credit_approval_matrix_versions")
}

// ============================================================================
// Financial Statement — a borrower's financial statement (BS, PL, or CF)
// ============================================================================
model FinancialStatement {
  id               String               @id @default(uuid()) @db.Uuid
  borrowerProfileId String               @map("borrower_profile_id") @db.Uuid
  period           FinancialPeriod
  fiscalYearEnd    DateTime             @map("fiscal_year_end") @db.Date
  statementType    FinancialStatementType @map("statement_type")
  currency        CurrencyCode          @default(MYR)
  enteredById     String               @map("entered_by_id") @db.Uuid
  reviewedById    String?              @map("reviewed_by_id") @db.Uuid
  status          FinancialStatus       @default(DRAFT)
  
  // CA Memo Phase 3 — Section 12 audit + commentary
  auditorName                  String?  @map("auditor_name") @db.VarChar(255)
  isQualified                  Boolean? @map("is_qualified")
  qualificationNotes           String?  @map("qualification_notes") @db.Text
  isDraftAccounts              Boolean  @default(false) @map("is_draft_accounts")
  commentarySalesProfitability String?  @map("commentary_sales_profitability") @db.Text
  commentaryAssetMgmt          String?  @map("commentary_asset_mgmt") @db.Text
  commentaryDebtMgmt           String?  @map("commentary_debt_mgmt") @db.Text
  commentaryCashflow           String?  @map("commentary_cashflow") @db.Text
  commentaryConclusion         String?  @map("commentary_conclusion") @db.Text

  deletedAt       DateTime?            @map("deleted_at") @db.Timestamp(6)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamp(6)

  // Relations
  borrowerProfile BorrowerProfile      @relation(fields: [borrowerProfileId], references: [id], onDelete: Cascade)
  enteredBy       User                 @relation("FinancialEnteredBy", fields: [enteredById], references: [id])
  reviewedBy     User?                @relation("FinancialReviewedBy", fields: [reviewedById], references: [id])
  lineItems      FinancialLineItem[]
  ratios         FinancialRatio[]
  
  @@index([borrowerProfileId])
  @@index([statementType])
  @@index([status])
  @@map("financial_statements")
}

// ============================================================================
// Financial Line Item — individual line items within a financial statement
// ============================================================================
model FinancialLineItem {
  id             String   @id @default(uuid()) @db.Uuid
  statementId    String   @map("statement_id") @db.Uuid
  lineKey        String   @map("line_key") @db.VarChar(100)
  lineLabel      String   @map("line_label") @db.VarChar(200)
  amount         Decimal  @db.Decimal(15, 2)
  parentLineKey  String?  @map("parent_line_key") @db.VarChar(100)
  displayOrder   Int      @map("display_order")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamp(6)
  
  // Relations
  statement      FinancialStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  
  @@index([statementId])
  @@index([lineKey])
  @@unique([statementId, lineKey])
  @@map("financial_line_items")
}

// ============================================================================
// Financial Ratio — computed ratios derived from financial statements
// ============================================================================
model FinancialRatio {
  id          String        @id @default(uuid()) @db.Uuid
  statementId String        @map("statement_id") @db.Uuid
  ratioKey    String        @map("ratio_key") @db.VarChar(100)
  ratioLabel  String        @map("ratio_label") @db.VarChar(200)
  value       Decimal       @db.Decimal(10, 4)
  category    RatioCategory
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamp(6)
  
  // Relations
  statement   FinancialStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  
  @@index([statementId])
  @@index([ratioKey])
  @@index([category])
  @@unique([statementId, ratioKey])
  @@map("financial_ratios")
}

// ============================================================================
// SPRINT 3 — SCORECARD & SCORING
// ============================================================================

// ============================================================================
// Credit Scorecard — defines a scoring model with weighted factor groups
// ============================================================================
model CreditScorecard {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(200)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  // Relations
  versions    CreditScorecardVersion[]

  @@map("credit_scorecards")
}

// ============================================================================
// Credit Scorecard Version — snapshot of factor weights for audit trail
// ============================================================================
model CreditScorecardVersion {
  id            String   @id @default(uuid()) @db.Uuid
  scorecardId   String   @map("scorecard_id") @db.Uuid
  version       Int
  factorWeights        Json
  retailFactorWeights  Json? @map("retail_factor_weights")
  isActive      Boolean  @default(false) @map("is_active")
  effectiveFrom DateTime @map("effective_from") @db.Timestamp(6)
  approvedById  String?  @map("approved_by_id") @db.Uuid
  approvedAt    DateTime? @map("approved_at") @db.Timestamp(6)

  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  // Relations
  scorecard     CreditScorecard @relation(fields: [scorecardId], references: [id], onDelete: Cascade)
  approvedBy    User?           @relation("ScorecardVersionApprovedBy", fields: [approvedById], references: [id])
  scoreRuns     CreditScoreRun[]

  @@unique([scorecardId, version])
  @@index([scorecardId])
  @@map("credit_scorecard_versions")
}

// ============================================================================
// Credit Score Run — result of scoring an application with a scorecard version
// ============================================================================
model CreditScoreRun {
  id                   String     @id @default(uuid()) @db.Uuid
  applicationId         String     @map("application_id") @db.Uuid
  scorecardVersionId    String     @map("scorecard_version_id") @db.Uuid
  factorScores         Json
  totalScore           Decimal    @map("total_score") @db.Decimal(10, 2)
  riskRating           RiskRating @map("risk_rating")
  isOverride           Boolean    @default(false) @map("is_override")
  overrideReason       String?    @map("override_reason") @db.Text
  overrideApprovedById String?    @map("override_approved_by_id") @db.Uuid
  overrideApprovedAt   DateTime?  @map("override_approved_at") @db.Timestamp(6)
  baseRiskRating       RiskRating? @map("base_risk_rating")
  bureauCapsApplied    Json?      @map("bureau_caps_applied")
  runAt                DateTime   @default(now()) @map("run_at") @db.Timestamp(6)

  createdAt            DateTime   @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt            DateTime   @updatedAt @map("updated_at") @db.Timestamp(6)

  // Relations
  application          CreditApplication     @relation(fields: [applicationId], references: [id])
  scorecardVersion     CreditScorecardVersion @relation(fields: [scorecardVersionId], references: [id])
  overrideApprovedBy   User?                 @relation("ScoreRunOverrideApprovedBy", fields: [overrideApprovedById], references: [id])

  @@index([applicationId])
  @@index([scorecardVersionId])
  @@map("credit_score_runs")
}

// ============================================================================
// Qualitative Assessment — Wave 1 (non-bank lending)
// ============================================================================
model QualitativeAssessment {
  id                 String   @id @default(uuid()) @db.Uuid
  applicationId      String   @unique @map("application_id") @db.Uuid
  managementScore    Int      @default(3) @map("management_score")
  relationshipScore  Int      @default(3) @map("relationship_score")
  industryScore      Int      @default(3) @map("industry_score")
  collateralScore    Int      @default(3) @map("collateral_score")
  assessedById       String   @map("assessed_by_id") @db.Uuid
  assessedAt         DateTime @default(now()) @map("assessed_at") @db.Timestamp(6)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  application  CreditApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  assessedBy   User              @relation(fields: [assessedById], references: [id])

  @@map("qualitative_assessments")
}

// ============================================================================
// Retail Income — Wave 2 (individual borrower DSR assessment)
// ============================================================================
model RetailIncome {
  id                      String         @id @default(uuid()) @db.Uuid
  applicationId           String         @unique @map("application_id") @db.Uuid
  employmentType          EmploymentType @map("employment_type")
  employerName            String?        @map("employer_name") @db.VarChar(255)
  monthlyGrossIncome      Decimal        @map("monthly_gross_income") @db.Decimal(15, 2)
  epfMonthlyAmount        Decimal?       @map("epf_monthly_amount") @db.Decimal(15, 2)
  hirePurchaseCommitment  Decimal        @default(0) @map("hire_purchase_commitment") @db.Decimal(15, 2)
  creditCardCommitment    Decimal        @default(0) @map("credit_card_commitment") @db.Decimal(15, 2)
  existingLoanCommitment  Decimal        @default(0) @map("existing_loan_commitment") @db.Decimal(15, 2)
  otherCommitments        Decimal        @default(0) @map("other_commitments") @db.Decimal(15, 2)
  proposedInstalment      Decimal?       @map("proposed_instalment") @db.Decimal(15, 2)
  dsrPercent              Decimal?       @map("dsr_percent") @db.Decimal(5, 2)
  // P1-3 — Net-income DSR fields
  monthlyNetIncome       Decimal?       @map("monthly_net_income") @db.Decimal(15, 2)   // Computed: gross - EPF - tax - SOCSO
  monthlyTaxDeduction    Decimal?       @default(0) @map("monthly_tax_deduction") @db.Decimal(15, 2)
  monthlySocsoDeduction  Decimal?       @default(0) @map("monthly_socso_deduction") @db.Decimal(15, 2)
  netDsrPercent          Decimal?       @map("net_dsr_percent") @db.Decimal(5, 2)      // Net-DSR = commitments / net income * 100
  dsrBasis               String?        @default("GROSS") @map("dsr_basis") @db.VarChar(10) // "GROSS" or "NET"
  financialsVerified      Boolean        @default(false) @map("financials_verified")
  financialsVerifiedAt    DateTime?      @map("financials_verified_at") @db.Timestamp(6)
  createdAt               DateTime       @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt               DateTime       @updatedAt @map("updated_at") @db.Timestamp(6)

  application CreditApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("retail_incomes")
}

// ============================================================================
// Committee — Sprint 4
// ============================================================================

enum CommitteeMeetingStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum CommitteeMeetingType {
  REGULAR
  ADHOC
}

enum CommitteeMemberRole {
  CHAIR
  MEMBER
  SECRETARY
}

enum CommitteeAttendance {
  PRESENT
  ABSENT
  EXCUSED
}

enum CommitteeVoteChoice {
  APPROVE
  REJECT
  ABSTAIN
}

enum AgendaItemDecisionType {
  APPROVE
  REJECT
  DEFER
}

model CommitteeMeeting {
  id          String                @id @default(uuid()) @db.Uuid
  title       String                @db.VarChar(200)
  scheduledAt DateTime              @map("scheduled_at") @db.Timestamp(6)
  location    String?               @db.VarChar(200)
  status      CommitteeMeetingStatus @default(SCHEDULED)
  quorumMin   Int                   @default(3) @map("quorum_min")
  meetingType CommitteeMeetingType  @default(REGULAR) @map("meeting_type")
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime              @updatedAt @map("updated_at") @db.Timestamp(6)

  members     CommitteeMember[]
  agendaItems CommitteeAgendaItem[]

  @@map("committee_meetings")
}

model CommitteeMember {
  id          String              @id @default(uuid()) @db.Uuid
  meetingId   String              @map("meeting_id") @db.Uuid
  userId      String              @map("user_id") @db.Uuid
  role        CommitteeMemberRole
  attendance  CommitteeAttendance @default(ABSENT)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamp(6)

  meeting     CommitteeMeeting    @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user        User                @relation("CommitteeMemberUser", fields: [userId], references: [id])
  votes       CommitteeVote[]

  @@unique([meetingId, userId])
  @@index([meetingId])
  @@map("committee_members")
}

model CommitteeAgendaItem {
  id             String               @id @default(uuid()) @db.Uuid
  meetingId      String               @map("meeting_id") @db.Uuid
  applicationId  String               @map("application_id") @db.Uuid
  displayOrder   Int                  @map("display_order")
  decisionType   AgendaItemDecisionType @default(APPROVE) @map("decision_type")
  presentedById  String?              @map("presented_by_id") @db.Uuid
  decisionResult AgendaItemDecisionType? @map("decision_result")
  decidedAt      DateTime?            @map("decided_at") @db.Timestamp(6)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamp(6)

  meeting        CommitteeMeeting     @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  application    CreditApplication    @relation(fields: [applicationId], references: [id])
  presentedBy    User?                @relation("AgendaItemPresentedBy", fields: [presentedById], references: [id])
  votes          CommitteeVote[]

  @@index([meetingId])
  @@index([applicationId])
  @@map("committee_agenda_items")
}

model CommitteeVote {
  id           String              @id @default(uuid()) @db.Uuid
  agendaItemId String              @map("agenda_item_id") @db.Uuid
  memberId     String              @map("member_id") @db.Uuid
  vote         CommitteeVoteChoice
  comments     String?             @db.Text
  votedAt      DateTime            @default(now()) @map("voted_at") @db.Timestamp(6)

  agendaItem   CommitteeAgendaItem @relation(fields: [agendaItemId], references: [id], onDelete: Cascade)
  member       CommitteeMember     @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([agendaItemId, memberId])
  @@index([agendaItemId])
  @@map("committee_votes")
}

// ============================================================================
// Sprint 5 — Monitoring Models
// ============================================================================

model FacilityHealth {
  id              String      @id @default(uuid()) @db.Uuid
  applicationId   String      @map("application_id") @db.Uuid
  healthStatus    HealthStatus @default(HEALTHY) @map("health_status")
  lastReviewDate  DateTime?  @map("last_review_date") @db.Date
  nextReviewDate  DateTime?  @map("next_review_date") @db.Date
  reviewFrequency CovenantFrequency @default(QUARTERLY) @map("review_frequency")
  notes           String?    @db.Text
  updatedById     String?     @map("updated_by_id") @db.Uuid
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamp(6)

  application     CreditApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  updatedBy       User?             @relation(fields: [updatedById], references: [id])

  @@unique([applicationId])
  @@index([healthStatus])
  @@index([nextReviewDate])
  @@map("facility_health")
}

model CovenantDefinition {
  id            String            @id @default(uuid()) @db.Uuid
  applicationId String            @map("application_id") @db.Uuid
  description   String            @db.Text
  covenantType  CovenantType      @map("covenant_type")
  metricKey     String?           @map("metric_key") @db.VarChar(100)
  threshold     Decimal?          @db.Decimal(15, 2)
  frequency     CovenantFrequency @default(QUARTERLY)
  isActive      Boolean           @default(true) @map("is_active")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamp(6)

  application   CreditApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  tests         CovenantTest[]
  earlyWarningSignals EarlyWarningSignal[]     @relation("EwsCovenant")

  @@index([applicationId])
  @@index([isActive])
  @@map("covenant_definitions")
}

model CovenantTest {
  id            String   @id @default(uuid()) @db.Uuid
  covenantId    String   @map("covenant_id") @db.Uuid
  testDate      DateTime @map("test_date") @db.Date
  reportedValue Decimal? @map("reported_value") @db.Decimal(15, 2)
  isCompliant   Boolean  @map("is_compliant")
  testedById     String?  @map("tested_by_id") @db.Uuid
