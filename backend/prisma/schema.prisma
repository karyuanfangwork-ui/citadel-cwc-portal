model Guarantee {
  id         String @id @default(uuid()) @db.Uuid
  facilityId String @map("facility_id") @db.Uuid

  guarantorProfileId String  @map("guarantor_profile_id") @db.Uuid
  guaranteeType      String  @map("guarantee_type") @db.VarChar(50)
  amount             Decimal @db.Decimal(15, 2)
  isLimited          Boolean @default(true) @map("is_limited")

  // CA Memo Phase 4 — Section 8 guarantor financial profile
  contingentLiabilities       Decimal? @map("contingent_liabilities") @db.Decimal(15, 2)
  estimatedNetWorth           Decimal? @map("estimated_net_worth") @db.Decimal(15, 2)
