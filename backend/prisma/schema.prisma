  fileSize      Int?    @map("file_size")
  sha256Hash    String? @map("sha256_hash") @db.VarChar(64)
  changeSummary String? @map("change_summary") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  document CreditDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("credit_document_versions")
}

// ============================================================================
// Document Requirement — checklist per application type
// ============================================================================
model DocumentRequirement {
  id            String @id @default(uuid()) @db.Uuid
  applicationId String @map("application_id") @db.Uuid

  documentClass  DocumentClass @map("document_class")
  label          String        @db.VarChar(255)
  isMandatory    Boolean       @default(true) @map("is_mandatory")
  isCollected    Boolean       @default(false) @map("is_collected")
  collectedDocId String?       @map("collected_doc_id") @db.Uuid

  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  application CreditApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("document_requirements")
}

// ============================================================================
// G-12 — Generic credit policy parameters
// ============================================================================
model CreditPolicyParameter {
  id          String  @id @default(uuid()) @db.Uuid
  key         String  @db.VarChar(150)
  value       Json
  category    String  @db.VarChar(80)
  description String? @db.Text

  // Optional scope; null means wildcard for that dimension.
  productType  CreditProductType? @map("product_type")
  lane         ProcessingLane?    @map("lane")
  borrowerType BorrowerType?      @map("borrower_type")

  effectiveFrom DateTime  @default(now()) @map("effective_from") @db.Timestamp(6)
  effectiveTo   DateTime? @map("effective_to") @db.Timestamp(6)
  isActive      Boolean   @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  @@unique([key, productType, lane, borrowerType, effectiveFrom])
  @@index([key, isActive])
  @@index([category, isActive])
  @@index([productType, lane, borrowerType])
  @@map("credit_policy_parameters")
}

model CreditRuleConfig {
  id String @id @default(uuid()) @db.Uuid

  kind RuleConfigKind @map("kind")

  // Scope — null means wildcard / applies to all values of that dimension
  productType  CreditProductType? @map("product_type")
  lane         ProcessingLane?    @map("lane")
  borrowerType BorrowerType?      @map("borrower_type")

  // For REQUIRED_DOCUMENT rows
  documentClass DocumentClass? @map("document_class")
  documentLabel String?        @map("document_label") @db.VarChar(255)

  // For REQUIRED_FIELD rows — dot-path into the application payload
  fieldPath  String? @map("field_path") @db.VarChar(255)
  fieldLabel String? @map("field_label") @db.VarChar(255)

  isMandatory Boolean @default(true) @map("is_mandatory")
  sortOrder   Int     @default(0) @map("sort_order")
  isActive    Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([kind, isActive])
  @@index([productType, lane, borrowerType])
  @@map("credit_rule_configs")
}

// ============================================================================
// Credit Audit Event — append-only audit trail for credit applications
// ============================================================================
model CreditAuditEvent {
  id            String @id @default(uuid()) @db.Uuid
  applicationId String @map("application_id") @db.Uuid

  eventType   String  @map("event_type") @db.VarChar(50)
  actorId     String? @map("actor_id") @db.Uuid
  action      String  @db.VarChar(50)
  oldState    String? @map("old_state") @db.VarChar(30)
  newState    String? @map("new_state") @db.VarChar(30)
  metadata    Json?
  hash        String? @db.VarChar(64) // hash-chain for tamper evidence
  hashVersion Int     @default(1) @map("hash_version")

  /// LOS-013 — Monotonic per-application position in the hash chain.
  /// createdAt is millisecond-precision and ties within a single transaction,
  /// which made both the predecessor lookup and chain verification ambiguous
  /// and forked the chain. Ordering is defined by this column, never by time.
  sequence Int @default(0)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  application CreditApplication @relation(fields: [applicationId], references: [id], onDelete: Restrict)

  @@unique([applicationId, sequence])
  @@index([applicationId])
  @@index([eventType])
  @@index([createdAt])
  @@index([applicationId, eventType, createdAt])
  @@index([applicationId, createdAt]) // P0-6: common query pattern — events per app ordered by time
  @@map("credit_audit_events")
}

// ============================================================================
// §2.2 — Credit SLA Policies & Breach Tracking
// ============================================================================

model CreditSlaPolicy {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @db.VarChar(100)
  description String? @db.Text

  // Which application state this SLA targets
  targetState String @map("target_state") @db.VarChar(30)

  // Business hours from application entering targetState until SLA breach
  slaHours Int @map("sla_hours")

  // Escalation: notify these role codes on breach (e.g. ["CREDIT_MANAGER", "CREDIT_ADMIN"])
  notifyRoles String[] @map("notify_roles")

  // Auto-escalation: after additional business hours, advance state automatically
  // Null means no auto-escalation
  escalateAfterHours Int?    @map("escalate_after_hours")
  escalateToState    String? @map("escalate_to_state") @db.VarChar(30)

  // Product-specific override: null means applies to all product types
  productType String? @map("product_type") @db.VarChar(30)

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  breaches        CreditSlaBreach[]
  branchOverrides CreditSlaPolicyBranchOverride[]

  @@index([targetState])
  @@index([isActive])
  @@map("credit_sla_policies")
}

model CreditSlaBreach {
  id             String    @id @default(uuid()) @db.Uuid
  applicationId  String    @map("application_id") @db.Uuid
  policyId       String    @map("policy_id") @db.Uuid
  breachedAt     DateTime  @map("breached_at") @db.Timestamp(6)
  acknowledgedAt DateTime? @map("acknowledged_at") @db.Timestamp(6)
  resolvedAt     DateTime? @map("resolved_at") @db.Timestamp(6)

  // Escalation tracking
  escalationNotifiedAt DateTime? @map("escalation_notified_at") @db.Timestamp(6)
  escalatedAt          DateTime? @map("escalated_at") @db.Timestamp(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  application CreditApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  policy      CreditSlaPolicy   @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@unique([applicationId, policyId])
  @@index([applicationId])
  @@index([policyId])
  @@index([breachedAt])
  @@map("credit_sla_breaches")
}

// ============================================================================
// Collateral
// ============================================================================
model Collateral {
  id         String @id @default(uuid()) @db.Uuid
  facilityId String @map("facility_id") @db.Uuid

  collateralType String  @map("collateral_type") @db.VarChar(50)
  description    String? @db.Text
  titleReference String? @map("title_reference") @db.VarChar(255)
  registeredTo   String? @map("registered_to") @db.VarChar(255)

  marketValue     Decimal?  @map("market_value") @db.Decimal(15, 2)
  forcedSaleValue Decimal?  @map("forced_sale_value") @db.Decimal(15, 2)
  valuationDate   DateTime? @map("valuation_date") @db.Date
  valuer          String?   @db.VarChar(255)

  insuranceCoverRequired Boolean @default(false) @map("insurance_cover_required")

  // CA Memo Phase 4 — Section 8 dual valuation + classification
  securityCategory      SecurityCategory? @map("security_category")
  securitySubType       String?           @map("security_sub_type") @db.VarChar(100)
  isExisting            Boolean           @default(true) @map("is_existing")
  isNewToBeObtained     Boolean           @default(false) @map("is_new_to_be_obtained")
  pmmdMarketValue       Decimal?          @map("pmmd_market_value") @db.Decimal(15, 2)
  pmmdForcedSaleValue   Decimal?          @map("pmmd_forced_sale_value") @db.Decimal(15, 2)
  panelValuerName       String?           @map("panel_valuer_name") @db.VarChar(255)
  securityCoverageRatio Decimal?          @map("security_coverage_ratio") @db.Decimal(8, 4)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  // P1-4 — Soft delete (replaces hard-delete for audit trail)
  softDeletedAt    DateTime? @map("soft_deleted_at") @db.Timestamp(6)
  softDeletedById  String?   @map("soft_deleted_by_id") @db.Uuid
  softDeleteReason String?   @map("soft_delete_reason") @db.VarChar(500)
  softDeletedBy    User?     @relation("CollateralSoftDeletedBy", fields: [softDeletedById], references: [id])

  facility         ApplicationFacility         @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  valuations       CollateralValuation[]
  liens            CollateralLien[]
  insuranceCovers  InsuranceCover[]
  applicationLinks CollateralApplicationLink[]

  @@index([facilityId])
  @@map("collaterals")
}

// P1-4 — Collateral Haircut Configuration
model CollateralHaircutConfig {
  id                    String   @id @default(uuid()) @db.Uuid
  securityCategory      String   @map("security_category") @db.VarChar(50)
  haircutPercent        Decimal  @map("haircut_percent") @db.Decimal(5, 4) // e.g. 0.3000 = 30%
  minValuationAgeMonths Int      @default(12) @map("min_valuation_age_months")
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  @@unique([securityCategory, isActive])
  @@map("collateral_haircut_configs")
}

// §7.1 — Collateral Cross-Application Linking
model CollateralApplicationLink {
  id            String   @id @default(uuid()) @db.Uuid
  collateralId  String   @map("collateral_id") @db.Uuid
  applicationId String   @map("application_id") @db.Uuid
  linkedAt      DateTime @default(now()) @map("linked_at") @db.Timestamp(6)
  linkedById    String   @map("linked_by_id") @db.Uuid

  collateral  Collateral        @relation(fields: [collateralId], references: [id], onDelete: Cascade)
  application CreditApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  linkedBy    User              @relation("CollateralLinkedBy", fields: [linkedById], references: [id])

  @@unique([collateralId, applicationId])
  @@index([collateralId])
  @@index([applicationId])
  @@map("collateral_application_links")
}

model CollateralValuation {
  id           String @id @default(uuid()) @db.Uuid
  collateralId String @map("collateral_id") @db.Uuid

  marketValue     Decimal  @map("market_value") @db.Decimal(15, 2)
  forcedSaleValue Decimal  @map("forced_sale_value") @db.Decimal(15, 2)
  valuationDate   DateTime @map("valuation_date") @db.Date
  valuer          String   @db.VarChar(255)
  reportReference String?  @map("report_reference") @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  collateral Collateral @relation(fields: [collateralId], references: [id], onDelete: Cascade)

  @@index([collateralId])
  @@map("collateral_valuations")
}

model CollateralLien {
  id           String @id @default(uuid()) @db.Uuid
  collateralId String @map("collateral_id") @db.Uuid

  lienHolder    String    @map("lien_holder") @db.VarChar(255)
  lienAmount    Decimal?  @map("lien_amount") @db.Decimal(15, 2)
