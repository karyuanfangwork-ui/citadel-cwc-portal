// ============================================================================
// Sprint 4 — Webhook / Event Subscription System
// ============================================================================

model WebhookSubscription {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String? @map("tenant_id") @db.Uuid

  name   String  @db.VarChar(255)
  url    String  @db.VarChar(1000)
  secret String? @db.VarChar(255) // HMAC signing secret

  // Comma-separated list of event types to subscribe to
  // e.g. "credit_application_submitted,credit_application_approved"
  events String[] @default([])

  isActive Boolean @default(true) @map("is_active")

  // Retry config
  maxRetries    Int @default(3) @map("max_retries")
  retryDelaySec Int @default(60) @map("retry_delay_sec")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  deliveries WebhookDelivery[]

  @@index([tenantId])
  @@index([isActive])
  @@map("webhook_subscriptions")
}

model WebhookDelivery {
  id             String @id @default(uuid()) @db.Uuid
  subscriptionId String @map("subscription_id") @db.Uuid

  eventType String @map("event_type") @db.VarChar(100)
  payload   Json

  // Delivery status
  status       String  @default("PENDING") @db.VarChar(20) // PENDING, DELIVERED, FAILED, RETRY
  attemptCount Int     @default(0) @map("attempt_count")
  responseCode Int?    @map("response_code")
  responseBody String? @map("response_body") @db.Text
  error        String? @db.Text

  deliveredAt DateTime? @map("delivered_at") @db.Timestamp(6)
  nextRetryAt DateTime? @map("next_retry_at") @db.Timestamp(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  subscription WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([status])
  @@index([createdAt])
  @@map("webhook_deliveries")
}

// ============================================================================
// Application Details Enhancement — structuring fields on ApplicationFacility
// ============================================================================

enum RepaymentType {
  EMI // Equal Monthly Installment
  BULLET // Bullet repayment (principal at maturity)
  INTEREST_ONLY // Interest-only during tenor, principal at maturity
  LUMP_SUM // Single lump sum at maturity
  CUSTOM // Custom schedule (see justification)
}

enum RepaymentFrequency {
  MONTHLY
  QUARTERLY
  SEMI_ANNUAL
  ANNUAL
  LUMP_SUM
}

// P2-11: Atomic reference number counter for requests.
// Prevents duplicate reference numbers under concurrent creates.
model RequestCounter {
  id       Int     @id @default(autoincrement())
  prefix   String  @db.VarChar(10) // P2-09: removed @unique, added @@unique([tenantId, prefix])
  lastSeq  Int     @default(0)
  tenantId String? @map("tenant_id") @db.Uuid // P2-06: tenant-scoped counter isolation

  @@unique([tenantId, prefix]) // P2-09: tenant-local unique
  @@index([tenantId])
  @@map("request_counters")
}

// P5-01: Catalog lifecycle status for RequestType governance.
enum CatalogLifecycleStatus {
  DRAFT
  PUBLISHED
  DEPRECATED
  RETIRED
}

// P03 Task 13: Per-type classification for request types.
// INTERNAL    = visible to desk members, no special access controls
// CONFIDENTIAL = restricted to authorised roles (HR, Finance default)
// RESTRICTED   = need-to-know, strict access audit
enum RequestClassification {
  INTERNAL
  CONFIDENTIAL
  RESTRICTED
}

enum DuplicateExceptionStatus {
  PENDING
  APPROVED
  REJECTED
  CONSUMED
  EXPIRED
}

model BorrowerDuplicateException {
  id                  String                   @id @default(uuid()) @db.Uuid
  draftId             String                   @map("draft_id") @db.Uuid
  requestedById       String                   @map("requested_by_id") @db.Uuid
  decidedById         String?                  @map("decided_by_id") @db.Uuid
  matchedBorrowerId   String                   @map("matched_borrower_id") @db.Uuid
  segment             BorrowerSegment
  identityFingerprint String                   @map("identity_fingerprint") @db.VarChar(64)
  category            String                   @db.VarChar(80)
  justification       String                   @db.Text
  supportingReference String?                  @map("supporting_reference") @db.VarChar(255)
  status              DuplicateExceptionStatus @default(PENDING)
  decisionComment     String?                  @map("decision_comment") @db.Text
  expiresAt           DateTime?                @map("expires_at") @db.Timestamp(6)
  decidedAt           DateTime?                @map("decided_at") @db.Timestamp(6)
  consumedAt          DateTime?                @map("consumed_at") @db.Timestamp(6)
  createdAt           DateTime                 @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt           DateTime                 @updatedAt @map("updated_at") @db.Timestamp(6)

  requestedBy     User            @relation("DuplicateExceptionRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  decidedBy       User?           @relation("DuplicateExceptionDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  matchedBorrower BorrowerProfile @relation(fields: [matchedBorrowerId], references: [id], onDelete: Restrict)

  @@index([requestedById])
  @@index([decidedById])
  @@index([matchedBorrowerId])
  @@index([status])
  @@index([expiresAt])
  @@index([identityFingerprint])
  @@map("borrower_duplicate_exceptions")
}
