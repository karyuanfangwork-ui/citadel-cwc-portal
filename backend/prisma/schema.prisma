// P1-6 — Policy deviation / exception register
// Tracks policy breaches (LTV cap, DSR threshold, guarantor capacity, etc.) that require
// explicit approval before the application can proceed. Non-waivable rules cannot be deviated.
model DeviationApproval {
  id                     String            @id @default(uuid()) @db.Uuid
  applicationId          String            @map("application_id") @db.Uuid
  policyRule             String            @map("policy_rule") @db.VarChar(100) // e.g., "LTV_CAP", "NET_DSR", "GUARANTOR_CAPACITY"
  description            String // What policy is being deviated from
  actualValue            Decimal?          @map("actual_value") @db.Decimal(15, 2) // e.g., LTV = 85%
  thresholdValue         Decimal?          @map("threshold_value") @db.Decimal(15, 2) // e.g., 70% cap
  severity               DeviationSeverity @default(MEDIUM)
  justification          String // Why the deviation is requested
  status                 DeviationStatus   @default(PENDING)
  isNonWaivable          Boolean           @default(false) @map("is_non_waivable") // Some regulatory limits cannot be waived
  requiredAuthorityLevel String?           @map("required_authority_level") @db.VarChar(50) // Authority level needed to approve

  approvedById     String?   @map("approved_by_id") @db.Uuid
  approvedAt       DateTime? @map("approved_at") @db.Timestamp(6)
  approvalComments String?   @map("approval_comments")
  rejectedById     String?   @map("rejected_by_id") @db.Uuid
  rejectedAt       DateTime? @map("rejected_at") @db.Timestamp(6)
  rejectionReason  String?   @map("rejection_reason")
  createdById      String?   @map("created_by_id") @db.Uuid

  reviewDate DateTime? @map("review_date") @db.Timestamp(6) // When deviation should be reviewed
  sunsetDate DateTime? @map("sunset_date") @db.Timestamp(6) // When deviation expires
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  application CreditApplication @relation(fields: [applicationId], references: [id])
  createdBy   User?             @relation("DeviationCreatedBy", fields: [createdById], references: [id])
  approvedBy  User?             @relation("DeviationApprovedBy", fields: [approvedById], references: [id])
  rejectedBy  User?             @relation("DeviationRejectedBy", fields: [rejectedById], references: [id])

  @@index([applicationId, status])
  @@index([status, reviewDate])
  @@index([policyRule])
  @@index([createdById])
  @@map("deviation_approvals")
}

// P1-2 — PDPA Consent Record
model ConsentRecord {
  id                 String         @id @default(uuid()) @db.Uuid
  subjectId          String         @map("subject_id") @db.Uuid // BorrowerProfile or CrmContact ID
  subjectType        String         @map("subject_type") @db.VarChar(20) // "BORROWER" | "CONTACT"
  purpose            ConsentPurpose
  status             ConsentStatus  @default(ACTIVE)
  consentText        String?        @map("consent_text") @db.Text // Versioned consent text shown to user
  consentTextVersion String?        @map("consent_text_version") @db.VarChar(20)
  evidence           String?        @db.VarChar(50) // How consent was captured: "WEB_FORM", "VERBAL", "DOCUMENT"
  channel            String?        @db.VarChar(50) // Where consent was given: "PORTAL", "BRANCH", "PHONE"
  grantedAt          DateTime       @default(now()) @map("granted_at") @db.Timestamp(6)
  grantedById        String?        @map("granted_by_id") @db.Uuid
  withdrawnAt        DateTime?      @map("withdrawn_at") @db.Timestamp(6)
  withdrawnById      String?        @map("withdrawn_by_id") @db.Uuid
  withdrawalReason   String?        @map("withdrawal_reason") @db.Text
  expiresAt          DateTime?      @map("expires_at") @db.Timestamp(6) // Optional expiry
  applicationId      String?        @map("application_id") @db.Uuid // Link to application if purpose-specific
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamp(6)

  grantedBy   User? @relation("ConsentGrantedBy", fields: [grantedById], references: [id])
  withdrawnBy User? @relation("ConsentWithdrawnBy", fields: [withdrawnById], references: [id])

  @@unique([subjectId, subjectType, purpose, status]) // One active consent per purpose per subject
  @@index([subjectId, purpose, status])
  @@index([applicationId])
  @@map("consent_records")
}

