# Environment variables for the application

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/help_center?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT — generate secrets with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="REPLACE_WITH_64_CHAR_HEX_SECRET"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="REPLACE_WITH_DIFFERENT_64_CHAR_HEX_SECRET"
JWT_REFRESH_EXPIRES_IN="30d"

# Cookies
COOKIE_SAME_SITE="strict"
# COOKIE_DOMAIN=".yourdomain.com"   # Uncomment for subdomain sharing

# Server
NODE_ENV="development"
PORT=3000
API_PREFIX="/api/v1"

# CORS
CORS_ORIGIN="http://localhost:5173"

# File Upload
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES="image/jpeg,image/png,image/gif,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document"

# AWS S3 (or MinIO for local development)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your-access-key"
AWS_SECRET_ACCESS_KEY="your-secret-key"
S3_BUCKET_NAME="help-center-attachments"
S3_ENDPOINT="" # Leave empty for AWS, set for MinIO: http://localhost:9000

# P1-15: Static file serving — disabled in production (files served via S3 presigned URLs).
# Set to true only for dev/legacy migration where local /uploads directory is used.
SERVE_LOCAL_UPLOADS=false

# Email (Resend)
RESEND_API_KEY="re_your_api_key_here"
EMAIL_FROM="Help Center <help@yourdomain.com>"
EMAIL_REPLY_TO="help@yourdomain.com"

# Elasticsearch
ELASTICSEARCH_NODE="http://localhost:9200"
ELASTICSEARCH_USERNAME=""
ELASTICSEARCH_PASSWORD=""

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
# P1-05: Enable Redis-backed rate limiting for multi-instance deployments.
# When false (default), in-memory store is used (single-instance only).
RATE_LIMIT_REDIS_ENABLED=false

# Logging
LOG_LEVEL="debug"
LOG_FORMAT="json"
# P1-09: Enable Prisma query/info logging (dev/debug only — never in production).
# Defaults to false; query logs contain full SQL and can leak data in logs.
PRISMA_LOG_QUERIES=false

# P3-03: Prometheus metrics endpoint
# Set to false to disable the /metrics endpoint.
# In production, restrict access via network policy (only Prometheus namespace).
METRICS_ENABLED=true

# Session
SESSION_SECRET="your-session-secret-change-this"
SESSION_MAX_AGE=86400000

# Application
APP_NAME="Enterprise Help Center"
APP_URL="http://localhost:5173"
ADMIN_EMAIL="admin@helpdesk.com"

# Security
PASSWORD_MIN_LENGTH=8
CHECK_PASSWORD_BREACH=false
# P0-5: Service-to-service API key — for AV scanner callbacks and other internal services
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SERVICE_API_KEY=
# Legacy internal scan token (ClamAV scan-document endpoint)
INTERNAL_SCAN_TOKEN=

# SLA Checker Schedule
# Mode: 'cron' runs on a schedule, 'interval' runs every N milliseconds
SLA_SCHEDULE_MODE=cron
# Cron expression (default: Mon-Fri 9am). Format: minute hour day month weekday
SLA_CRON_EXPRESSION="0 9 * * 1-5"
# Interval mode: milliseconds between checks (only used when SLA_SCHEDULE_MODE=interval)
SLA_CHECK_INTERVAL_MS=60000

# P3-05: Scheduler distributed lock
# When true, only one instance runs each scheduled job (requires Redis).
# If Redis is unavailable in singleton mode, jobs are skipped to prevent duplicates.
# When false (default), jobs run on all instances if Redis is down.
SCHEDULER_SINGLETON_MODE=false
